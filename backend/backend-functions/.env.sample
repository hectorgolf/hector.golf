# Copy this file to .env and replace the placeholder values.
#
# .env is gitignored and must stay that way: some of the values below are live
# credentials. A key committed to a public repository has to be rotated, not
# deleted.
#
# CI deploys these functions now. deploy-functions.yml ships them on every push
# to main touching backend/backend-functions/**, federating to
# functions-deployer@ through the same Workload Identity pool as every other
# workflow here. `npm run deploy:all` from this directory still works and does
# the same thing; it is no longer the only thing that does.
#
# What changed for this file: the deploy scripts no longer pass the three keys
# with --set-env-vars. They pass --set-secrets, which names Secret Manager
# containers rather than values, so a deploy no longer needs the keys at all.
# Rotating one is `gcloud secrets versions add`, not an edit here followed by a
# redeploy.

# --- Required by every deploy script: `gcloud functions deploy --project=` ---
# `hector-golf`, which is where the four functions run as of 2026-09-14. It is
# also what the deploy scripts build --service-account from, so a value that is
# not hector-golf deploys to a project with no hector-functions identity in it.
#
# The four copies in gen-lang-client-0537211409 are still up until phase 7 of
# docs/plans/functions-migration.md deletes them, so pointing this back there
# still works and still ships to the copies on their way out.
GCLOUD_PROJECT_ID=hector-golf

# --- No longer needed to deploy, still needed to run things locally ---
# The deployed functions read these from Secret Manager, mounted by
# --set-secrets, so neither is required to run `npm run deploy:*` any more.
# They are here for the CLIs in src/cli/ and for the tests, which call Gemini
# and the deployed functions directly.
GOOGLE_GEMINI_API_KEY=your_gemini_api_key
# The bearer token callers present to the three Gemini functions. The site's own
# .env has to carry the same value — see astrosite/.env.sample.
ASTROSITE_API_KEY=your_backend_function_bearer_token

# --- Not required by any deploy; the function reads it from Secret Manager ---
# app.hector.golf answers 401 without it. The function holds it server-side so
# that the public site never ships it.
HECTOR_APP_API_KEY=your_app_hector_golf_api_key

PUBLIC_LEADERBOARD_PROXY_URL=https://europe-north1-<project>.cloudfunctions.net/TournamentLeaderboard

# --- Only for RequestLeaderboardUpdate ---
# The relay that lets app.hector.golf ask for a leaderboard refresh. Unlike every
# other value here, the bottom two are not secrets and the deploy *does* pass
# them, with --set-env-vars: a hostname, and an OAuth client id that appears in
# IAP's own sign-in URL. Neither belongs in Secret Manager.
#
# The key is a secret and is not needed to deploy — the function reads it from
# `leaderboard-trigger-key`. It is here for running the relay locally, where it
# is whatever you want it to be: a local run never reaches the admin, because
# minting the ID token needs the GCP metadata server.
#
# It is deliberately NOT the same value as HECTOR_APP_API_KEY above. That is
# their key for us to call them; this is ours for them to call us.
LEADERBOARD_TRIGGER_KEY=your_leaderboard_trigger_key
ADMIN_DOMAIN=admin.hector.golf
IAP_CLIENT_ID=<the IAP OAuth client id>

# --- Only for the GeneratePlayerAvatar CLI, not for any deploy ---
# src/cli/generate-player-avatar.ts calls a *deployed* function and needs its
# URL. Either set this outright, or leave it unset and let the CLI build the
# URL from FUNCTION_REGION and GCLOUD_PROJECT_ID above.
# GENERATE_PLAYER_AVATAR_URL=https://europe-north1-<project>.cloudfunctions.net/GeneratePlayerAvatar
FUNCTION_REGION=europe-north1
