---
import type { MatchplayEvent } from '@hector/schemas/src/events.ts'
import type { Player } from '@hector/schemas/src/players.ts'
import { fullName } from '../lib/players.ts'
import { read as readHandicapSnapshot } from '../lib/handicaps/snapshot.ts'

interface Props {
	event: MatchplayEvent
	players: Player[]
	names: Map<string, string>
}

const { event, players, names } = Astro.props

/*
 * Where the handicaps in this table come from, and why there are two places.
 *
 * `player.handicap` is the stopgap: on the site it resolves as
 * `override ?? fromHistory`, and the override is a figure somebody typed for a
 * player WiseGolf has never heard of. `update-handicaps.yml` also writes it
 * today, which is why this table has been able to read it alone — and step 4 of
 * `docs/plans/handicaps-to-firestore.md` retires that workflow, at which point
 * the field stops being refreshed and only genuine overrides remain in it.
 *
 * So the order below is the site's order, and survives that change without
 * another edit: the hand-set value wins where there is one, and everyone else
 * gets what the observation log last saw. Reading the snapshot rather than the
 * log is the whole point — one document instead of 1,408, on a page that is
 * loaded far more often than a handicap moves.
 *
 * Read here rather than in the page, because this component only renders while
 * a tournament is in signup. A started tournament pays nothing for it.
 *
 * Missing is normal until the job that writes it is wired up, and this falls
 * back to exactly what it showed before rather than failing the page.
 */
const observed = await readHandicapSnapshot()
const handicapOf = (id: string): number | undefined =>
	players.find((p) => p.id === id)?.handicap ?? observed?.players[id]?.handicap

const inField = event.participants
const available = players
	.filter((p) => !inField.includes(p.id))
	.sort((a, b) => fullName(a).localeCompare(fullName(b)))
---

<section class="stack">
	<div class="row-between">
		<h2>Field</h2>
		<span class="meta">{inField.length} {inField.length === 1 ? 'player' : 'players'}</span>
	</div>

	{inField.length === 0 && <p class="notice">Nobody has been added yet.</p>}

	{
		inField.length > 0 && (
			<div class="tablewrap">
				<table class="datagrid">
					<thead>
						<tr>
							<th>Player</th>
							<th>Handicap</th>
							<th />
						</tr>
					</thead>
					<tbody>
						{inField.map((pid) => (
							<tr>
								<td>{names.get(pid) ?? pid}</td>
								<td class="num">{handicapOf(pid) ?? '—'}</td>
								<td class="right">
									<form method="POST">
										<input type="hidden" name="action" value="remove-player" />
										<input type="hidden" name="playerId" value={pid} />
										<button type="submit" class="secondary">Remove</button>
									</form>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		)
	}

	{
		available.length > 0 && (
			<form method="POST" class="add">
				<input type="hidden" name="action" value="add-player" />
				<div class="field">
					<label for="playerId">Add a player</label>
					<select id="playerId" name="playerId">
						{available.map((p) => (
							<option value={p.id}>
								{fullName(p)}
								{handicapOf(p.id) !== undefined ? ` (${handicapOf(p.id)})` : ''}
							</option>
						))}
					</select>
				</div>
				<button type="submit">Add</button>
			</form>
		)
	}
</section>

<style>
	h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.2rem;
	}

	.right {
		text-align: right;
	}

	.right form {
		display: inline;
	}

	.add {
		display: flex;
		gap: 0.75rem;
		align-items: flex-end;
		flex-wrap: wrap;
	}

	.add .field {
		flex: 1;
		min-width: 16rem;
	}
</style>
