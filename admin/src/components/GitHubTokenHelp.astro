---
import { EXPIRY_URGENT_DAYS, EXPIRY_WARN_DAYS, repository } from '../lib/github.ts'
import { githubTokenSecretLocation } from '../lib/secrets.ts'

/*
 * What to do when the GitHub token is missing or refused.
 *
 * This is on the page rather than only in docs/playbooks/gcp-bootstrapping.md because of
 * who is standing in front of it and when. The page says the nightly updates are
 * not running; the next question is always "so what do I do", and the answer
 * involves a GitHub screen and a gcloud command that nobody memorises. A link to
 * a playbook is one more thing to go and find at the moment somebody has already
 * found the right page.
 *
 * It prints the real project and secret id rather than placeholders — see
 * `githubTokenSecretLocation` for why that is safe to render.
 */

interface Props {
	/**
	 * `missing`: no token at all. `rejected`: there is one and GitHub refused it.
	 * `expiring`: it still works, and GitHub has said for how long.
	 *
	 * The three share this component rather than having one each because the
	 * remedy is identical in all three — create a token, store it, reload — and
	 * the only thing that differs is the sentence explaining why you are reading
	 * it. Splitting them would mean three copies of the steps, which is three
	 * places to update the day the permissions change again.
	 */
	mode: 'missing' | 'rejected' | 'expiring'
	/** Whole days until expiry, for `expiring`. Negative once it has lapsed. */
	daysLeft?: number
}

const { mode, daysLeft } = Astro.props
const location = githubTokenSecretLocation()

/*
 * Whether this is news or a problem.
 *
 * A month's warning is information — the token still works and everything still
 * runs — so it gets the neutral treatment and sits below the things that are
 * actually broken. Inside the last week it joins them.
 */
const urgent = mode !== 'expiring' || (daysLeft ?? 0) <= EXPIRY_URGENT_DAYS

/** "expires in 12 days", "expires tomorrow", "expired 3 days ago" — as a heading has to read. */
const when = (days: number): string => {
	if (days < -1) return `expired ${Math.abs(days)} days ago`
	if (days < 0) return 'expired yesterday'
	if (days === 0) return 'expires today'
	if (days === 1) return 'expires tomorrow'
	return `expires in ${days} days`
}

// The URL that opens GitHub's fine-grained token form directly. Not the generic
// settings page: the form is four clicks deep and easy to land on the wrong one
// of, since classic tokens live next door and would also appear to work.
const NEW_TOKEN_URL = 'https://github.com/settings/personal-access-tokens/new'

const command = location
	? `gcloud secrets versions add ${location.secretId} --project=${location.project} --data-file=-`
	: 'gcloud secrets versions add github-dispatch-token --project=<project> --data-file=-'
---

<section class:list={['notice', urgent && 'bad', 'token-help']}>
	<h2>
		{
			mode === 'missing'
				? 'No GitHub token is configured'
				: mode === 'rejected'
					? 'GitHub refused the token'
					: `The GitHub token ${when(daysLeft ?? 0)}`
		}
	</h2>

	<p>
		{
			mode === 'missing' ? (
				<>
					This service starts the update workflows by asking GitHub to run them, and it has no
					token to ask with. Until it has one, the buttons below do nothing and the twice-daily
					Cloud Scheduler runs fail.
				</>
			) : mode === 'rejected' ? (
				<>
					There is a token, and GitHub would not accept it. Fine-grained tokens expire, and the
					one here is <strong>not</strong> revoked or renewed automatically. Replacing it is the
					same three steps as creating the first one.
				</>
			) : (
				<>
					Everything below still works, and on this date it stops: the scheduled updates fail, the
					run history on this page goes blank, and the handicaps job can no longer commit its
					backup. Nothing renews the token automatically — it is replaced by hand, and the three
					steps are the same ones that created it.
				</>
			)
		}
	</p>

	<p class="what-it-is">
		The token <em>is</em> the secret. It is a GitHub fine-grained personal access token, stored as a
		version of the Secret Manager secret{' '}
		{location ? <code>{location.secretId}</code> : <span>this service points at</span>}. Terraform
		creates that secret but deliberately never its value, so that the token is not written into
		Terraform state — which means creating it is a manual step, by design, and this is it.
	</p>

	<ol class="steps">
		<li>
			<p>
				<strong>Create the token</strong> at{' '}
				<a href={NEW_TOKEN_URL} rel="noreferrer" target="_blank">
					github.com/settings/personal-access-tokens/new
				</a>
				. It must be a <em>fine-grained</em> token, not a classic one.
			</p>
			<table class="datagrid token-fields">
				<tbody>
					<tr>
						<td>Resource owner</td>
						<td><code>{repository.split('/')[0]}</code></td>
					</tr>
					<tr>
						<td>Repository access</td>
						<td>
							Only select repositories → <code>{repository}</code>
						</td>
					</tr>
					<tr>
						<td>Repository permissions</td>
						<td>
							<strong>Actions: Read and write</strong> and{' '}
							<strong>Contents: Read and write</strong>, and nothing else
						</td>
					</tr>
					<tr>
						<td>Expiration</td>
						<td>
							Your call — it cannot be "never". This page warns for the last {EXPIRY_WARN_DAYS} days.
						</td>
					</tr>
				</tbody>
			</table>
			<p class="why">
				Actions is what starts a workflow and lists the recent runs this page shows. Contents is
				what the jobs this service runs <em>itself</em> commit their backups with — the workflows
				still do their own committing, with their own <code>GITHUB_TOKEN</code>, but a job in this
				process has no such thing and uses this token.
			</p>
			<p class="why">
				Contents is worth granting deliberately rather than by habit: it is the permission that
				lets this service write to the repository, and a token without it fails in the least
				visible way available. The repository is public, so reads keep working whatever the grant
				says — a job will scrape, reconcile, report "no changes" and look entirely healthy, right
				up to the commit nobody is watching.
			</p>
		</li>

		<li>
			<p>
				<strong>Store it</strong> in Secret Manager, reading from stdin so the token never reaches
				your shell history. Paste it, then press <kbd>Ctrl</kbd>+<kbd>D</kbd>:
			</p>
			<pre><code>{command}</code></pre>
			{
				!location && (
					<p class="why">
						This service has not been told where its secret is —{' '}
						<code>GITHUB_DISPATCH_TOKEN_SECRET</code> is unset, which is normal on a laptop and a
						misconfiguration in Cloud Run. The command above is a template.
					</p>
				)
			}
		</li>

		<li>
			<p>
				<strong>Reload this page.</strong> Nothing needs redeploying: the token is read from Secret
				Manager each time it is used, so a new version takes effect immediately. That is also all a
				rotation is.
			</p>
		</li>
	</ol>

	<p class="why">
		The same steps, with more context, are in <code>docs/playbooks/gcp-bootstrapping.md</code> under "The
		GitHub token for scheduled data updates".
	</p>
</section>

<style>
	.token-help {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	.token-help h2 {
		margin: 0;
		font-size: 1rem;
	}

	.token-help p {
		margin: 0;
	}

	.steps {
		margin: 0;
		padding-left: 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.steps li {
		padding-left: 0.2rem;
	}

	.steps li > p + table,
	.steps li > p + p,
	.steps li > pre + p {
		margin-top: 0.45rem;
	}

	.token-fields {
		width: auto;
	}

	.token-fields td:first-child {
		color: var(--text-dim);
		white-space: nowrap;
	}

	.why {
		color: var(--text-dim);
		font-size: 0.85rem;
	}

	pre {
		margin: 0;
		padding: 0.6rem 0.75rem;
		background: var(--bg);
		border: 1px solid var(--line);
		overflow-x: auto;
		font-size: 0.82rem;
	}

	kbd {
		font-family: var(--font-score, monospace);
		font-size: 0.78rem;
		border: 1px solid var(--line-strong);
		border-radius: 3px;
		padding: 0 0.25rem;
	}
</style>
