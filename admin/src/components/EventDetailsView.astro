---
/**
 * The name, place, dates and description of an event, as values rather than as
 * boxes.
 *
 * The read-only twin of `EventDetailsFields.astro`, and kept in the same order
 * as it on purpose: these are the fields `BaseEventSchema` gives every format,
 * so the day Finnkampen gets an editor this component and that one are showing
 * the same page with and without inputs. Two orders would make that swap a
 * redesign.
 *
 * It shows three things the form does not, because a form is for changing a
 * value and this is for finding out what one is:
 *
 * - **`id`**, which is the document key, the filename and what every
 *   `participants` list elsewhere is matched against. It is the field a person
 *   comparing the admin against a JSON file needs first, and no editor will ever
 *   offer it — an id is assigned once.
 * - **`ignore`**, because it is the difference between an event the public site
 *   renders and one it skips. Both Finnkampen events carry `true`, which is why
 *   they are invisible on hector.golf, and reading that off a page is quicker
 *   than inferring it from the site's absence.
 * - **`hero_image`**, which is a path into the site's assets and either resolves
 *   or does not.
 */
import EventDescription from '@hector/ui/components/EventDescription.astro'

import type { Event } from '@hector/schemas/src/events.ts'
import { formatEventDates } from '@hector/schemas/src/dates.ts'

import { siteVisibility } from '../lib/events/site.ts'
import ReadOnlyField from './ReadOnlyField.astro'

interface Props {
	event: Event
}

const { event } = Astro.props

/*
 * "Shown on the site" answers with a way to go and look, when there is one.
 * `lib/events/site.ts` decides, and the case it exists for is the one this field
 * would otherwise get wrong: `ignore` being clear does not mean a page was
 * built, because Finnkampen has no route on the site to build one into.
 */
const visibility = siteVisibility(event)
// Plain text: a hint renders as it is written, so backticks would show as
// backticks. The other hints on these pages spell field names bare too.
const NOT_SHOWN = {
	ignored: 'The ignore flag is set, so the build skips this event.',
	'no-route': `The site has no /events/${event.format}/ route, so no page is built for this format whatever ignore says.`,
} as const
---

<section class="stack">
	<h2>Details</h2>

	<div class="fields">
		<ReadOnlyField label="Name" value={event.name} />
		<ReadOnlyField label="Location" value={event.location} />
	</div>

	<div class="fields">
		<ReadOnlyField label="First day" value={event.timing.start} />
		<ReadOnlyField label="Last day" value={event.timing.end} />
		<ReadOnlyField
			label="Time zone"
			value={event.timing.timezone}
			hint={
				event.timing.timezone
					? undefined
					: 'Only events that freeze something need one; a Hector without it has no 08:00 to freeze at.'
			}
		/>
	</div>

	<div class="fields">
		<ReadOnlyField label="Id" value={event.id} hint="The document key and the filename." />
		<ReadOnlyField
			label="Shown on the site"
			value={visibility.shown ? 'Yes' : 'No'}
			href={visibility.shown ? visibility.url : undefined}
			hint={visibility.shown ? undefined : NOT_SHOWN[visibility.reason]}
		/>
		<ReadOnlyField label="Hero image" value={event.hero_image} />
	</div>

	<div class="field">
		<span class="label">Description</span>
		{
			event.description?.trim() ? (
				<div class="value">
					<EventDescription text={event.description} />
				</div>
			) : (
				<p class="value empty">—</p>
			)
		}
		<span class="hint">Rendered as Markdown, the same way the public event page renders it.</span>
	</div>

	<p class="dates">{formatEventDates(event)}</p>
</section>

<style>
	h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.2rem;
	}

	/*
	 * The two dates above are the stored strings, because that is what an editor
	 * will put in its two date boxes. This is the same pair as the site prints
	 * them, which is the thing somebody is usually checking.
	 */
	.dates {
		margin: 0;
		font-family: var(--font-num);
		font-size: 0.85rem;
		color: var(--text-dim);
	}
</style>
