---
import type { MatchplayResults } from '@hector/schemas/src/events.ts'
import { displayName } from '../lib/players.ts'

interface Props {
	bracket: MatchplayResults['bracket']
	names: Map<string, string>
	readonly?: boolean
}

const { bracket, names, readonly = false } = Astro.props

/** Last round is the final; the two before it have the names people use. */
function roundName(round: number, total: number): string {
	const fromEnd = total - round
	if (fromEnd === 0) return 'Final'
	if (fromEnd === 1) return 'Semi-finals'
	if (fromEnd === 2) return 'Quarter-finals'
	return `Round ${round}`
}
---

<section class="stack">
	<h2>Bracket</h2>

	{
		bracket.map((round) => (
			<div class="round">
				<h3>{roundName(round.round, bracket.length)}</h3>
				<div class="matches">
					{round.matches.map((match) => {
						const decided = match.winner !== null
						const ready = match.left !== null && match.right !== null
						return (
							<article class:list={['card', 'match', { decided, waiting: !ready }]}>
								<div class="players">
									<span class:list={{ won: match.winner === match.left }}>
										{displayName(names, match.left)}
									</span>
									<span class="v">v</span>
									<span class:list={{ won: match.winner === match.right }}>
										{displayName(names, match.right)}
									</span>
								</div>

								{decided && <p class="result"><span class="score">{match.score}</span></p>}

								{!decided && !ready && (
									<p class="hint">Waiting on {match.leftSource} and {match.rightSource}</p>
								)}

								{!decided && ready && !readonly && (
									<form method="POST" class="record">
										<input type="hidden" name="action" value="record" />
										<input type="hidden" name="matchId" value={match.id} />
										<div class="field">
											<label for={`winner-${match.id}`}>Winner</label>
											<select id={`winner-${match.id}`} name="winner">
												<option value={match.left!}>{displayName(names, match.left)}</option>
												<option value={match.right!}>{displayName(names, match.right)}</option>
											</select>
										</div>
										<div class="field">
											<label for={`score-${match.id}`}>Score</label>
											<input
												id={`score-${match.id}`}
												name="score"
												type="text"
												required
												placeholder="3&amp;1"
											/>
										</div>
										<button type="submit">Record</button>
									</form>
								)}

								<span class="mid">{match.id}</span>
							</article>
						)
					})}
				</div>
			</div>
		))
	}
</section>

<style>
	h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.2rem;
	}

	h3 {
		margin: 0 0 0.6rem;
		font-family: var(--font-score);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 0.75rem;
		color: var(--text-dim);
	}

	.round + .round {
		margin-top: 1.5rem;
	}

	.matches {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
		gap: 0.75rem;
	}

	.match {
		padding: 0.85rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		position: relative;
	}

	.match.waiting {
		opacity: 0.6;
	}

	/* A decided match reads as settled: the winner is the only bright name. */
	.match.decided .players span:not(.won):not(.v) {
		color: var(--text-dim);
	}

	.players {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 0.5rem;
		align-items: baseline;
		font-size: 0.95rem;
	}

	.players span:last-of-type {
		text-align: right;
	}

	.won {
		font-weight: 600;
		color: var(--matchplay);
	}

	.v {
		color: var(--text-faint);
		font-size: 0.8rem;
	}

	.result {
		margin: 0;
		text-align: center;
	}

	.hint {
		margin: 0;
		font-size: 0.78rem;
		color: var(--text-dim);
		font-family: var(--font-num);
	}

	.record {
		display: grid;
		grid-template-columns: 1fr 1fr auto;
		gap: 0.5rem;
		align-items: end;
		border-top: 1px solid var(--line);
		padding-top: 0.6rem;
	}

	.mid {
		position: absolute;
		top: 0.5rem;
		right: 0.65rem;
		font-family: var(--font-num);
		font-size: 0.65rem;
		color: var(--text-faint);
	}
</style>
