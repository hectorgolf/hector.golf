---
import { TONE_PILL, type LogEntry } from "../lib/runlog.ts";
import { ageInWords, formatUtc } from "../lib/runs.ts";

/*
 * The run log's table, rendered the same on both pages that show it.
 *
 * A component rather than markup repeated twice, because the two pages are
 * deliberately the same table: /operations shows the top of the list and
 * /operations/runs shows all of it with the filters, and a reader who has
 * followed the "See all" link should not have to re-learn the columns. Two
 * copies is also how one of them quietly gains a column the other lacks.
 */
interface Props {
	entries: LogEntry[];
	now: Date;
}

const { entries, now } = Astro.props;
---

<div class="tablewrap">
	<table class="datagrid">
		<thead>
			<tr>
				<th>Started (UTC)</th>
				<th>What ran</th>
				<th>Where</th>
				<th>Started by</th>
				<th>Outcome</th>
			</tr>
		</thead>
		<tbody>
			{
				entries.map((entry) => (
					<tr>
						<td class="num">
							<time datetime={entry.startedAt}>{formatUtc(entry.startedAt)}</time>
							<span class="muted age">{ageInWords(entry.startedAt, now)}</span>
						</td>
						<td>{entry.label}</td>
						{/*
						 * The column that makes one table out of two lists, and it
						 * is not decoration: during a migration a dataset appears in
						 * both halves under the *same label* — see the note in
						 * `lib/jobs/registry.ts` — so for handicaps this is the only
						 * cell that tells two rows apart. It carries the run number
						 * too, because a link that says where it goes is worth more
						 * than a column of bare `#1505`s.
						 */}
						<td class="num">
							{entry.url ? (
								<a href={entry.url} rel="noreferrer">
									GitHub #{entry.runNumber}
								</a>
							) : (
								<span class="muted">this service</span>
							)}
						</td>
						<td>{entry.by}</td>
						<td>
							<span class:list={["pill", TONE_PILL[entry.tone]]}>{entry.outcome}</span>{" "}
							{/* Only our own half knows what it found; a workflow run does not say. */}
							{entry.detail && <span class="muted found">{entry.detail}</span>}
						</td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>

<style>
	.muted {
		color: var(--text-dim);
	}

	.age {
		display: block;
		font-size: 0.78rem;
	}

	/*
	 * Under the pill rather than beside it. A change list runs to a sentence and
	 * a pill is two words, so side by side the column is set by the longest run
	 * anyone has ever had and every other row is mostly whitespace.
	 */
	.found {
		display: block;
		margin-top: 0.15rem;
		font-size: 0.85rem;
	}
</style>
