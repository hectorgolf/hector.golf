---
import '@hector/ui/styles/hector.css'
import '../styles/admin.css'
import HectorMark from '@hector/ui/components/HectorMark.astro'

import { SECTIONS, sectionForPath } from '../lib/sections.ts'
import { SIGN_OUT_URL, viewerFromHeaders } from '../lib/identity.ts'

interface Props {
	title: string
}

const { title } = Astro.props
const current = sectionForPath(Astro.url.pathname)
const viewer = viewerFromHeaders(Astro.request.headers)
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} · Hector Admin</title>
		<!-- Nothing here is public, so keep it out of indexes regardless of IAP. -->
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body>
		<header class="topbar">
			<a href="/" class="brand"><HectorMark /><span>Admin</span></a>
			<nav aria-label="Sections">
				{
					SECTIONS.map((section) =>
						section.available ? (
							<a
								href={`/${section.slug}`}
								aria-current={current?.slug === section.slug ? 'page' : undefined}
							>
								{section.label}
							</a>
						) : (
							<span class="soon" title="Not built yet">{section.label}</span>
						)
					)
				}
			</nav>
			{
				viewer.authenticated ? (
					/*
					 * A <details> rather than a scripted menu: the admin ships no client
					 * JavaScript at all, and one button behind a disclosure does not need
					 * to be the thing that changes that.
					 */
					<details class="account">
						<summary class="who">{viewer.email}</summary>
						<div class="account-menu">
							<a href={SIGN_OUT_URL} class="signout">Sign out</a>
							<p class="account-note">
								Ends this session. Signing in again is where a different account can be
								chosen — you stay signed in to Google itself.
							</p>
						</div>
					</details>
				) : (
					<span class="who">not signed in</span>
				)
			}
		</header>

		<main>
			<slot />
		</main>
	</body>
</html>
