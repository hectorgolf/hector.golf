---
import '@hector/ui/styles/hector.css'
import '../styles/admin.css'
import HectorMark from '@hector/ui/components/HectorMark.astro'

import { SECTIONS, sectionForPath } from '../lib/sections.ts'
import { viewerFromHeaders } from '../lib/identity.ts'

interface Props {
	title: string
}

const { title } = Astro.props
const current = sectionForPath(Astro.url.pathname)
const viewer = viewerFromHeaders(Astro.request.headers)
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} · Hector Admin</title>
		<!-- Nothing here is public, so keep it out of indexes regardless of IAP. -->
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body>
		<header class="topbar">
			<a href="/" class="brand"><HectorMark /><span>Admin</span></a>
			<nav aria-label="Sections">
				{
					SECTIONS.map((section) =>
						section.available ? (
							<a
								href={`/${section.slug}`}
								aria-current={current?.slug === section.slug ? 'page' : undefined}
							>
								{section.label}
							</a>
						) : (
							<span class="soon" title="Not built yet">{section.label}</span>
						)
					)
				}
			</nav>
			<span class="who">{viewer.email ?? 'not signed in'}</span>
		</header>

		<main>
			<slot />
		</main>
	</body>
</html>
