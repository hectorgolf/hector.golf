---
// The site's own design system, from the shared package. The admin UI looks like
// hector.golf because it is the same stylesheet, not a copy of it.
import '@hector/ui/styles/hector.css'
import HectorMark from '@hector/ui/components/HectorMark.astro'

interface Props {
	title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} · Hector Admin</title>
		<!-- Nothing here is public, so keep it out of indexes regardless of IAP. -->
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body>
		<header class="bar">
			<a href="/" class="brand"><HectorMark /><span>Admin</span></a>
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>

<style>
	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font-family: var(--font-sans);
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.9rem 1.25rem;
		border-bottom: 1px solid var(--line);
		background: var(--surface);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--text);
		text-decoration: none;
		font-weight: 600;
	}

	main {
		max-width: var(--page-max, 960px);
		margin: 0 auto;
		padding: 2.5rem 1.25rem 4rem;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}
</style>
