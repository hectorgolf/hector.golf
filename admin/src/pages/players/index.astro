---
import AdminLayout from '../../layouts/AdminLayout.astro'
import PageHeader from '@hector/ui/components/PageHeader.astro'

import type { Player } from '@hector/schemas/src/players.ts'
import { listPlayers } from '../../lib/repository/events.ts'
import { read as readHandicapSnapshot } from '../../lib/handicaps/snapshot.ts'
import { formatHandicap, fullName, resolveHandicap } from '../../lib/players.ts'

/*
 * Forty-six players and one snapshot document, in two reads plus the roster.
 *
 * The snapshot is why this page is cheap: it is the whole point of
 * `handicaps/snapshot.ts` — every player's latest handicap in one document
 * instead of a scan of the 1,400-entry observation log, on the page that asks
 * that question most.
 *
 * Missing is a normal answer. Nothing has written one on a laptop whose emulator
 * was seeded a minute ago, and the column falls back to the stored stopgap
 * rather than the page failing.
 */
let players: Player[] = []
let observed: Awaited<ReturnType<typeof readHandicapSnapshot>>
let error: string | undefined

try {
	;[players, observed] = await Promise.all([listPlayers(), readHandicapSnapshot()])
} catch {
	// The reason goes to Cloud Logging; the page says only that it failed.
	error = 'Could not read the players. Check the service logs.'
}

const rows = players.map((player) => ({
	player,
	handicap: resolveHandicap(player, observed?.players[player.id]),
}))

/*
 * Counts under the lede, because they are the three questions this collection
 * gets asked and none of them is answerable by looking at forty-six rows.
 * `biographyLocked` is the one worth surfacing: the fortnightly regeneration
 * takes back every biography that is not locked, so "how many are protected" is
 * a number with a deadline on it.
 */
const withBiography = players.filter((p) => (p.biography?.length ?? 0) > 0).length
const locked = players.filter((p) => p.biographyLocked).length
const stopgaps = rows.filter((row) => row.handicap?.source === 'stopgap').length
---

<AdminLayout title="Players">
	<PageHeader title="Players" lede="Everybody who has played a Hector event." />

	{error && <p class="notice bad">{error}</p>}

	{!error && players.length === 0 && (
		<p class="notice">
			No players in the store. <code>npm run seed</code> imports them from the committed files.
		</p>
	)}

	{
		players.length > 0 && (
			<>
				<p class="counts">
					{players.length} players · {withBiography} with a biography, {locked} of them locked
					{stopgaps > 0 && ` · ${stopgaps} on a hand-set handicap`}
					{!observed && ' · no handicap snapshot in this store yet'}
				</p>

				<div class="tablewrap">
					<table class="datagrid">
						<thead>
							<tr>
								<th>Player</th>
								<th>Club</th>
								<th>Handicap</th>
								<th>Biography</th>
								<th>Hints</th>
							</tr>
						</thead>
						<tbody>
							{rows.map(({ player, handicap }) => (
								<tr>
									<td><a href={`/players/${player.id}`}>{fullName(player)}</a></td>
									<td>{player.club ?? '—'}</td>
									<td class="num">
										{formatHandicap(handicap)}
										{handicap?.source === 'stopgap' && (
											<span
												class="pill pill-outline"
												title="Hand-set, for a player WiseGolf has never heard of. Not an override."
											>
												stopgap
											</span>
										)}
									</td>
									<td>
										{player.biography?.length
											? `${player.biography.length} paragraphs`
											: '—'}
										{player.biographyLocked && (
											<span class="pill pill-violet" title="update-player-biographies skips this one">
												locked
											</span>
										)}
									</td>
									<td class="num">{player.misc?.length ?? 0}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</>
		)
	}
</AdminLayout>

<style>
	.counts {
		margin: 0;
		font-family: var(--font-num);
		font-size: 0.85rem;
		color: var(--text-dim);
	}

	td .pill {
		margin-left: 0.5rem;
	}
</style>
