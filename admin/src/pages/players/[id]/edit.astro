---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import PageHeader from '@hector/ui/components/PageHeader.astro'
import Breadcrumb from '@hector/ui/components/Breadcrumb.astro'

import { schema as playerSchema } from '@hector/schemas/src/players.ts'

import { viewerFromHeaders } from '../../../lib/identity.ts'
import { PLAYERS_ARE_OWNED } from '../../../lib/ownership.ts'
import { getPlayer, savePlayer } from '../../../lib/repository/events.ts'
import { read as readHandicapSnapshot } from '../../../lib/handicaps/snapshot.ts'
import { formatHandicap, fullName, resolveHandicap } from '../../../lib/players.ts'
import { clubAbbreviations } from '../../../lib/players/clubs.ts'
import { biographyWasEdited, detailsFromForm, formOf, type PlayerForm } from '../../../lib/players/details.ts'

/*
 * Editing the four fields a person writes on a player.
 *
 * Built the way `events/matchplay/[id]/edit.astro` is — one page that posts to
 * itself, reads the form, validates through the schema and redirects on
 * success — rather than through an API route, because there is no second caller
 * and a redirect is what leaves the browser somewhere sensible without script.
 *
 * ## It cannot save yet, and that is one flag rather than two
 *
 * `savePlayer` refuses while `PLAYERS_ARE_OWNED` is false, because a player
 * written to Firestore today is reverted by the next seed. This page checks the
 * same flag and says so instead of offering boxes that would throw — but it
 * checks it to decide *what to render*, not as a second gate: the refusal still
 * lives in `savePlayer`, so a form replayed against a deployment mid-flip is
 * refused by the writer rather than by a disabled attribute in somebody's stale
 * HTML.
 *
 * The day the flag flips, this page starts working and nothing else about it
 * changes.
 */

const { id } = Astro.params
if (!id) return Astro.redirect('/players')

const player = await getPlayer(id)
if (!player) return new Response('Player not found', { status: 404 })

let error: string | undefined

// The stored player, replaced by whatever was typed if the save failed, so a
// rejected edit does not have to be retyped.
let submitted: PlayerForm = formOf(player)

if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    const viewer = viewerFromHeaders(Astro.request.headers)
    const releasing = String(form.get('action') ?? '') === 'release'

    /*
     * Two forms post here, and the release reads *none* of the boxes.
     *
     * It could carry them as hidden fields, the way the matchplay delete carries
     * its confirmation — and that would be wrong here in a way that is quiet:
     * the hidden values are whatever the server last rendered, so somebody who
     * typed into the biography and then pressed Unlock would have their typing
     * replaced by the stored text and be told the save succeeded. Clearing a
     * lock is not an edit, so it does not pretend to be one.
     */
    if (releasing) {
        try {
            await savePlayer({ ...player, biographyLocked: undefined }, viewer.email ?? 'unknown')
            return Astro.redirect(`/players/${player.id}?saved=released`)
        } catch (failure) {
            error = failure instanceof Error ? failure.message : String(failure)
        }
    } else {
        submitted = {
            club: String(form.get('club') ?? ''),
            handicap: String(form.get('handicap') ?? ''),
            misc: String(form.get('misc') ?? ''),
            biography: String(form.get('biography') ?? ''),
        }

        const details = detailsFromForm(submitted)

        /*
         * The whole player rather than the four fields, because the schema
         * validates a player and the rest of the record — name, contact,
         * aliases — has to survive the round trip intact.
         *
         * The lock follows the text: set when the biography was edited, kept
         * when it already was. See `biographyWasEdited` for why it is not a
         * checkbox.
         */
        const locked = player.biographyLocked || biographyWasEdited(player, details) || undefined
        const parsed = playerSchema.safeParse({ ...player, ...details, biographyLocked: locked })

        if (!parsed.success) {
            error = parsed.error.issues
                .map((issue) => `${issue.path.join('.') || 'form'}: ${issue.message}`)
                .join('; ')
        } else {
            try {
                await savePlayer(parsed.data, viewer.email ?? 'unknown')
                return Astro.redirect(`/players/${player.id}?saved=details`)
            } catch (failure) {
                // `NotOwnedError` is the expected one before the flip, and its
                // own message says which collection. Anything else is worth
                // showing too: this is the only place a person finds out the
                // save did not happen.
                error = failure instanceof Error ? failure.message : String(failure)
            }
        }
    }
}

const [observed, clubs] = await Promise.all([readHandicapSnapshot(), clubAbbreviations()])
const handicap = resolveHandicap(player, observed?.players[player.id])
const official = handicap?.source === 'observed' ? handicap : undefined
---

<AdminLayout title={`Edit ${fullName(player)}`}>
    <Breadcrumb title={fullName(player)} href={`/players/${player.id}`} />

    <PageHeader
        title="Edit player"
        eyebrow="Player"
        lede="The four fields a person writes. Name, phone, gender, privacy and aliases are authored too and stay read-only for now; images are files on disk rather than content this service holds."
    />

    {error && <p class="notice bad">{error}</p>}

    {
        !PLAYERS_ARE_OWNED && (
            <p class="notice">
                <strong>Players are still mirrored, so nothing here can be saved yet.</strong> This
                service reads the player collection and two scheduled workflows write the committed
                files, so a player written here would be reverted by the next <code>npm run seed</code>.
                The boxes below are filled in and disabled. They start working when{' '}
                <code>PLAYERS_ARE_OWNED</code> does, without another change to this page.
            </p>
        )
    }

    <form method="POST" class="stack">
        <div class="field">
            <label for="club">Club</label>
            <input
                id="club"
                name="club"
                type="text"
                list="club-abbreviations"
                value={submitted.club}
                disabled={!PLAYERS_ARE_OWNED}
                autocomplete="off"
                spellcheck="false"
            />
            <datalist id="club-abbreviations">
                {clubs.map((club) => <option value={club.abbreviation}>{club.name}</option>)}
            </datalist>
            <span class="hint">
                {clubs.length > 0
                    ? `Authored. The club scrape fills it only when it is empty. ${clubs.length} abbreviations suggested from the committed list; one that is not on it can still be typed.`
                    : 'Authored. The club scrape fills it only when it is empty. The suggestion list could not be read, which costs the suggestions and nothing else.'}
            </span>
        </div>

        <div class="field">
            <label for="handicap">Handicap</label>
            <input
                id="handicap"
                name="handicap"
                type="text"
                inputmode="decimal"
                value={submitted.handicap}
                disabled={!PLAYERS_ARE_OWNED}
                autocomplete="off"
            />
            <span class="hint stopgap">
                <strong>A stopgap, not an override.</strong>{' '}
                {official
                    ? `WiseGolf reports ${formatHandicap(official)}${official.observed ? `, read ${official.observed}` : ''}, and that is the number the site shows. Anything typed here is ignored while WiseGolf has a figure, and is not your edit being lost.`
                    : 'WiseGolf has no figure for this player, so this one is what the site shows — until WiseGolf has one, which replaces it. For a new member the association has not met.'}
            </span>
        </div>

        <div class="field">
            <label for="misc">Prompt hints</label>
            <textarea id="misc" name="misc" rows="4" disabled={!PLAYERS_ARE_OWNED}>{submitted.misc}</textarea>
            <span class="hint">
                One per line. The biography generator reads these and writes nothing back to them.
            </span>
        </div>

        <div class="field">
            <label for="biography">Biography</label>
            <textarea id="biography" name="biography" rows="12" disabled={!PLAYERS_ARE_OWNED}
                >{submitted.biography}</textarea
            >
            <span class="hint">
                Blank line between paragraphs. {' '}
                {player.biographyLocked
                    ? 'Locked, so the generator leaves it alone. It still shows the model this text, so a regenerated biography elsewhere does not echo a sentence published here.'
                    : 'Not locked, so the generator rewrites it on its next run — twice a month. Saving a change here locks it, because the edit is the act of taking the field over.'}
            </span>
        </div>

        <div class="actions">
            <button type="submit" disabled={!PLAYERS_ARE_OWNED}>Save changes</button>
            <a href={`/players/${player.id}`}><button type="button" class="secondary">Cancel</button></a>
        </div>
    </form>

    {
        player.biographyLocked && (
            <section class="stack release">
                <h2>Give the biography back to the generator</h2>
                <p class="hint">
                    Clears the lock and nothing else, so the next run rewrites this biography from
                    scratch and the stored text is replaced. Anything typed above is not saved by
                    this button. The lock is otherwise one-way: an explicit{' '}
                    <strong>Regenerate</strong> for a single player is a separate piece of work — see{' '}
                    <code>docs/plans/biography-locking.md</code> — and until it exists this is the
                    release.
                </p>
                <form method="POST" class="stack">
                    <input type="hidden" name="action" value="release" />
                    <div class="actions">
                        <button type="submit" class="secondary" disabled={!PLAYERS_ARE_OWNED}>
                            Unlock the biography
                        </button>
                    </div>
                </form>
            </section>
        )
    }
</AdminLayout>

<style>
    form {
        max-width: 42rem;
    }

    .release {
        max-width: 42rem;
        margin-top: 2.5rem;
        border-top: 1px solid var(--line);
        padding-top: 1.5rem;
    }

    h2 {
        margin: 0;
        font-family: var(--font-serif);
        font-size: 1.2rem;
    }

    .hint {
        font-size: 0.8rem;
        color: var(--text-dim);
    }

    .stopgap strong {
        color: var(--text-muted);
    }

    textarea {
        font: inherit;
        line-height: 1.5;
        resize: vertical;
    }

    input:disabled,
    textarea:disabled,
    button:disabled {
        color: var(--text-dim);
        background: var(--surface);
        cursor: not-allowed;
    }

    code {
        font-size: 0.95em;
    }
</style>
