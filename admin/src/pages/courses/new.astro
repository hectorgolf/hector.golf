---
import AdminLayout from '../../layouts/AdminLayout.astro'
import PageHeader from '@hector/ui/components/PageHeader.astro'
import Breadcrumb from '@hector/ui/components/Breadcrumb.astro'

import { schema as courseSchema } from '@hector/schemas/src/courses.ts'

import { viewerFromHeaders } from '../../lib/identity.ts'
import { COURSES_ARE_OWNED } from '../../lib/ownership.ts'
import { getCourse, saveCourse } from '../../lib/repository/events.ts'
import {
	BLANK_NEW_COURSE,
	DEFAULT_PAR,
	MAX_HOLES,
	newCourseFrom,
	problemsWith,
	type NewCourseForm,
} from '../../lib/courses/creation.ts'

/*
 * Making a course, which until now was something only an import could do.
 *
 * Deliberately five boxes and a hole count rather than the whole editor. What
 * this page is for is getting a record to exist so that `/courses/{id}/edit`
 * has something to open — the prose, the tees, the pictures and the numbers all
 * belong over there, and asking for them twice would be asking for them in the
 * worse of the two places.
 *
 * ## The id is the one thing that cannot be changed afterwards
 *
 * It is the document key, the filename the export writes, and the course's
 * address on the public site. The editor does not offer it for that reason, so
 * this is the only chance to choose it — which is why it is the first box and
 * why a taken one is refused rather than silently written over. `saveCourse`
 * uses `set`.
 */

let form: NewCourseForm = { ...BLANK_NEW_COURSE }
let problems: string[] = []
let error: string | undefined

if (Astro.request.method === 'POST') {
    const body = await Astro.request.formData()
    const viewer = viewerFromHeaders(Astro.request.headers)

    form = {
        id: String(body.get('id') ?? ''),
        name: String(body.get('name') ?? ''),
        homepage: String(body.get('homepage') ?? ''),
        address: String(body.get('address') ?? ''),
        descriptionShort: String(body.get('descriptionShort') ?? ''),
        holes: String(body.get('holes') ?? ''),
    }

    // Asked before anything is built, because "is this id free" is the question
    // whose wrong answer overwrites a course.
    const taken = form.id.trim() === '' ? false : (await getCourse(form.id.trim())) !== undefined
    problems = problemsWith(form, taken)

    if (problems.length === 0) {
        const parsed = courseSchema.safeParse(newCourseFrom(form))
        if (!parsed.success) {
            problems = parsed.error.issues.map((issue) => `${issue.path.join('.') || 'form'}: ${issue.message}`)
        } else {
            try {
                await saveCourse(parsed.data, viewer.email ?? 'unknown')
                return Astro.redirect(`/courses/${parsed.data.id}/edit?created=1`)
            } catch (failure) {
                error = failure instanceof Error ? failure.message : String(failure)
            }
        }
    }
}
---

<AdminLayout title="New course">
	<Breadcrumb title="Courses" href="/courses" />

	<PageHeader
		title="New course"
		eyebrow="Course"
		lede="Enough to open the editor on. The prose, the pictures, the tees and the numbers are all filled in there."
	/>

	{error && <p class="notice bad">{error}</p>}

	{
		problems.length > 0 && (
			<div class="notice bad">
				<p><strong>Nothing was created.</strong></p>
				<ul>
					{problems.map((problem) => (
						<li>{problem}</li>
					))}
				</ul>
			</div>
		)
	}

	{
		!COURSES_ARE_OWNED && (
			<p class="notice">
				<strong>Courses are still mirrored, so nothing can be created here yet.</strong> The seed
				rewrites every course from <code>astrosite/src/data/courses/</code> on every run, so a
				course made here would be reverted within hours.
			</p>
		)
	}

	<form method="POST" class="stack">
		<section class="stack">
			<div class="field">
				<label for="id">Id</label>
				<input id="id" name="id" type="text" value={form.id} disabled={!COURSES_ARE_OWNED} required />
				<span class="hint">
					Lowercase letters, digits and hyphens — <code>konopiste-radecky</code>. This is the
					filename and the address on hector.golf, and <strong>it cannot be changed later</strong>,
					so it is worth a moment. The existing ones name the club and then the course rather
					than repeating the full name.
				</span>
			</div>

			<div class="field">
				<label for="name">Name</label>
				<input id="name" name="name" type="text" value={form.name} disabled={!COURSES_ARE_OWNED} required />
			</div>

			<div class="field">
				<label for="homepage">Homepage</label>
				<input id="homepage" name="homepage" type="url" value={form.homepage} disabled={!COURSES_ARE_OWNED} required />
			</div>

			<div class="field">
				<label for="address">Address</label>
				<input id="address" name="address" type="text" value={form.address} disabled={!COURSES_ARE_OWNED} required />
			</div>

			<div class="field">
				<label for="descriptionShort">Short description</label>
				<textarea id="descriptionShort" name="descriptionShort" rows="3" disabled={!COURSES_ARE_OWNED} required>{form.descriptionShort}</textarea>
			</div>

			<div class="field">
				<label for="holes">Holes</label>
				<input
					id="holes"
					name="holes"
					type="number"
					min="1"
					max={MAX_HOLES}
					value={form.holes}
					disabled={!COURSES_ARE_OWNED}
					required
					class="num"
				/>
				<span class="hint">
					A scorecard is scaffolded with this many holes, every one a par {DEFAULT_PAR} — the
					commonest, so about half of them are already right — with the stroke indexes
					running{' '}<code>1…n</code> so they are obviously placeholders. You type the real
					card in the editor. Nine, fourteen and eighteen all occur here.
				</span>
			</div>
		</section>

		<div class="actions">
			<button type="submit" disabled={!COURSES_ARE_OWNED}>Create and open the editor</button>
			<a href="/courses"><button type="button" class="secondary">Cancel</button></a>
		</div>
	</form>
</AdminLayout>

<style>
	.field {
		max-width: 38rem;
	}

	.notice ul {
		margin: 0.4rem 0 0;
		padding-left: 1.1rem;
	}

	.num {
		max-width: 6rem;
	}

	.actions {
		display: flex;
		gap: 0.6rem;
	}
</style>
