---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import PageHeader from '@hector/ui/components/PageHeader.astro'
import Breadcrumb from '@hector/ui/components/Breadcrumb.astro'

import { schema as courseSchema, uploadedImagePath } from '@hector/schemas/src/courses.ts'

import { viewerFromHeaders } from '../../../lib/identity.ts'
import { COURSES_ARE_OWNED } from '../../../lib/ownership.ts'
import { getCourse, saveCourse } from '../../../lib/repository/events.ts'
import {
	BLANK_TEE,
	courseFromForm,
	formOf,
	isBlank,
	rowIndices,
	withBlankRows,
	type CourseForm,
	type DescriptionRow,
	type TeeForm,
} from '../../../lib/courses/details.ts'
import { ACCEPTED_TYPES, assetBucket, storeUpload } from '../../../lib/courses/uploads.ts'

/*
 * Editing the part of a course a person writes.
 *
 * Same shape as the player editor: one page that posts to itself, validates
 * through the schema, redirects on success. `saveCourse` refuses while
 * `COURSES_ARE_OWNED` is false, and this page reads the same flag to decide what
 * to render rather than offering controls that would throw — one gate, checked
 * twice for different purposes.
 *
 * ## What it does not edit, and why that is safe
 *
 * The scorecard, the hole descriptions, the images and the datasources are all
 * absent from this form and all survive a save, because `courseFromForm` starts
 * from the stored course and overwrites only what the form carried. That is the
 * property to preserve if a field is ever added here: Zod strips what it is not
 * told about, so an editor that rebuilt the record from its own fields would
 * delete the rest without failing.
 */

const { id } = Astro.params
if (!id) return Astro.redirect('/courses')

const course = await getCourse(id)
if (!course) return new Response('Course not found', { status: 404 })

let error: string | undefined
let uploadError: string | undefined
let submitted: CourseForm = formOf(course)

const teeRow = (form: FormData, index: number): TeeForm => ({
    id: String(form.get(`tee-${index}-id`) ?? '') || undefined,
    name: String(form.get(`tee-${index}-name`) ?? ''),
    nameLocal: String(form.get(`tee-${index}-nameLocal`) ?? ''),
    color: String(form.get(`tee-${index}-color`) ?? ''),
    length: String(form.get(`tee-${index}-length`) ?? ''),
    par: String(form.get(`tee-${index}-par`) ?? ''),
    parLadies: String(form.get(`tee-${index}-parLadies`) ?? ''),
    ratingMen: String(form.get(`tee-${index}-ratingMen`) ?? ''),
    ratingLadies: String(form.get(`tee-${index}-ratingLadies`) ?? ''),
    slopeMen: String(form.get(`tee-${index}-slopeMen`) ?? ''),
    slopeLadies: String(form.get(`tee-${index}-slopeLadies`) ?? ''),
})

if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    const viewer = viewerFromHeaders(Astro.request.headers)

    /*
     * A row whose paragraph is empty and whose image is neither chosen nor
     * inherited is dropped by `descriptionFrom`, which is what makes the blank
     * rows at the end ignorable when nobody touches them.
     */
    const rows: DescriptionRow[] = []
    for (const index of rowIndices(form)) {
        const upload = form.get(`item-${index}-file`)
        const file = upload instanceof File && upload.size > 0 ? upload : undefined

        let object = String(form.get(`item-${index}-object`) ?? '') || undefined
        if (file) {
            try {
                object = await storeUpload(course.id, file)
            } catch (failure) {
                uploadError = failure instanceof Error ? failure.message : String(failure)
            }
        }

        rows.push({
            // Carried by the row rather than looked up in what was rendered:
            // a row added in the browser is a clone of a blank one, and the
            // kind is the only thing about it the server cannot infer.
            kind: form.get(`item-${index}-kind`) === 'image' ? 'image' : 'paragraph',
            content: String(form.get(`item-${index}-content`) ?? ''),
            url: String(form.get(`item-${index}-url`) ?? '') || undefined,
            object,
            position: String(form.get(`item-${index}-position`) ?? String(index + 1)),
            remove: form.get(`item-${index}-remove`) !== null,
        })
    }

    submitted = {
        name: String(form.get('name') ?? ''),
        homepage: String(form.get('homepage') ?? ''),
        address: String(form.get('address') ?? ''),
        phone: String(form.get('phone') ?? ''),
        email: String(form.get('email') ?? ''),
        descriptionShort: String(form.get('descriptionShort') ?? ''),
        description: rows,
        tees: submitted.tees.map((_, index) => teeRow(form, index)),
    }

    const parsed = courseSchema.safeParse(courseFromForm(course, submitted))

    if (uploadError) {
        // An upload that failed must not take the rest of the save with it
        // silently: the row it belonged to has no object, so saving now would
        // drop the image and report success.
        error = uploadError
    } else if (!parsed.success) {
        error = parsed.error.issues.map((issue) => `${issue.path.join('.') || 'form'}: ${issue.message}`).join('; ')
    } else {
        try {
            await saveCourse(parsed.data, viewer.email ?? 'unknown')
            return Astro.redirect(`/courses/${course.id}?saved=details`)
        } catch (failure) {
            error = failure instanceof Error ? failure.message : String(failure)
        }
    }

    // A rejected save keeps what was typed, plus fresh blank rows so a tee or a
    // description item can still be added on the retry. `withBlankRows` drops
    // the blank rows it finds before adding its pair, so this does not
    // accumulate however the rows came back ordered.
    if (submitted.tees.at(-1)?.name.trim() !== '') submitted = { ...submitted, tees: [...submitted.tees, { ...BLANK_TEE }] }
    submitted = { ...submitted, description: withBlankRows(submitted.description) }
}

const rows = submitted.description

/**
 * Where a committed image can be looked at. The admin serves its own assets and
 * none of the site's, so a preview of an already-published image has to come
 * from the site itself.
 */
const PUBLIC_SITE = 'https://hector.golf'
---

<AdminLayout title={`Edit ${course.name}`}>
	<Breadcrumb title={course.name} href={`/courses/${course.id}`} />

	<PageHeader
		title="Edit course"
		eyebrow="Course"
		lede="Identity, contact, the prose and the tees. The scorecard, the hole descriptions, the images and the datasources are not edited here and are carried through a save untouched."
	/>

	{error && <p class="notice bad">{error}</p>}

	{
		!COURSES_ARE_OWNED && (
			<p class="notice">
				<strong>Courses are still mirrored, so nothing here can be saved yet.</strong> The seed
				rewrites every course from <code>astrosite/src/data/courses/</code> on every run, so a
				course written here would be reverted within hours. The boxes below are filled in and
				disabled. They start working when <code>COURSES_ARE_OWNED</code> does, without another
				change to this page.
			</p>
		)
	}

	{/*
	 * `multipart/form-data` because a description item can carry an image. A
	 * urlencoded form sends a file input's *name* and nothing else, so the file
	 * would silently never arrive — the save would succeed and the picture would
	 * not be there.
	 */}
	<form method="POST" enctype="multipart/form-data" class="stack">
		<section class="stack">
			<h2>Identity</h2>
			<div class="field">
				<label for="name">Name</label>
				<input id="name" name="name" type="text" value={submitted.name} disabled={!COURSES_ARE_OWNED} required />
			</div>
			<div class="field">
				<label for="homepage">Homepage</label>
				<input id="homepage" name="homepage" type="url" value={submitted.homepage} disabled={!COURSES_ARE_OWNED} />
			</div>
			<div class="field">
				<label for="address">Address</label>
				<input id="address" name="address" type="text" value={submitted.address} disabled={!COURSES_ARE_OWNED} />
			</div>
			<div class="pair">
				<div class="field">
					<label for="phone">Phone</label>
					<input id="phone" name="phone" type="text" value={submitted.phone} disabled={!COURSES_ARE_OWNED} />
				</div>
				<div class="field">
					<label for="email">Email</label>
					<input id="email" name="email" type="text" value={submitted.email} disabled={!COURSES_ARE_OWNED} />
				</div>
			</div>
		</section>

		<section class="stack">
			<h2>Description</h2>
			<div class="field">
				<label for="descriptionShort">Short</label>
				<textarea id="descriptionShort" name="descriptionShort" rows="3" disabled={!COURSES_ARE_OWNED}>{submitted.descriptionShort}</textarea>
			</div>

			<p class="hint" data-reorder-hint>
				<span class="when-plain">
					Paragraphs and images, in the order the <strong>position</strong> column asks for. Type
					a number to move a row; ties keep the order they are in, so renumbering two rows
					leaves the rest alone. Tick <strong>remove</strong> to drop one.
					<br />
					<strong>To add one:</strong> use an empty row at the end — type the paragraph, or
					choose an image — and give it the position you want it at. A fraction puts it between
					two others, so <code>2.5</code> lands after the second item, and <code>0</code> puts
					it first. Leave the position alone and it goes last.
				</span>
				<span class="when-enhanced">
					Paragraphs and images, in the order shown. Use <strong>↑</strong> and{' '}
					<strong>↓</strong> to move one, and tick <strong>remove</strong> to drop it.
					<br />
					<strong>To add one:</strong> press <strong>+ Add paragraph</strong> or{' '}
					<strong>+ Add image</strong> below, as many times as you like, then move it where
					you want it. Nothing is saved until you press Save.
				</span>
				{!assetBucket && (
					<>
						{' '}
						<strong>Uploading is unavailable here:</strong> this service has no asset bucket
						configured, which is normal on a laptop. Existing images still show and can be
						reordered or removed.
					</>
				)}
			</p>

			<div class="items" data-reorder>
				{
					rows.map((row, index) => (
						<div class:list={['item', row.kind, { blank: isBlank(row) }]} data-row>
							{/*
							 * The row says what it is. The server reads this rather than
							 * matching the index against what it rendered, which is what
							 * lets a row added in the browser be a plain clone.
							 */}
							<input type="hidden" name={`item-${index}-kind`} value={row.kind} />
							<div class="controls">
								{/*
								 * Rendered here rather than created by the script, so Astro's
								 * scoped styles reach them — a button built in JS carries no
								 * `data-astro-cid-*` and would come out unstyled. They are
								 * hidden until `lib/description-list.ts` marks the section, so
								 * with the script off nobody is offered a control that
								 * does nothing.
								 */}
								<button type="button" class="move" data-move="up" aria-label="Move this item up">↑</button>
								<button type="button" class="move" data-move="down" aria-label="Move this item down">↓</button>
								<label class="position">
									<span class="when-plain">Position</span>
									<input
										name={`item-${index}-position`}
										type="text"
										inputmode="decimal"
										value={row.position}
										disabled={!COURSES_ARE_OWNED}
										class="num"
									/>
								</label>
								{/*
								 * Rendered on every row and hidden on the blank ones by
								 * CSS, rather than left out of them: a row added in the
								 * browser is a clone of a blank row, and a checkbox that
								 * was never in the markup cannot be cloned into one.
								 * Removing the class is how the clone gets its own.
								 */}
								<label class="remove">
									<input
										name={`item-${index}-remove`}
										type="checkbox"
										disabled={!COURSES_ARE_OWNED}
									/>
									<span>Remove</span>
								</label>
							</div>

							{row.kind === 'paragraph' ? (
								<textarea
									name={`item-${index}-content`}
									rows="4"
									disabled={!COURSES_ARE_OWNED}
									placeholder={row.content ? undefined : 'Add a paragraph'}
								>{row.content}</textarea>
							) : (
								<div class="image">
									<input type="hidden" name={`item-${index}-url`} value={row.url ?? ''} />
									<input type="hidden" name={`item-${index}-object`} value={row.object ?? ''} />

									{/*
									 * Two sources, because there are two kinds of image. An
									 * uploaded one is in the bucket and nowhere public, so it
									 * comes back through this service; a committed one is
									 * already on the site, and the admin does not serve the
									 * site's files. Using `row.url` directly here renders a
									 * broken square, which is what the first cut did.
									 */}
									{row.object ? (
										<figure>
											<img src={`/api/assets/${row.object}`} alt="" loading="lazy" />
											<figcaption>
												Uploaded, not yet published. Becomes{' '}
												<code>{uploadedImagePath(course.id, row.object)}</code> at the next
												export.
											</figcaption>
										</figure>
									) : row.url ? (
										<figure>
											<img src={`${PUBLIC_SITE}${row.url}`} alt="" loading="lazy" />
											<figcaption>
												Already published · <code>{row.url}</code>
											</figcaption>
										</figure>
									) : (
										<p class="asset empty">No image yet. Choose one below.</p>
									)}

									<label class="file">
										<span>{row.url || row.object ? 'Replace with' : 'Upload an image'}</span>
										<input
											name={`item-${index}-file`}
											type="file"
											accept={ACCEPTED_TYPES}
											disabled={!COURSES_ARE_OWNED || !assetBucket}
										/>
									</label>
								</div>
							)}
						</div>
					))
				}
			</div>

			{/*
			 * The other half of the enhancement: with the script off these are
			 * hidden and the two blank rows above are how an item is added, one
			 * per save. With it on, the blank rows are hidden instead and these
			 * clone them — so either way there is exactly one way in, and the
			 * script never has to build a row out of nothing.
			 */}
			<p class="adders">
				<button type="button" data-add="paragraph" disabled={!COURSES_ARE_OWNED}>
					+ Add paragraph
				</button>
				<button type="button" data-add="image" disabled={!COURSES_ARE_OWNED}>
					+ Add image
				</button>
			</p>
		</section>

		<section class="stack">
			<h2>Tees</h2>
			<p class="hint">
				Renaming a tee moves the scorecard with it — the per-hole lengths are keyed by name, and
				the <code>id</code> beside each row is what lets the two be matched up afterwards. A tee
				cannot be removed here: that would drop its column from the scorecard, and a form where
				clearing a name deletes measurements deletes them by accident. The empty row at the end
				adds one.
			</p>

			<div class="tablewrap">
				<table class="datagrid tees">
					<thead>
						<tr>
							<th>Name</th>
							<th>Local</th>
							<th>Colour</th>
							<th>Length</th>
							<th>Par</th>
							<th>Par ♀</th>
							<th>Rating ♂</th>
							<th>Rating ♀</th>
							<th>Slope ♂</th>
							<th>Slope ♀</th>
						</tr>
					</thead>
					<tbody>
						{submitted.tees.map((tee, index) => (
							<tr>
								<td>
									<input type="hidden" name={`tee-${index}-id`} value={tee.id ?? ''} />
									<input
										name={`tee-${index}-name`}
										type="text"
										value={tee.name}
										disabled={!COURSES_ARE_OWNED}
										placeholder={tee.id ? undefined : 'Add a tee'}
									/>
								</td>
								<td>
									<input
										name={`tee-${index}-nameLocal`}
										type="text"
										value={tee.nameLocal}
										disabled={!COURSES_ARE_OWNED}
									/>
								</td>
								<td>
									<input
										name={`tee-${index}-color`}
										type="text"
										value={tee.color}
										disabled={!COURSES_ARE_OWNED}
										class="colour"
									/>
								</td>
								<td>
									<input name={`tee-${index}-length`} type="text" value={tee.length} disabled={!COURSES_ARE_OWNED} class="num" />
								</td>
								<td>
									<input name={`tee-${index}-par`} type="text" value={tee.par} disabled={!COURSES_ARE_OWNED} class="num" />
								</td>
								<td>
									<input name={`tee-${index}-parLadies`} type="text" value={tee.parLadies} disabled={!COURSES_ARE_OWNED} class="num" />
								</td>
								<td>
									<input name={`tee-${index}-ratingMen`} type="text" value={tee.ratingMen} disabled={!COURSES_ARE_OWNED} class="num" />
								</td>
								<td>
									<input name={`tee-${index}-ratingLadies`} type="text" value={tee.ratingLadies} disabled={!COURSES_ARE_OWNED} class="num" />
								</td>
								<td>
									<input name={`tee-${index}-slopeMen`} type="text" value={tee.slopeMen} disabled={!COURSES_ARE_OWNED} class="num" />
								</td>
								<td>
									<input name={`tee-${index}-slopeLadies`} type="text" value={tee.slopeLadies} disabled={!COURSES_ARE_OWNED} class="num" />
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>

		<div class="actions">
			<button type="submit" disabled={!COURSES_ARE_OWNED}>Save changes</button>
			<a href={`/courses/${course.id}`}><button type="button" class="secondary">Cancel</button></a>
		</div>
	</form>
</AdminLayout>

<style>
	/*
	 * Wider than the player editor's form, because of the tees table: ten columns
	 * of numbers that a reader compares across rows. `.tablewrap` scrolls it when
	 * the window is narrow, and the prose fields above keep a readable measure of
	 * their own.
	 */
	form {
		max-width: 76rem;
	}

	.field,
	.pair {
		max-width: 46rem;
	}

	h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.2rem;
	}

	.hint,
	.placeholder {
		margin: 0;
		font-size: 0.8rem;
		color: var(--text-dim);
	}

	.placeholder {
		padding: 0.4rem 0.6rem;
		border: 1px dashed var(--line);
		border-radius: 4px;
	}

	textarea {
		font: inherit;
		line-height: 1.5;
		resize: vertical;
	}

	.tees input {
		width: 100%;
		min-width: 4rem;
	}

	.tees .num {
		width: 4rem;
		text-align: right;
	}

	.items {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		max-width: 46rem;
	}

	.item {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding-left: 0.8rem;
		border-left: 2px solid var(--line);
	}

	.item.image {
		border-left-color: var(--line-strong);
	}

	.controls {
		display: flex;
		align-items: center;
		gap: 1.2rem;
		font-size: 0.78rem;
		color: var(--text-dim);
	}

	.controls label {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.controls .num {
		width: 3.5rem;
		text-align: right;
	}

	/*
	 * Which of the two explanations applies, and whether the position boxes are
	 * anything a reader should see. `list-enhanced` is added by
	 * `lib/description-list.ts` once it has taken the list over; with the script
	 * off or not yet run, the page is exactly what the server sent.
	 */
	.when-enhanced {
		display: none;
	}

	section.list-enhanced .when-plain {
		display: none;
	}

	section.list-enhanced .when-enhanced {
		display: inline;
	}

	section.list-enhanced .position {
		/*
		 * Hidden rather than removed: it is still the field that carries the
		 * order through the submit, and a disabled or detached input would
		 * submit nothing.
		 */
		display: none;
	}

	.move {
		display: none;
		padding: 0.05rem 0.4rem;
		font-size: 0.85rem;
		line-height: 1.4;
		min-width: 1.7rem;
	}

	section.list-enhanced .move {
		display: inline-block;
	}

	.move:disabled {
		opacity: 0.35;
		cursor: not-allowed;
	}

	.adders {
		/*
		 * Hidden until the script can honour them. A button that adds a row is
		 * a promise of a row appearing without losing what is typed above it,
		 * and the server cannot keep that promise without a round trip — so
		 * with no script the blank rows below are the offer instead.
		 */
		display: none;
		margin: 0;
		gap: 0.6rem;
	}

	section.list-enhanced .adders {
		display: flex;
	}

	section.list-enhanced .item.blank {
		/*
		 * The no-script way in, hidden now that there is a button for it. Still
		 * rendered because it is what a new row is cloned from, and still
		 * submitted — empty, so `descriptionFrom` drops it.
		 */
		display: none;
	}

	.item.blank .remove {
		/* Nothing to remove yet. */
		display: none;
	}

	.item figure {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.item img {
		max-width: 22rem;
		max-height: 12rem;
		width: auto;
		border: 1px solid var(--line);
		border-radius: 4px;
	}

	.item figcaption,
	.item .asset {
		margin: 0;
		font-size: 0.78rem;
		color: var(--text-dim);
	}

	.item .file {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.78rem;
		color: var(--text-dim);
	}

	.tees .colour {
		width: 6rem;
	}

	input:disabled,
	textarea:disabled,
	button:disabled {
		color: var(--text-dim);
		background: var(--surface);
		cursor: not-allowed;
	}
</style>

<script>
	import { enhance } from '../../../lib/description-list.ts'

	enhance(document)
</script>
