---
import AdminLayout from '../../layouts/AdminLayout.astro'
import PageHeader from '@hector/ui/components/PageHeader.astro'
import MirrorNotice from '../../components/MirrorNotice.astro'

import type { Course } from '@hector/schemas/src/courses.ts'

import { COURSE_MIRROR } from '../../lib/mirror.ts'
import { COURSES_ARE_OWNED } from '../../lib/ownership.ts'
import { listCourses } from '../../lib/repository/events.ts'

/*
 * The courses, as of the day they first had somewhere to be listed.
 *
 * One read for seventeen documents. A course carries everything about itself,
 * so unlike the players list there is no snapshot to join against and no second
 * query to make.
 */
let courses: Course[] = []
let error: string | undefined

try {
	courses = await listCourses()
} catch {
	// The reason goes to Cloud Logging; the page says only that it failed.
	error = 'Could not read the courses. Check the service logs.'
}

/*
 * Counts that are not answerable by looking at the rows.
 *
 * `course` is optional on the schema and absent on some of them, which is the
 * difference between a course this admin can say anything useful about and one
 * that is currently a name, an address and a link. Worth a number, because it
 * is the first thing the editor in step 4 will have to cope with.
 */
const withGolf = courses.filter((course) => course.course).length
const tees = courses.reduce((n, course) => n + (course.course?.tees.length ?? 0), 0)
const withHoleNotes = courses.filter((course) => course.course?.descriptions?.length).length
---

<AdminLayout title="Courses">
	<div class="row-between">
		<PageHeader
			title="Courses"
			lede="Every course a Hector round has been played on, and a few that are here for the guides."
		/>
		{COURSES_ARE_OWNED && (
			<a href="/courses/new"><button type="button">New course</button></a>
		)}
	</div>

	<MirrorNotice mirror={COURSE_MIRROR} what="A course" />

	{error && <p class="notice bad">{error}</p>}

	{
		!error && courses.length === 0 && (
			<p class="notice">
				No courses in the store. <code>npm run seed</code> imports them from the committed files.
			</p>
		)
	}

	{
		courses.length > 0 && (
			<>
				<p class="counts">
					{courses.length} courses · {withGolf} with tees and a scorecard · {tees} tees ·{' '}
					{withHoleNotes} with hole-by-hole notes
				</p>

				<div class="tablewrap">
					<table class="datagrid">
						<thead>
							<tr>
								<th>Course</th>
								<th>Where</th>
								<th>Tees</th>
								<th>Par</th>
								<th>Holes described</th>
							</tr>
						</thead>
						<tbody>
							{courses.map((course) => (
								<tr>
									<td>
										<a href={`/courses/${course.id}`}>{course.name}</a>
									</td>
									<td>{course.contact.address}</td>
									<td class="num">{course.course?.tees.length ?? '—'}</td>
									<td class="num">{course.course?.tees[0]?.par ?? '—'}</td>
									<td class="num">{course.course?.descriptions?.length ?? 0}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</>
		)
	}
</AdminLayout>

<style>
	.counts {
		margin: 0;
		font-family: var(--font-num);
		font-size: 0.85rem;
		color: var(--text-dim);
	}

	td:nth-child(2) {
		color: var(--text-muted);
		font-size: 0.9rem;
	}
</style>
