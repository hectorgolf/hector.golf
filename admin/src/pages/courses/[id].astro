---
import AdminLayout from '../../layouts/AdminLayout.astro'
import PageHeader from '@hector/ui/components/PageHeader.astro'
import Breadcrumb from '@hector/ui/components/Breadcrumb.astro'
import MirrorNotice from '../../components/MirrorNotice.astro'
import ReadOnlyField from '../../components/ReadOnlyField.astro'

import { COURSE_MIRROR } from '../../lib/mirror.ts'
import { getCourse } from '../../lib/repository/events.ts'

const { id } = Astro.params
if (!id) return Astro.redirect('/courses')

const course = await getCourse(id)
if (!course) return new Response('Course not found', { status: 404 })

const tees = course.course?.tees ?? []
const scorecard = course.course?.scorecard
const holes = scorecard?.men ?? []

/**
 * `lengths` is `z.any()` on the schema and an object keyed by tee name in the
 * data. Resolved here rather than in the template, where the cast reads as JSX.
 */
const lengthAt = (hole: { lengths?: unknown }, teeName: string): number | undefined =>
	(hole.lengths as Record<string, number> | undefined)?.[teeName]

const paragraphs = course.description_long
	.filter((part): part is { type: 'paragraph'; content?: string } => part.type === 'paragraph')
	.map((part) => part.content)
	.filter((content): content is string => Boolean(content))
---

<AdminLayout title={course.name}>
	<Breadcrumb title="Courses" href="/courses" />

	<div class="row-between">
		<PageHeader
			title={course.name}
			eyebrow="Course"
			meta={[course.contact.address, `${tees.length} tee${tees.length === 1 ? '' : 's'}`]}
		/>
		<span class="pill pill-outline">Read-only</span>
	</div>

	<MirrorNotice mirror={COURSE_MIRROR} what="This course" />

	<section class="stack">
		<h2>Details</h2>

		<div class="fields">
			<ReadOnlyField label="Id" value={course.id} hint="The document key and the filename." />
			<ReadOnlyField label="Homepage" value={course.homepage} />
			<ReadOnlyField label="Phone" value={course.contact.phone ?? '—'} />
		</div>

		<div class="fields">
			<ReadOnlyField label="Address" value={course.contact.address} />
			<ReadOnlyField label="Email" value={course.contact.email ?? '—'} />
			<ReadOnlyField
				label="Datasources"
				value={course.datasources.map((source) => source.name).join(', ') || '—'}
				hint="Where the numbers on this page came from."
			/>
		</div>
	</section>

	<section class="stack">
		<h2>Tees</h2>
		<p class="hint">
			Par is the tee's, not the scorecard's: the two can disagree legitimately, which is what{' '}
			<code>par_ladies</code> is for on the four tees that carry it. Both are shown as they are
			stored rather than reconciled into a number neither holds.
		</p>
		<p class="hint">
			The <code>id</code> is assigned on import and does not change when a tee is renamed, which is
			what lets a name be edited later. It is not written to the committed files — those keep
			saying <code>White</code>, which is what the site reads and what an event's round matches on.
		</p>

		{
			tees.length === 0 ? (
				<p class="notice">No tees recorded. This course has no scorecard either.</p>
			) : (
				<div class="tablewrap">
					<table class="datagrid">
						<thead>
							<tr>
								<th>Tee</th>
								<th>Id</th>
								<th>Length</th>
								<th>Par</th>
								<th>Rating (m/l)</th>
								<th>Slope (m/l)</th>
							</tr>
						</thead>
						<tbody>
							{tees.map((tee) => (
								<tr>
									<td>
										<span class="swatch" style={`background: ${tee.color}`} />
										{tee.name}
										{tee.name_local && <span class="local">{tee.name_local}</span>}
									</td>
									<td><code>{tee.id ?? '—'}</code></td>
									<td class="num">{tee.length} m</td>
									<td class="num">
										{tee.par}
										{tee.par_ladies !== undefined && ` / ${tee.par_ladies}`}
									</td>
									<td class="num">
										{tee.rating.men ?? '—'} / {tee.rating.ladies ?? '—'}
									</td>
									<td class="num">
										{tee.slope.men ?? '—'} / {tee.slope.ladies ?? '—'}
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			)
		}
	</section>

	{
		holes.length > 0 && (
			<section class="stack">
				<div class="row-between">
					<h2>Scorecard</h2>
					<span class="meta">{holes.length} holes</span>
				</div>
				<p class="hint">
					Lengths are keyed by tee <em>name</em>, which is why renaming a tee has to rekey them
					in the same change — see <code>course-tee-names.test.ts</code>.
				</p>

				<div class="tablewrap">
					<table class="datagrid">
						<thead>
							<tr>
								<th>Hole</th>
								<th>Par</th>
								<th>Index</th>
								{tees.map((tee) => (
									<th class="num">{tee.name}</th>
								))}
							</tr>
						</thead>
						<tbody>
							{holes.map((hole) => (
								<tr>
									<td class="num">{hole.hole}</td>
									<td class="num">{hole.par}</td>
									<td class="num">{hole.hcp}</td>
									{tees.map((tee) => (
										<td class="num">{lengthAt(hole, tee.name) ?? '—'}</td>
									))}
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>
		)
	}

	{
		paragraphs.length > 0 && (
			<section class="stack">
				<h2>Description</h2>
				<div class="prose">
					{paragraphs.map((paragraph) => (
						<p>{paragraph}</p>
					))}
				</div>
			</section>
		)
	}
</AdminLayout>

<style>
	h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.2rem;
	}

	.hint {
		margin: 0;
		font-size: 0.8rem;
		color: var(--text-dim);
	}

	.swatch {
		display: inline-block;
		width: 0.7rem;
		height: 0.7rem;
		margin-right: 0.45rem;
		border: 1px solid var(--line-strong);
		border-radius: 2px;
		vertical-align: baseline;
	}

	.local {
		margin-left: 0.45rem;
		color: var(--text-dim);
		font-size: 0.85em;
	}

	.prose {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		max-width: 48rem;
		color: var(--text-muted);
	}

	.prose p {
		margin: 0;
	}
</style>
