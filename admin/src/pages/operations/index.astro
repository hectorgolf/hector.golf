---
import AdminLayout from "../../layouts/AdminLayout.astro";
import PageHeader from "@hector/ui/components/PageHeader.astro";
import GitHubTokenHelp from "../../components/GitHubTokenHelp.astro";
import RunLog from "../../components/RunLog.astro";

import { EXPIRY_WARN_DAYS, FAILURE_MESSAGES, github, type GitHubFailure } from "../../lib/github.ts";
import { ageInWords } from "../../lib/runs.ts";
import { DISPATCHABLE_WORKFLOWS, workflowBySlug } from "../../lib/workflows.ts";
import { JOBS, jobBySlug } from "../../lib/jobs/registry.ts";
import { recentAll as recentJobRuns } from "../../lib/jobs/log.ts";
import { FORWARD_PAGES, recentAll as recentWorkflowRuns, sync } from "../../lib/workflow-runs.ts";
import { collect, RECENT, TONE_PILL, typeOf } from "../../lib/runlog.ts";

/*
 * The outcome of a dispatch arrives as query parameters rather than as anything
 * held on the server, because the endpoints answer a form POST with a redirect
 * and there is nowhere between the two to keep state — no session, and the
 * service scales to zero between visits.
 *
 * Both parameters are therefore whatever was in the URL bar, so neither is
 * rendered. They are looked up: the slug against the workflow list, the reason
 * against the failure messages. Anything that does not resolve falls back to
 * wording of our own, so nothing a stranger can put in a link reaches the page.
 *
 * This is still the only route by which a press reports back. `lib/run-now.ts`
 * does the POST with fetch rather than by navigating, but it follows the same
 * redirect and renders the same page at the same address — deliberately, so that
 * the scripted path and the no-script path cannot tell different stories.
 */
const ranParam = Astro.url.searchParams.get("ran");
const ranAll = ranParam === "scheduled";
const ran = workflowBySlug(ranParam ?? undefined);
const failed = workflowBySlug(Astro.url.searchParams.get("failed") ?? undefined);
/*
 * Jobs report through their own parameters, because a slug is only unique within
 * its own list: `handicaps` names both `update-handicaps.yml` and the in-process
 * job that shadows it. Sharing `ran`/`failed` would mean whichever list the page
 * checked first claimed every press.
 */
const failedJob = jobBySlug(Astro.url.searchParams.get("failedJob") ?? undefined);
/*
 * Read twice, deliberately. The GitHub endpoints redirect with a `GitHubFailure`
 * and the job endpoint with reasons of its own, so the cast below is only valid
 * for the first kind — `rawReason` is what the job branch compares against, and
 * keeping them apart is what stopped `already-running` being quietly treated as
 * a GitHub failure with no message.
 */
const rawReason = Astro.url.searchParams.get("reason");
const reason = rawReason as GitHubFailure | null;
const failureMessage = reason && reason in FAILURE_MESSAGES ? FAILURE_MESSAGES[reason] : undefined;

/*
 * Bring the mirror of GitHub's runs up to date, then read the log out of
 * Firestore.
 *
 * The sync is what this page spends its latency on: five requests, made at once,
 * each asking only whether anything has run since the last visit. What makes
 * them cheap is the mirror itself — everything below the high-water mark is
 * already held, so the question fits in a page of ten runs rather than a hundred.
 * `lib/workflow-runs.ts` has the argument, and the measurement, in full.
 *
 * It is also why the log below can reach further back than a page, and why an
 * unreachable GitHub now costs this page the *newest* runs rather than all of
 * them.
 *
 * Awaited before anything reads the token's expiry, which is the one ordering
 * constraint on this page — see the note further down.
 */
const { failures } = await sync(DISPATCHABLE_WORKFLOWS, { maxPages: FORWARD_PAGES });

/*
 * One more row than the page shows, from each half, because the merge is what
 * decides which rows make the top fifty — and because the fifty-first is how the
 * page knows there is a full log worth linking to.
 */
const entries = await collect({
	workflows: DISPATCHABLE_WORKFLOWS,
	jobs: JOBS,
	workflowRuns: () => recentWorkflowRuns(RECENT + 1),
	jobRuns: () => recentJobRuns(RECENT + 1),
});

const log = entries.slice(0, RECENT);
const more = entries.length > RECENT;

/*
 * The cards below each summarise one thing's last run, and they read it out of
 * the log rather than fetching it a second time. The list is newest first, so
 * the first entry of a type is that type's latest run.
 */
const latestOf = (type: string) => entries.find((entry) => entry.type === type);

/*
 * Whether the token itself is the problem, and therefore whether to put the
 * instructions for fixing it on the page.
 *
 * Read from the run-history calls rather than only from a failed dispatch, so an
 * admin who arrives before pressing anything is told why the page is empty. The
 * dispatch's reason is folded in too, for the one case the histories cannot see:
 * a token granted Actions *read* would list runs happily and then be refused the
 * dispatch.
 */
const tokenTrouble: GitHubFailure[] = [
	...failures.map((failure) => failure.reason),
	...(failureMessage && reason ? [reason] : []),
];

/*
 * How long the token has left, if GitHub has said.
 *
 * Read *after* the histories above have been awaited, and that ordering is the
 * whole of the mechanism: the value is a header picked off those very calls
 * rather than something asked for separately, so it is empty until one of them
 * has come back. Nothing else on this page needs to know that, but moving this
 * line above the `await` would silently turn the warning off.
 *
 * Absent is normal and means "no idea": a classic token carries no expiry, and
 * neither does the local stand-in unless it has been asked to. Silence is the
 * right rendering of that — a token nobody can date is not a token about to
 * expire.
 */
const expiry = github().tokenExpiry();

/*
 * Which of the three gets the walkthrough, at most one.
 *
 * Ranked rather than combined, because a token that is both expiring and
 * refused is a token that has expired, and being told twice is worse than being
 * told once. The hard failures win: they are why the page is empty, and the
 * expiry warning would be describing something that has already happened.
 */
const tokenHelp = tokenTrouble.includes("not-configured")
	? "missing"
	: tokenTrouble.includes("unauthorized")
		? "rejected"
		: expiry && expiry.daysLeft <= EXPIRY_WARN_DAYS
			? "expiring"
			: undefined;

const historyFailure = failures[0];

const ranJob = jobBySlug(Astro.url.searchParams.get("ranJob") ?? undefined);

/*
 * Whether anything on this page is still in shadow mode.
 *
 * The lede below explains what a shadow run is, which is worth a sentence only
 * while one exists. Handicaps went live on 2026-09-18 and is currently the only
 * job, so that sentence would otherwise describe nothing on the page — and the
 * next dataset to arrive will land in shadow mode and want it back. Derived
 * rather than deleted, so it comes and goes on its own.
 */
const anyShadowed = JOBS.some((job) => job.dryRun);

const now = new Date();
---

<AdminLayout title="Operations">
	<PageHeader
		title="Operations"
		lede="The scrapes that keep the site's data current: when they last ran, and a way to run one now."
	/>

	{
		ranJob ? (
			<p class="notice good" data-transient>
				Ran <strong>{ranJob.label}</strong>. Unlike a workflow, this one finished before the page loaded — its
				result is in the run log below.
			</p>
		) : (
			ranAll ? (
				<p class="notice good" data-transient>
					Ran a tick. Workflows that were due have been dispatched and take a minute or two to appear in the
					log below; anything on an interval that was not yet stale was skipped, and this service's own jobs
					have already finished — their results are in the same log.
				</p>
			) : (
				ran && (
					<p class="notice good" data-transient>
						Asked GitHub to run <strong>{ran.label}</strong>. A run takes a minute or two to appear in the
						log below, and the site rebuilds after it commits.
					</p>
				)
			)
		)
	}

	{
		failedJob ? (
			/*
			 * Three outcomes wearing one word until now. Two of these are skips —
			 * the run did not happen — and only the third is a failure, which is
			 * the distinction `lib/jobs/execute.ts` draws and the run log has
			 * always drawn with a neutral pill. The notice matches the pill: a
			 * red banner over "the next tick will do it" teaches an admin to
			 * disregard the red banners.
			 */
			rawReason === "already-running" ? (
				<p class="notice" data-transient>
					<strong>{failedJob.label}</strong> did not run. Another run of it was already going, so this one
					was dropped rather than queued — the next tick reads the same sources anyway.
				</p>
			) : rawReason === "not-configured" ? (
				<p class="notice" data-transient>
					<strong>{failedJob.label}</strong> did not run. This service has no GitHub token, so it stopped
					before it started rather than part way through: nothing was read and nothing was written. Setting
					one is described further down this page.
				</p>
			) : (
				<p class="notice bad">
					<strong>{failedJob.label}</strong> did not finish. The reason is in the run log below, and the
					detail is in Cloud Logging.
				</p>
			)
		) : (
			failed && (
				<p class="notice bad">
					Could not start <strong>{failed.label}</strong>.{" "}
					{failureMessage ?? "GitHub refused the request. The details are in Cloud Logging."}
				</p>
			)
		)
	}

	{/*
	 * The one outcome the server cannot render, because the server is what went
	 * quiet. Written here rather than built in `lib/run-now.ts` so that the page's
	 * wording all lives in the page; the script only unhides it.
	 *
	 * The likeliest cause by far is an IAP session that expired under a tab left
	 * open overnight, which is why this says reload rather than try again — the
	 * reload is what takes you back through sign-in, and a second press would at
	 * best be dropped by the lease.
	 */}
	<p class="notice bad" id="lost-contact" role="alert" hidden>
		Lost contact with the service while that was running. It may well have finished — <strong>reload the page</strong>
		to see, rather than pressing again. A tab that has been open a long time is usually a sign-in that has expired.
	</p>

	<p class="lede-note">
		Cloud Scheduler starts these <strong>every two hours from 03:00 to 07:00 UTC</strong><span>, and once at </span>
		<strong>12:00 UTC</strong> — one call that starts everything, which is why their start times in the log sit
		within a minute or two of each other. Since the <code>schedule:</code> crons were deleted this is the only clock:
		nothing here runs on GitHub's own schedule any more. The morning is a window rather than a moment because the
		association publishes handicaps at no fixed time, and a handicap that lands after the first tee shot is too late
		to be the one anyone played off.
	</p>

	<article class="card tick">
		<div class="row-between">
			<div>
				<h2>Run a tick now</h2>
				{/*
				 * The same request Cloud Scheduler makes, rather than a shortcut
				 * that presses every button in turn. If this did something the
				 * schedule does not, it would be a second implementation of the
				 * schedule and the first one to drift.
				 */}
				<p class="blurb">
					Does exactly what a scheduled tick does: dispatches the workflows that are <strong>due</strong>,
					and runs this service's own jobs. Not everything runs on every tick — a workflow on an interval is
					skipped until it is stale enough, and the log below is where you see which.
				</p>
			</div>
			<form method="POST" action="/api/workflows/dispatch">
				<button type="submit" data-busy="Ticking…">Tick</button>
			</form>
		</div>
		<p class="last-run muted">
			Nothing here is fire-and-forget: the workflows are dispatched in a moment, but this service's own jobs run
			inside the request, and a handicap sweep is tens of seconds. The button says so while it waits.
		</p>
	</article>

	{tokenHelp && <GitHubTokenHelp mode={tokenHelp} daysLeft={expiry?.daysLeft} />}

	<section class="delegated">
		<h2>Jobs this service delegates to GitHub</h2>
		<p class="lede-note">
			Pressing one of these asks GitHub to run the workflow; the work happens on a runner and the
			commits come back from there. The section below is the other half of the migration — the same
			kind of work, done in this process.
		</p>

		<div class="workflows">
		{
			DISPATCHABLE_WORKFLOWS.map((workflow) => {
				const latest = latestOf(typeOf("workflow", workflow.slug));
				const unreadable = failures.some((failure) => failure.slug === workflow.slug);

				return (
					<article class="card workflow">
						<div class="row-between">
							<h3>{workflow.label}</h3>
							{/*
							 * A form rather than a link, because this changes
							 * something: the button is the submit and the endpoint
							 * redirects back here. `lib/run-now.ts` intercepts the
							 * submit and does the same thing with fetch, so the
							 * press is visible while it waits — `data-busy` is what
							 * marks a button as one of the ones it drives, and
							 * carries the label it wears meanwhile.
							 */}
							{/*
							 * "Run on GitHub" rather than "Run now", and the job's
							 * button below says where it runs too. Not a flourish:
							 * during the migration a dataset appears in both lists
							 * under the *same label* — `registry.ts` explains why
							 * that duplication is deliberate — so for handicaps
							 * there are two cards on this page both titled
							 * "Players' official handicaps".
							 *
							 * While the job was in shadow mode its button read
							 * "Shadow run" and the pair could be told apart. Going
							 * live made both read "Run now", and the first person
							 * to use the page afterwards pressed the wrong one
							 * within the hour. Where the work happens is the
							 * distinction that matters at the moment of pressing —
							 * one dispatches a workflow, the other writes to
							 * Firestore and pushes a commit from this process — so
							 * that is what the buttons say.
							 */}
							<form method="POST" action={`/api/workflows/${workflow.slug}/dispatch`}>
								<button type="submit" data-busy="Running…">Run on GitHub</button>
							</form>
						</div>

						<p class="blurb">{workflow.blurb}</p>

						{latest ? (
							<p class="last-run">
								Last run <time datetime={latest.startedAt}>{ageInWords(latest.startedAt, now)}</time>,{" "}
								{latest.by} —{" "}
								<a href={latest.url} rel="noreferrer">
									<span class:list={["pill", TONE_PILL[latest.tone]]}>{latest.outcome}</span>
								</a>
							</p>
						) : (
							<p class="last-run muted">
								{unreadable ? "Could not read the run history from GitHub." : "No runs recorded yet."}
							</p>
						)}
					</article>
				);
			})
		}
		</div>
	</section>

	<section class="jobs">
		<h2>Jobs this service runs itself</h2>
		<p class="lede-note">
			These do not go to GitHub — the work happens in this service, in the request. The same Cloud Scheduler call
			that dispatches the workflows above runs every job marked scheduled, so their histories line up.{" "}
			{
				/* Its own sentence rather than a clause, so that dropping it leaves the
				   one after it still starting with a capital. */
				anyShadowed && (
					<>
						A <strong>shadow</strong> run computes what it would have written and writes nothing.{" "}
					</>
				)
			}
			See <code>docs/plans/handicaps-to-firestore.md</code>.
		</p>

		<div class="workflows">
			{
				JOBS.map((job) => {
					const latest = latestOf(typeOf("job", job.slug));

					return (
						<article class="card workflow">
							<div class="row-between">
								<h3>{job.label}</h3>
								{/*
								 * Same shape as the workflow buttons above, and the
								 * one this page was scripted for: it waits out a
								 * 45-player scrape before the reply comes back, and
								 * a button that sits there unmoved for that long is
								 * a button an admin presses twice.
								 */}
								{/* "Run here" against the workflow's "Run on GitHub" — see the note there. */}
								<form method="POST" action={`/api/jobs/${job.slug}/run`}>
									<button type="submit" data-busy="Running…">
										{job.dryRun ? "Shadow run" : "Run here"}
									</button>
								</form>
							</div>

							<p class="blurb">{job.blurb}</p>

							{latest ? (
								<p class="last-run">
									Last run <time datetime={latest.startedAt}>{ageInWords(latest.startedAt, now)}</time>{" "}
									— <span class:list={["pill", TONE_PILL[latest.tone]]}>{latest.outcome}</span>{" "}
									<span class="muted">{latest.detail}</span>
								</p>
							) : (
								<p class="last-run muted">No runs recorded yet.</p>
							)}
						</article>
					);
				})
			}
		</div>
	</section>

	<section class="log">
		<div class="row-between">
			<h2>Recent runs</h2>
			{/*
			 * Only when there is more to see, so the link is information rather
			 * than furniture: on a fresh deployment, or after a quiet stretch,
			 * "See all" leading to the same fifty rows teaches a reader to stop
			 * following it.
			 */}
			{more && <a class="seeall" href="/operations/runs">See all runs →</a>}
		</div>
		<p class="lede-note">
			Both halves of this page in one list, newest first — the workflows GitHub ran and the jobs this service ran
			itself, which is how you see that a tick's job and its workflow started seconds apart. Every start time is
			UTC, to the second, and the pattern down the column is what says when the next scheduled run is due: a
			repeating <code>03:00:xx</code> means tonight at three.
			{more && <> The last {RECENT} are here; the rest are on the <a href="/operations/runs">full run log</a>,
			which can be narrowed to one job or one outcome.</>}
		</p>

		{
			log.length > 0 ? (
				<RunLog entries={log} now={now} />
			) : (
				<p class="notice">
					{historyFailure ? FAILURE_MESSAGES[historyFailure.reason] : "No runs recorded yet."}
				</p>
			)
		}
	</section>
</AdminLayout>

{/*
 * The admin's only client-side script, and deliberately the only page that has
 * one — see `lib/run-now.ts` for why this page and not the others. Everything
 * here still works without it: the forms are real forms, and the endpoints still
 * answer them with the redirect they always did.
 */}
<script>
	import { enhance } from "../../lib/run-now.ts";

	enhance(document);
</script>

<style>
	.lede-note {
		color: var(--text-muted);
		font-size: 0.9rem;
		max-width: 46rem;
	}

	.workflows {
		display: grid;
		gap: 1rem;
	}

	.workflow {
		padding: 1.1rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.workflow h3 {
		margin: 0;
		font-size: 1.05rem;
	}

	/*
	 * Every section heading on this page, sized once.
	 *
	 * 1.35rem is what `packages/ui/styles/hector.css` gives `.section-head h2` —
	 * the bottom of its h2 clamp, which is the size a heading *inside* a page
	 * gets as opposed to the page's own title. Pinned rather than left to the
	 * clamp so that four headings on one page do not resize against each other
	 * as the viewport changes.
	 *
	 * They have to match each other because a reader is meant to compare them:
	 * the two lists are the same kind of thing done in two places, and the
	 * headings are what say so. They have to sit above the cards' `h3` for the
	 * same reason — a section heading rendering at card size is a hierarchy the
	 * markup claims and the page does not show.
	 */
	.delegated h2,
	.jobs h2,
	.log h2,
	.tick h2 {
		font-size: 1.35rem;
	}

	.delegated h2,
	.jobs h2 {
		margin: 0 0 0.3rem;
	}

	.delegated .lede-note,
	.jobs .lede-note {
		margin: 0 0 0.9rem;
	}

	.delegated {
		margin-bottom: 2rem;
	}

	.workflow form,
	.tick form {
		margin: 0;
	}

	/*
	 * A notice on its way out. Only `lib/run-now.ts` adds this, so without
	 * JavaScript nothing ever fades and nothing needs to.
	 */
	.notice.dismissing {
		opacity: 0;
		transition: opacity 0.4s ease-out;
	}

	/*
	 * Every button goes out of service while one of them is working, and the
	 * global `button:disabled` fades them to 0.45 — right for the ones that are
	 * merely unavailable, wrong for the one whose label is the status. This
	 * keeps the working button readable and puts the waiting cursor on it.
	 */
	button[aria-busy="true"]:disabled {
		opacity: 0.8;
		cursor: progress;
	}

	/*
	 * The tick card sits above the per-workflow cards and is the one action on
	 * this page that stands for all of them, so it reads as a band rather than as
	 * another item in the list. Same card, wider gap, and the heading matches the
	 * section headings below rather than the per-workflow ones.
	 */
	.tick {
		padding: 1.1rem 1.25rem;
		margin-bottom: 1.25rem;
	}

	.tick h2 {
		margin: 0 0 0.35rem;
	}

	.tick .row-between {
		gap: 1.25rem;
		align-items: flex-start;
	}

	.tick .last-run {
		margin-top: 0.75rem;
	}

	.blurb,
	.last-run {
		margin: 0;
		font-size: 0.9rem;
	}

	.blurb {
		color: var(--text-muted);
	}

	.muted {
		color: var(--text-dim);
	}

	.log {
		margin-top: 2rem;
	}

	.log h2 {
		margin: 0 0 0.3rem;
	}

	.log .lede-note {
		margin: 0 0 0.9rem;
	}

	/*
	 * Beside the heading rather than under the table. The point of this page is
	 * the top of the list, so the way out of it belongs where a reader decides
	 * whether to read on — not fifty rows further down, past the thing they were
	 * looking for.
	 */
	.seeall {
		font-size: 0.9rem;
		white-space: nowrap;
	}
</style>
