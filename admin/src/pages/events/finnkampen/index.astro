---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import PageHeader from '@hector/ui/components/PageHeader.astro'
import Breadcrumb from '@hector/ui/components/Breadcrumb.astro'
import MirrorNotice from '../../../components/MirrorNotice.astro'

import { EventFormat, type FinnkampenEvent } from '@hector/schemas/src/events.ts'
import { formatEventDates } from '@hector/schemas/src/dates.ts'
import { listEventsOfFormat } from '../../../lib/repository/events.ts'
import { eventMirror } from '../../../lib/mirror.ts'

let events: FinnkampenEvent[] = []
let error: string | undefined

try {
	events = await listEventsOfFormat(EventFormat.Finnkampen)
} catch {
	// The reason goes to Cloud Logging; the page says only that it failed.
	error = 'Could not read the events. Check the service logs.'
}

const mirror = eventMirror(EventFormat.Finnkampen)
---

<AdminLayout title="Finnkampen">
	<Breadcrumb title="Events" href="/events" />

	<PageHeader
		title="Finnkampen"
		lede="Finland against Sweden. Two events, played in 2021 and 2022."
	/>

	{mirror && <MirrorNotice mirror={mirror} what="A Finnkampen event" />}

	<p class="notice">
		Neither of these is on the public site. Both carry <code>ignore</code>, and there is no
		<code>/events/finnkampen/</code> route for them to be on — so this page is the only place
		they are rendered at all.
	</p>

	{error && <p class="notice bad">{error}</p>}

	{!error && events.length === 0 && (
		<p class="notice">
			No Finnkampen events in the store. <code>npm run seed</code> imports them from the
			committed files.
		</p>
	)}

	{
		events.length > 0 && (
			<div class="tablewrap">
				<table class="datagrid">
					<thead>
						<tr>
							<th>Event</th>
							<th>When</th>
							<th>Where</th>
							<th>Field</th>
							<th>Teams</th>
							<th>Won by</th>
						</tr>
					</thead>
					<tbody>
						{events.map((event) => (
							<tr>
								<td><a href={`/events/finnkampen/${event.id}`}>{event.name}</a></td>
								<td class="num">{formatEventDates(event)}</td>
								<td>{event.location}</td>
								<td class="num">{event.participants.length}</td>
								<td class="num">{event.results?.teams.length ?? 0}</td>
								<td>{event.results?.winners.finnkampen?.join(', ') || '—'}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		)
	}
</AdminLayout>
