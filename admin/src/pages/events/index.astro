---
import AdminLayout from '../../layouts/AdminLayout.astro'
import PageHeader from '@hector/ui/components/PageHeader.astro'
import { EVENT_FAMILIES, hasPage } from '../../lib/sections.ts'
import { countEventsByFormat } from '../../lib/repository/events.ts'

/** Same two labelled states as the dashboard; see `src/pages/index.astro`. */
const PILL: Partial<Record<(typeof EVENT_FAMILIES)[number]['readiness'], string>> = {
	'read-only': 'Read-only',
	planned: 'Not built yet',
}

/**
 * Counts come from the store rather than being hard-coded, so a format that
 * reads zero is telling the truth about the database rather than about whether
 * anyone has built its page yet. They are shown for a family with no page too,
 * which is what said the import had worked before any of these pages existed.
 *
 * This page covers `EVENT_FAMILIES` and not `EventFormat`, so a format with no
 * family is not counted here and is not visible anywhere in the admin. Two
 * Finnkampen events are in that position since 2026-09-20 — `countEventsByFormat`
 * still returns them under a key nothing reads. Deliberate, and recorded in
 * `architecture.md` §13; if they ever need to be seen again, an entry in
 * `sections.ts` is the whole of it.
 *
 * An empty object means the store could not be reached; a missing key means it
 * could and there is nothing of that format in it.
 */
let counts: Record<string, number> = {}
let error: string | undefined

try {
	counts = await countEventsByFormat()
} catch {
	// The reason goes to Cloud Logging; the page says only that it failed.
	error = 'Could not read the events. Check the service logs.'
}
---

<AdminLayout title="Events">
	<PageHeader title="Events" lede="Every event Hector has run, by the format it was played in." />

	{error && <p class="notice bad">{error}</p>}

	<div class="families">
		{
			EVENT_FAMILIES.map((family) => (
				<article class:list={['card', 'family-card', { soon: family.readiness === 'planned' }]}>
					<h2>
						{hasPage(family) ? (
							<a href={`/events/${family.slug}`}>{family.label}</a>
						) : (
							family.label
						)}
						{PILL[family.readiness] && (
							<span class="pill pill-outline">{PILL[family.readiness]}</span>
						)}
					</h2>
					<p>{family.blurb}</p>
					{!error && (
						<p class="count">
							{counts[family.slug] ?? 0}{' '}
							{counts[family.slug] === 1 ? 'event' : 'events'}
						</p>
					)}
				</article>
			))
		}
	</div>
</AdminLayout>

<style>
	.families {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1rem;
	}

	.family-card {
		padding: 1.1rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.family-card h2 {
		margin: 0;
		font-size: 1.05rem;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.family-card p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.family-card .count {
		margin-top: auto;
		padding-top: 0.4rem;
		font-variant-numeric: tabular-nums;
		color: var(--text);
	}

	.family-card.soon {
		opacity: 0.6;
	}
</style>
