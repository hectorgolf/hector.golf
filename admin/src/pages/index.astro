---
import AdminLayout from '../layouts/AdminLayout.astro'
import PageHeader from '@hector/ui/components/PageHeader.astro'
import { SECTIONS, hasPage } from '../lib/sections.ts'

/*
 * The pill says what a card's readiness is, and the two states that get one are
 * the two a reader could be wrong about. `editable` gets none: a section with no
 * pill is the ordinary case, and labelling it would make the other two look like
 * exceptions rather than like the majority of the admin, which today they are.
 */
const PILL: Partial<Record<(typeof SECTIONS)[number]['readiness'], string>> = {
	'read-only': 'Read-only',
	planned: 'Not built yet',
}
---

<AdminLayout title="Dashboard">
	<PageHeader title="Admin" lede="Manage the data behind hector.golf." />

	<div class="sections">
		{
			SECTIONS.map((section) => (
				<article class:list={['card', 'section-card', { soon: section.readiness === 'planned' }]}>
					<h2>
						{hasPage(section) ? <a href={`/${section.slug}`}>{section.label}</a> : section.label}
						{PILL[section.readiness] && (
							<span class="pill pill-outline">{PILL[section.readiness]}</span>
						)}
					</h2>
					<p>{section.blurb}</p>
				</article>
			))
		}
	</div>
</AdminLayout>

<style>
	.sections {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1rem;
	}

	.section-card {
		padding: 1.1rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.section-card h2 {
		margin: 0;
		font-size: 1.05rem;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.section-card p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.section-card.soon {
		opacity: 0.6;
	}
</style>
