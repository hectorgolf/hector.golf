{
  "name": "hector-admin",
  "private": true,
  "type": "module",
  "description": "Admin UI and API for hector.golf. Astro SSR on Cloud Run, behind IAP.",
  "scripts": {
    "dev": "astro dev",
    "dev:iap": "tsx scripts/dev-iap.ts",
    "dev:fake": "tsx scripts/dev-fake.ts",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "export": "tsx scripts/export.ts",
    "rotate-hooks-api-key": "tsx scripts/rotate-hooks-key.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.6",
    "@google-cloud/firestore": "^9.2.0",
