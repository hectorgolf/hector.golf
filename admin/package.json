    "@google-cloud/storage": "^8.2.0",
    "@hector/schemas": "*",
    "@hector/ui": "*",
    "@hector/wisegolf": "*",
    "astro": "^7.2.9",
    "parse-duration": "^2.1.9",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "glob": "^13.0.6",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
