---
import Layout from '../../../../layouts/Layout.astro';
import Breadcrumb from '@hector/ui/components/Breadcrumb.astro';
import { type Course } from '@hector/schemas/src/courses.ts';
import { getCourseById } from '../../../../code/courses';
import { getCollection } from 'astro:content';


export async function getStaticPaths() {
    const coursesData: Promise<Course[]> = getCollection('courses').then(collection => collection.map(course => course.data));
    const courses = await coursesData;
    return courses.flatMap((course) => {
        return (course.course?.descriptions || []).map((description) => {
            return { params: { slug: course.id, hole: description.hole.toString() } };
        });
    });
}

const { slug, hole } = Astro.params;
const holeNumber = parseInt(hole);
let course: Course|undefined = getCourseById(slug);
if (!course) {
    console.error(`No such course: ${slug}`);
    Astro.response.status = 404;
}
course = course!
const holeDescription = course.course?.descriptions?.find((description) => description.hole === holeNumber);
const hasScorecard = (course.course?.scorecard?.men !== undefined || course.course?.scorecard?.ladies !== undefined)
if (!holeDescription || !hasScorecard) {
    console.error(`No hole description found for hole ${hole} on course ${slug}`);
    Astro.response.status = 404;
}
const holeData = (course.course!.scorecard?.men || course.course!.scorecard?.ladies).find((holeOnCourse) => holeOnCourse.hole === holeNumber);
const courseHref = `/courses/${slug}`;
const numberOfHoles = course.course!.descriptions!.length
const prevHoleHref = `${courseHref}/holes/${holeNumber == 1 ? numberOfHoles : holeNumber - 1}`;
const nextHoleHref = `${courseHref}/holes/${holeNumber == numberOfHoles ? 1 : holeNumber + 1}`;
---

<Layout title={`${course.name} #${holeNumber}`} section="courses">
    <main class="page">
        <div class="breadcrumbs">
            <Breadcrumb title="Home" href="/" />
            <Breadcrumb title="Courses" href="/courses" />
            <Breadcrumb title={course.name} href={courseHref} />
        </div>

        <div class="hole-header">
            <span class="eyebrow">{course.name}</span>
            <div class="hole-nav">
                <a class="nav-arrow" href={prevHoleHref} aria-label="Previous hole">&#8249;</a>
                <h1 class="score">{hole}</h1>
                <a class="nav-arrow" href={nextHoleHref} aria-label="Next hole">&#8250;</a>
            </div>
            <span class="meta">Hole {hole} of {numberOfHoles}</span>
        </div>

        <div class="hole-body">
            <div class="hole-specs card">
                <div class="spec-row">
                    <div class="spec">
                        <span class="label">Par</span>
                        <span class="score value">{holeData?.par}</span>
                    </div>
                    <div class="spec">
                        <span class="label">Hcp</span>
                        <span class="score value">{holeData?.hcp}</span>
                    </div>
                </div>
                <table class="data tee-lengths">
                    <caption>Playing length</caption>
                    <tbody>
                        {course.course!.tees.map((tee) => (
                            <tr>
                                <td class="tee">
                                    <svg class="color" width="18" viewBox="0 0 22 22" xmlns="http://www.w3.org/2000/svg">
                                        <circle
                                            cx="12"
                                            cy="12"
                                            r="6"
                                            style={`fill:${tee.color};stroke:${tee.stroke || tee.color};`}
                                        />
                                    </svg>
                                    <span>{tee.name}</span>
                                </td>
                                <td class="numeric">{holeData?.lengths?.[tee.name]} m</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            <figure class="hole-layout">
                <img src={holeDescription?.layout} alt={`Layout of hole ${hole}`} />
            </figure>
        </div>

        {holeDescription?.description && <p class="hole-description">{holeDescription.description}</p>}
    </main>
</Layout>

<style>
    .hole-header {
        padding: 2rem 0 1.5rem;
        text-align: center;
    }

    .hole-header .eyebrow,
    .hole-header .meta {
        display: block;
    }

    .hole-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        margin: 0.35rem 0 0.5rem;
    }

    .hole-nav h1 {
        font-family: var(--font-score);
        font-size: clamp(3rem, 12vw, 4.5rem);
        line-height: 1;
        min-width: 3ch;
        margin: 0;
    }

    .nav-arrow {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 9999px;
        border: 1px solid var(--line-strong);
        background: var(--surface);
        color: var(--text-muted);
        font-size: 1.4rem;
        line-height: 1;
        padding-bottom: 0.15em;
    }

    .nav-arrow:hover {
        border-color: var(--violet-700);
        color: var(--ink-50);
    }

    .hole-body {
        display: grid;
        gap: 1rem;
        grid-template-columns: minmax(180px, 260px) 1fr;
        align-items: start;
    }

    .hole-specs {
        padding: 1rem 1.1rem 1.1rem;
    }

    .spec-row {
        display: flex;
        gap: 1.75rem;
        padding-bottom: 0.9rem;
        margin-bottom: 0.9rem;
        border-bottom: 1px solid var(--line);
    }

    .spec {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }

    .spec .label {
        font-size: 10px;
        letter-spacing: 0.16em;
    }

    .spec .value {
        font-size: 1.9rem;
        line-height: 1;
        color: var(--ink-50);
    }

    .tee-lengths .tee {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--ink-200);
    }

    .tee-lengths .numeric {
        color: var(--text-muted);
    }

    /* Layout art is dark-on-white, so it keeps a light plate. */
    .hole-layout {
        margin: 0;
        padding: 0.75rem;
        border-radius: var(--radius-lg);
        border: 1px solid var(--line);
        background: var(--ink-100);
        text-align: center;
    }

    .hole-layout img {
        max-height: 560px;
        margin-inline: auto;
    }

    .hole-description {
        margin-top: 1.75rem;
        color: var(--text-muted);
    }

    @media (max-width: 640px) {
        .hole-body {
            grid-template-columns: 1fr;
        }
    }
</style>
