---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHeader from '../../components/PageHeader.astro';
import CourseRatingTable from '../../components/courses/CourseRatingTable.astro';
import ScorecardTable from '../../components/courses/ScorecardTable.astro';
import { type Course } from '../../schemas/courses';
import { getEventsAtCourse, linkToEvent } from '../../code/events';
import { getCourseById } from '../../code/courses';
import { getCollection } from 'astro:content';


export async function getStaticPaths() {
    const courses = await getCollection('courses');
    return courses.map(course => ({
        params: { slug: course.id },
        props: course,
    }));
}

const { slug } = Astro.params;
let course: Course|undefined = getCourseById(slug);
if (!course) {
    Astro.response.status = 404;
}
course = course!

const relatedEvents = getEventsAtCourse(course.id);
const holeLayoutShape = course.course?.descriptions?.[0]?.shape === 'wide' ? 'wide' : 'narrow';

---

<Layout title={course.name} section="courses">
    <main class="page">
        <div class="breadcrumbs">
            <Breadcrumb title="Home" href="/" />
            <Breadcrumb title="Courses" href="/courses" />
        </div>
        <PageHeader
            title={course.name}
            eyebrow="Course"
            meta={[course.contact?.address]}
        />

        <figure class="hero-figure course-hero">
            <img src={course.hero_image} alt="" />
            {course.contact?.address && <figcaption>{course.contact.address}</figcaption>}
        </figure>

        <div class="description">
            {course.description_long.map((segment) => {
                if (segment.type === 'image') {
                    return (
                        <figure class="hero-figure inline-figure">
                            <img src={segment.url} alt="" />
                        </figure>
                    )
                }
                if (segment.type === 'paragraph' && segment.content) {
                    return <p>{segment.content}</p>
                }
            })}
        </div>

        <CourseRatingTable course={course} />

        <ScorecardTable course={course} />

        {course.images.course_layout && (
            <section class="section">
                <div class="section-head">
                    <h2>Course layout</h2>
                </div>
                <figure class="hero-figure layout-figure">
                    <img src={course.images.course_layout} alt={`Layout of ${course.name}`} />
                </figure>
            </section>
        )}

        {course.course?.descriptions && (
            <section class="section">
                <div class="section-head">
                    <h2>Holes</h2>
                    <span class="meta">{course.course.descriptions.length} holes</span>
                </div>
                <ul role="list" class:list={['holes-grid', holeLayoutShape]}>
                    {course.course.descriptions.map((hole) => (
                        <li class:list={['hole', holeLayoutShape]}>
                            <a class="card-link" href={`/courses/${slug}/holes/${hole.hole}`}>
                                <span class="hole-no num">Hole {hole.hole}</span>
                                <img src={hole.layout} alt="" loading="lazy" />
                            </a>
                        </li>
                    ))}
                </ul>
            </section>
        )}

        {relatedEvents.length > 0 && (
            <section class="section">
                <div class="section-head">
                    <h2>Events here</h2>
                    <span class="meta">
                        {relatedEvents.length} {relatedEvents.length === 1 ? 'event' : 'events'}
                    </span>
                </div>
                <ul role="list" class="related-events">
                    {relatedEvents.map((event) => (
                        <li class="related-event card">
                            <a href={linkToEvent(event)}>{event.name}</a>
                            <span class="meta">{event.date}</span>
                        </li>
                    ))}
                </ul>
            </section>
        )}
    </main>
</Layout>

<style>
    .course-hero {
        margin-bottom: 1.75rem;
    }

    .course-hero img {
        aspect-ratio: 16 / 9;
        max-height: 380px;
    }

    .description {
        color: var(--text-muted);
    }

    .inline-figure {
        margin: 1.5rem 0;
    }

    .inline-figure img {
        aspect-ratio: 16 / 9;
        max-height: 340px;
    }

    /* Layout diagrams are line art on white — no dark gradient over them. */
    .layout-figure,
    .hole img {
        background: var(--ink-100);
    }

    .layout-figure::after {
        display: none;
    }

    .layout-figure img {
        filter: none;
    }

    .holes-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.6rem;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 140px), 1fr));
    }

    .holes-grid.wide {
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr));
    }

    .hole .card-link {
        padding: 0.5rem;
    }

    .hole-no {
        display: block;
        padding: 0.15rem 0 0.4rem;
        text-align: center;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--gold-400);
    }

    .hole img {
        width: 100%;
        height: 190px;
        object-fit: contain;
        border-radius: 0.4rem;
    }

    .related-events {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.5rem;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    }

    .related-event {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        padding: 0.65rem 0.9rem;
        font-size: 14px;
    }

    .related-event a {
        color: var(--ink-100);
        font-weight: 600;
    }

    .related-event a:hover {
        color: var(--violet-200);
    }
</style>
