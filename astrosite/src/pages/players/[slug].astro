---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '@hector/ui/components/Breadcrumb.astro';
import PageHeader from '@hector/ui/components/PageHeader.astro';
import AppearanceCard from '../../components/players/AppearanceCard.astro';
import HandicapHistoryChart from '../../components/players/HandicapHistoryChart.astro';
import { type Player } from '@hector/schemas/src/players.ts';
import { type HandicapHistoryEntry } from '@hector/schemas/src/handicaps.ts';
import { getEventsOfPlayer, getAllPlayerIds, getPlayerById, getPlayerName, getPlayerHandicapHistoryById, getPlayerHandicapById } from '../../code/players';


export function getStaticPaths() {
    return getAllPlayerIds().map((id) => {
        return { params: { slug: id } };
    });
}

const { slug } = Astro.params;
let player: Player|undefined = getPlayerById(slug);
if (!player) {
    Astro.response.status = 404;
}
player = player!

const relatedEvents = getEventsOfPlayer(player.id);

const playerHandicap = getPlayerHandicapById(player.id);
const handicapHistory: Array<HandicapHistoryEntry>|null = playerHandicap ? getPlayerHandicapHistoryById(player.id) : null;

const biography = player.biography && player.biography.length > 0 ? player.biography : null;

---

<Layout title={getPlayerName(player)} section="players">
    <main class="page">
        <div class="breadcrumbs">
            <Breadcrumb title="Home" href="/" />
            <Breadcrumb title="Players" href="/players" />
        </div>

        <div class="player-head">
            {player.image && (
                <div class="portrait">
                    <img src={player.image} alt={getPlayerName(player)} />
                </div>
            )}
            <PageHeader
                title={getPlayerName(player)}
                eyebrow="Player"
                meta={[
                    playerHandicap !== undefined ? `HCP ${Number(playerHandicap).toFixed(1)}` : undefined,
                    relatedEvents.length > 0
                        ? `${relatedEvents.length} ${relatedEvents.length === 1 ? 'appearance' : 'appearances'}`
                        : undefined,
                ]}
            />
        </div>

        {biography && (
            <div class="biography">
                {biography.map((paragraph) => (
                    <p>{paragraph}</p>
                ))}
            </div>
        )}

        {handicapHistory && (
            <section class="section">
                <div class="section-head">
                    <h2>Handicap</h2>
                    {playerHandicap !== undefined && (
                        <span class="pill num">{Number(playerHandicap).toFixed(1)}</span>
                    )}
                </div>
                <HandicapHistoryChart history={handicapHistory} current={playerHandicap} />
            </section>
        )}

        {relatedEvents.length > 0 && (
            <section class="section">
                <div class="section-head">
                    <h2>Appearances</h2>
                    <span class="meta">{relatedEvents.length} starts</span>
                </div>
                <ul role="list" class="appearances">
                    {relatedEvents.map((event) => (
                        <AppearanceCard player={player} event={event} />
                    ))}
                </ul>
            </section>
        )}
    </main>
</Layout>

<style>
    .player-head {
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }

    .portrait {
        flex: 0 0 auto;
        width: 96px;
        height: 96px;
        border-radius: 9999px;
        overflow: hidden;
        border: 1px solid var(--line-strong);
        background: var(--surface-raised);
    }

    .portrait img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .biography {
        color: var(--text-muted);
    }

    .appearances {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.5rem;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    }

    @media (max-width: 520px) {
        .player-head {
            gap: 1rem;
        }

        .portrait {
            width: 68px;
            height: 68px;
        }
    }
</style>
