---
import Layout from '../layouts/Layout.astro'
import Card from '@hector/ui/components/Card.astro'
import HectorMark from '@hector/ui/components/HectorMark.astro'
import EventCard from '../components/events/EventCard.astro'
import MatchplayEventCard from '../components/events/MatchplayEventCard.astro'
import { getAllEventsGroupedByChronology, linkToEvent } from '../code/events'
import { EventFormat } from '../schemas/events'
import { formatEventDates } from '../code/dates'

const { ongoing, upcoming } = getAllEventsGroupedByChronology()
const featured = [...ongoing, ...upcoming].slice(0, 3)
const featuredIsLive = ongoing.length > 0
---

<Layout title="Hector.golf">
	<main class="page">
		<section class="hero">
			<div class="hero-copy">
				<span class="eyebrow">Hector Trophée</span>
				<h1>Amateur golf,<br />taken far too seriously.</h1>
				<p class="lede">
					Six rounds, two trophies, one Hector. Follow the events, the field and the courses where
					the world's best amateur golfers settle it.
				</p>
				<div class="hero-actions">
					<a class="btn btn-primary" href="/events">Browse events</a>
					<a class="btn btn-ghost" href="https://app.hector.golf">Live leaderboards →</a>
				</div>
			</div>
			<div class="hero-mark" aria-hidden="true">
				<HectorMark size={220} />
			</div>
		</section>

		{
			featured.length > 0 && (
				<section class="section">
					<div class="section-head">
						<h2>{featuredIsLive ? 'Happening now' : 'Coming up'}</h2>
						{featuredIsLive ? (
							<span class="pill pill-live">
								<span class="live-dot" aria-hidden="true" />
								Live
							</span>
						) : (
							<a class="more" href="/events">
								All events →
							</a>
						)}
					</div>
					<ul role="list" class="grid grid-wide">
						{featured.map((event) => {
							const live = ongoing.includes(event)
							const status = live ? 'Live' : 'Upcoming'
							const props = {
								title: event.name,
								location: event.location,
								date: formatEventDates(event),
								href: linkToEvent(event),
								status,
								live,
							}
							return event.format === EventFormat.Matchplay ? (
								<MatchplayEventCard {...props} />
							) : (
								<EventCard {...props} />
							)
						})}
					</ul>
				</section>
			)
		}

		<section class="section">
			<div class="section-head">
				<h2>Explore</h2>
			</div>
			<ul role="list" class="grid">
				<Card
					href="/events"
					title="Events"
					body="Follow as the world's best amateur golfers face off in Hector events worldwide."
				/>
				<Card href="/players" title="Players" body="Get to know the world's best amateur golfers." />
				<Card href="/courses" title="Courses" body="See where the world's best amateur golfers play." />
				<Card
					href="/golfreport"
					title="Golf Report"
					body="Read past issues of golf's leading magazine."
				/>
			</ul>
		</section>
	</main>
</Layout>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		gap: 2rem;
		padding: 3.5rem 0 1rem;
		overflow: hidden;
	}

	.hero-copy {
		position: relative;
		z-index: 1;
		flex: 1 1 auto;
	}

	.hero .eyebrow {
		display: block;
		margin-bottom: 0.85rem;
	}

	.hero h1 {
		font-size: clamp(2.3rem, 7vw, 4rem);
		line-height: 1.05;
	}

	.hero .lede {
		margin-top: 1.1rem;
		font-size: 1.05rem;
		color: var(--text-muted);
		max-width: 44ch;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.6rem;
	}

	/* Oversized falcon watermark, echoing the app's tournament screen. */
	.hero-mark {
		flex: 0 0 auto;
		color: var(--gold-400);
		opacity: 0.14;
		pointer-events: none;
	}

	.more {
		font-size: 13px;
		font-weight: 600;
	}

	@media (max-width: 720px) {
		.hero {
			padding-top: 2.5rem;
		}

		.hero-mark {
			position: absolute;
			right: -2.5rem;
			top: 1rem;
			opacity: 0.08;
		}
	}
</style>
