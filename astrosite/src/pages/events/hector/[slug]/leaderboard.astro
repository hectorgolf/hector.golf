---
import Layout from '../../../../layouts/Layout.astro'
import Breadcrumb from '@hector/ui/components/Breadcrumb.astro'
import RoundsList from '../../../../components/events/RoundsList.astro'
import LeaderboardTable from '../../../../components/events/LeaderboardTable.astro'
import PageHeader from '@hector/ui/components/PageHeader.astro'

import { type Player } from '@hector/schemas/src/players.ts'
import { getAllPlayers, getPlayerName, getPlayerAliases } from '../../../../code/players'

import { type HectorEvent } from '@hector/schemas/src/events.ts'
import { getAllEventIds, getEventById, eventHasEnded, eventHasStarted } from '../../../../code/events'

import { getLeaderboardsByEventId, getEventsWithLeaderboards } from '../../../../code/leaderboards/leaderboards'
import { appEventIdFromLeaderboardUrl, isAppHectorGolfLeaderboard } from '../../../../code/leaderboards/sources'
import LiveLeaderboard from '../../../../components/events/LiveLeaderboard.astro'
import { formatEventDates, parseIsoDate, addDays } from '@hector/schemas/src/dates.ts'


export function getStaticPaths() {
    const eventsWithLeaderboards = getEventsWithLeaderboards()
    // An event polled from app.hector.golf gets a page as soon as it is configured,
    // before any snapshot has been published — otherwise the live board would have
    // nowhere to appear until the first scheduled update, hours into play.
    return getAllEventIds(e => e.format === 'hector'
        && (eventsWithLeaderboards.includes(e.id) || isAppHectorGolfLeaderboard((e as HectorEvent).leaderboardSheet))
    ).map((id) => {
        return { params: { slug: id } }
    })
}

const { slug } = Astro.params
let event: HectorEvent|undefined = slug ? (getEventById(slug) as HectorEvent) : undefined
if (!event) {
    Astro.response.status = 404
}
event = event!

const year = parseIsoDate(event.timing.start).getFullYear();
const resultsMissingLabel = (year && year < new Date().getFullYear()) ? 'Results missing' : 'Results pending';

const playersByName: {[name:string]: Player} = {}
getAllPlayers().forEach((player) => {
    playersByName[getPlayerName(player)] = player
    playersByName[getPlayerName({ ...player, privacy: undefined })] = player
    getPlayerAliases(player, true).forEach(alias => { playersByName[alias] = player })
})

const leaderboards = getLeaderboardsByEventId(event.id)
const hectorLeaderboard = leaderboards.hector
const hectorLeaderboardScoringDirection = leaderboards.scoring?.hector || 'ascending'  // For Hector, default to ascending (lower score is better)
const victorLeaderboard = leaderboards.victor
const victorLeaderboardScoringDirection = leaderboards.scoring?.victor || 'descending'  // For Victor, default to descending (higher score is better)
const updatedAt = leaderboards.updatedAt ? new Date(leaderboards.updatedAt) : undefined

const allThrough = Math.min(...(hectorLeaderboard || [])
    .map(entry => entry.through)
    .map(through => parseInt(through.split('/')[0] || '0')))

// Only app.hector.golf standings can be polled from a browser: the Google Sheets
// events have no endpoint behind the leaderboard proxy.
const liveEventId = appEventIdFromLeaderboardUrl(event.leaderboardSheet)
const leaderboardProxy = (import.meta.env.PUBLIC_LEADERBOARD_PROXY_URL || '').trim()
const live = !!liveEventId && !!leaderboardProxy
// Stop polling a day after the last round; a finished event also stops itself as
// soon as the payload says it is final.
const stopPollingAfter = `${addDays(event.timing.end, 1)}T00:00:00Z`

// Show the boards even when empty for a live event, so there are tables to update.
const showHector = !!hectorLeaderboard || live
const showVictor = !!victorLeaderboard || live

// What an empty live board says before the first standings arrive. The build can
// only reason from the event's dates; the island replaces this with the
// tournament's own answer on its first successful read.
const liveEmptyMessage = !eventHasStarted(event)
    ? 'Live standings begin when play starts'
    : eventHasEnded(event)
      ? resultsMissingLabel
      : 'Waiting for the first standings of the round'


---
<Layout title={`${event.name} leaderboard`} section="events">
    <main class="page">
        <div class="breadcrumbs">
            <Breadcrumb title="Home" href="/" />
            <Breadcrumb title="Events" href="/events" />
            <Breadcrumb title="Hectors" href="/events/hector" />
            <Breadcrumb title={event.name} href={`/events/hector/${event.id}`} />
        </div>
        <PageHeader
            title={event.name}
            eyebrow="Leaderboard"
            meta={[event.location, formatEventDates(event)]}
        />

        {showHector && (
            <section class="section">
                <div class="section-head">
                    <h2>Hector</h2>
                    <span class="meta">Pairs</span>
                </div>
                {(hectorLeaderboard?.length ?? 0) === 0 && !live ? (
                    <p class="pending meta">{resultsMissingLabel}</p>
                ) : (
                    <LeaderboardTable
                        entries={hectorLeaderboard || []}
                        competitorLabel="Team"
                        ascending={hectorLeaderboardScoringDirection === 'ascending'}
                        competition="hector"
                        live={live}
                        emptyMessage={liveEmptyMessage}
                    />
                )}
            </section>
        )}

        {showVictor && (
            <section class="section">
                <div class="section-head">
                    <h2>Victor</h2>
                    <span class="meta">Individual</span>
                </div>
                {(victorLeaderboard?.length ?? 0) === 0 && !live ? (
                    <p class="pending meta">{resultsMissingLabel}</p>
                ) : (
                    <LeaderboardTable
                        entries={victorLeaderboard || []}
                        competitorLabel="Player"
                        ascending={victorLeaderboardScoringDirection === 'ascending'}
                        competition="victor"
                        live={live}
                        emptyMessage={liveEmptyMessage}
                    />
                )}
            </section>
        )}

        <RoundsList event={event} allThrough={allThrough} />

        {live ? (
            <LiveLeaderboard
                eventId={liveEventId!}
                endpoint={leaderboardProxy}
                stopAfter={stopPollingAfter}
            />
        ) : (
            <>
                {updatedAt && (
                    <p class="updated-at meta">Updated {updatedAt.toISOString()}</p>
                )}

                <script is:inline>
                    // Automatically refresh the page every 5 minutes so a fresh
                    // deploy's standings are picked up without a manual reload.
                    setInterval(() => {
                        location.href = location.href.split('?')[0] + '?' + Date.now();
                    }, 5 * 60 * 1000);
                </script>
            </>
        )}
    </main>
</Layout>

<style>
    .pending {
        color: var(--text-faint);
    }

    .updated-at {
        margin-top: 3rem;
        color: var(--text-faint);
    }
</style>
