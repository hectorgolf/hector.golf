---
import markdownit from 'markdown-it';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '@hector/ui/components/Breadcrumb.astro';
import PageHeader from '@hector/ui/components/PageHeader.astro';
import CompetitionMark from '@hector/ui/components/CompetitionMark.astro';
import SingleEliminationBracketV2 from '../../../components/events/SingleEliminationBracketV2.astro';
import { type MatchplayEvent } from '../../../schemas/events';
import { type Player } from '../../../schemas/players';
import { getAllEventIds, getEventById } from '../../../code/events';
import { getPlayerName, getPlayerById } from '../../../code/players';
import { formatEventDates } from '../../../code/dates';


export function getStaticPaths() {
    return getAllEventIds(e => e.format === 'matchplay').map(id => {
        return { params: { slug: id } };
    });
}

const { slug } = Astro.params;
let event: MatchplayEvent|undefined = slug ? (getEventById(slug) as MatchplayEvent) : undefined;
if (!event) {
    Astro.response.status = 404;
}
event = event!

const field: Array<Player> = event.participants
    .map(id => getPlayerById(id))
    .filter(p => !!p)
    .sort((p1, p2) => p1!.name.last.localeCompare(p2!.name.last)) as Array<Player> || []

const md = markdownit()
const eventDescriptionHtml = event.description ? md.render(event.description) : '';
---

<Layout title={event.name} section="events">
    <main class="page">
        <div class="breadcrumbs">
            <Breadcrumb title="Home" href="/" />
            <Breadcrumb title="Events" href="/events" />
            <Breadcrumb title="Matchplay" href="/events/matchplay" />
        </div>
        <PageHeader title={event.name} eyebrow="Matchplay" meta={[event.location, formatEventDates(event)]} />

        {event.hero_image && (
            <figure class="hero-figure event-hero">
                <img src={event.hero_image} alt="" />
                <figcaption>{event.location}</figcaption>
            </figure>
        )}

        <div class="description" set:html={eventDescriptionHtml} />

        {event.results?.winners?.matchplay && getPlayerById(event.results.winners.matchplay) && (
            <section class="section">
                <div class="section-head">
                    <h2>Champion</h2>
                </div>
                {[getPlayerById(event.results!.winners?.matchplay)]
                    .filter((p) => !!p)
                    .map((player) => (
                        <div class="champion card" data-competition="matchplay">
                            <CompetitionMark competition="matchplay" size={30} class="trophy" />
                            <div>
                                <span class="eyebrow">Matchplay</span>
                                <p class="names">
                                    <a href={`/players/${player!.id}`}>{getPlayerName(player!)}</a>
                                </p>
                            </div>
                        </div>
                    ))}
            </section>
        )}

        {event.participants && event.participants.length > 0 && (
            <section class="section">
                <div class="section-head">
                    <h2>Field</h2>
                    <span class="meta">{field.length} players</span>
                </div>
                <ul role="list" class="field">
                    {field.map((player) => (
                        <li class="card">
                            <a href={`/players/${player!.id}`}>{getPlayerName(player!)}</a>
                        </li>
                    ))}
                </ul>
            </section>
        )}

        {event.results?.bracket && (
            <section class="section">
                <div class="section-head">
                    <h2>Tournament bracket</h2>
                    <span class="meta">Single elimination</span>
                </div>
                <SingleEliminationBracketV2 event={event} />
            </section>
        )}
    </main>
</Layout>

<style>
    .event-hero {
        margin-bottom: 1.75rem;
    }

    .event-hero img {
        max-height: 320px;
    }

    .description {
        color: var(--text-muted);
    }

    .champion {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        padding: 1rem 1.1rem;
        max-width: 320px;
    }

    .champion .trophy {
        flex-shrink: 0;
    }

    /* Eyebrow and hover follow the trophy, so the card reads as one competition. */
    .champion[data-competition='matchplay'] {
        --champion-tint: var(--matchplay);
        --champion-tint-soft: var(--matchplay-soft);
    }

    .champion .eyebrow {
        display: block;
        margin-bottom: 0.2rem;
        color: var(--champion-tint);
    }

    .champion .names {
        margin: 0;
        font-family: var(--font-serif);
        font-size: 1.1rem;
        font-weight: 600;
    }

    .champion .names a {
        color: var(--ink-50);
    }

    .champion .names a:hover {
        color: var(--champion-tint-soft);
    }

    .field {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.5rem;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr));
    }

    .field li {
        padding: 0.55rem 0.85rem;
        font-size: 14px;
    }

    .field a {
        color: var(--ink-100);
        font-weight: 500;
    }

    .field a:hover {
        color: var(--violet-200);
    }
</style>
