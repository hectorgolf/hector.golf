---
interface Props {
	name: string
	href: string
	location: string
	image?: string
}

const { name, image, href, location } = Astro.props
---

<li class="course-card">
	<a href={href} class="card-link">
		{
			image && (
				<span class="thumb">
					<img src={image} alt="" loading="lazy" />
				</span>
			)
		}
		<span class="body">
			<span class="title">{name}</span>
			<span class="location">{location}</span>
		</span>
	</a>
</li>

<style>
	.course-card {
		list-style: none;
		display: flex;
	}

	.card-link {
		display: flex;
		flex-direction: column;
		width: 100%;
	}

	.thumb {
		display: block;
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: brightness(0.88) saturate(0.9);
		transition: transform 0.4s var(--ease);
	}

	.card-link:hover .thumb img {
		transform: scale(1.03);
	}

	.thumb::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, var(--ink-900), rgb(19 18 21 / 0.05) 70%);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 0.9rem 1.1rem 1.05rem;
	}

	.location {
		font-size: 13px;
		color: var(--text-dim);
	}

	.title {
		font-family: var(--font-serif);
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.25;
		color: var(--ink-50);
	}
</style>
