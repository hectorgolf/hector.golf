---
interface Props {
	year: number
}

const { year } = Astro.props
const label = `Hector winner ${year}`
---

<span class="badge" title={label}>
	<img src="/images/trophy/hector-gold.svg" alt={label} />
	<span class="year num">{year}</span>
</span>

<style>
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0.1rem 0.35rem 0.1rem 0.25rem;
		border-radius: 9999px;
		background: rgb(69 26 3 / 0.5);
	}

	.badge img {
		width: 9px;
		height: 14px;
	}

	.year {
		font-size: 10px;
		font-weight: 600;
		color: var(--gold-300);
	}
</style>
