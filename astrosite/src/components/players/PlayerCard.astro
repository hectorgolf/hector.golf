---
import { getPlayerName } from '../../code/players'
import WinBadge from './icons/WinBadge.astro'

interface Props {
	id: string
	name: { first: string; last: string }
	image?: string
	href: string
	starts: number
	hectorWins: number[]
	victorWins: number[]
	matchplayWins: number[]
	handicap: number | undefined
}

const { id, image, href, starts, hectorWins, victorWins, matchplayWins, handicap } = Astro.props

const fullname = getPlayerName(id)

const wins = hectorWins.length + victorWins.length + matchplayWins.length
---

<li class="player-card">
	<a href={href} class="card-link">
		<span class="portrait">
			{
				image ? (
					<img src={image} alt="" loading="lazy" />
				) : (
					<span class="initials" aria-hidden="true">
						{fullname
							.split(/\s+/)
							.map((part) => part[0])
							.slice(0, 2)
							.join('')}
					</span>
				)
			}
		</span>
		<span class="body">
			<span class="top">
				<span class="name">{fullname}</span>
				{handicap !== undefined && <span class="pill num">HCP {Number(handicap).toFixed(1)}</span>}
			</span>
			<span class="record">
				<span class="stat">
					<span class="score">{starts}</span>
					<span class="stat-label">{starts === 1 ? 'start' : 'starts'}</span>
				</span>
				<span class="stat">
					<span class="score" data-won={wins > 0 ? 'true' : undefined}>{wins}</span>
					<span class="stat-label">{wins === 1 ? 'win' : 'wins'}</span>
				</span>
			</span>
			{
				wins > 0 && (
					<span class="trophies">
						{hectorWins.map((year) => (
							<WinBadge competition="hector" year={year} />
						))}
						{victorWins.map((year) => (
							<WinBadge competition="victor" year={year} />
						))}
						{matchplayWins.map((year) => (
							<WinBadge competition="matchplay" year={year} />
						))}
					</span>
				)
			}
		</span>
	</a>
</li>

<style>
	.player-card {
		list-style: none;
		display: flex;
	}

	.card-link {
		display: flex;
		gap: 0.9rem;
		align-items: flex-start;
		width: 100%;
		padding: 0.9rem 1rem;
	}

	.portrait {
		flex: 0 0 auto;
		width: 52px;
		height: 52px;
		border-radius: 9999px;
		overflow: hidden;
		background: var(--surface-raised);
		border: 1px solid var(--line-strong);
		display: grid;
		place-items: center;
	}

	.portrait img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.initials {
		font-family: var(--font-score);
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--text-faint);
	}

	.body {
		display: flex;
		flex-direction: column;
		min-width: 0;
		flex: 1;
	}

	.top {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.name {
		font-weight: 600;
		font-size: 15px;
		color: var(--ink-50);
	}

	.top .pill {
		font-size: 11px;
		letter-spacing: 0.04em;
	}

	.record {
		display: flex;
		gap: 1.1rem;
		margin-top: 0.4rem;
	}

	.stat {
		display: inline-flex;
		align-items: baseline;
		gap: 0.3rem;
	}

	.stat .score {
		font-size: 1.05rem;
		color: var(--ink-100);
	}

	.stat .score[data-won] {
		color: var(--gold-400);
	}

	.stat-label {
		font-size: 11px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--text-faint);
	}

	.trophies {
		display: flex;
		flex-wrap: wrap;
		gap: 0.15rem;
		margin-top: 0.5rem;
	}
</style>
