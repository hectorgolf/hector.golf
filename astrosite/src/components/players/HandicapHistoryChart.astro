---
import type { HandicapHistoryEntry } from '@hector/schemas/src/handicaps.ts';


interface Props {
	history: Array<HandicapHistoryEntry>;
	current: number|undefined;
}

const { history, current } = Astro.props;

const fullHistory = history.map(entry => ({ x: entry.date, y: entry.handicap }))
const lastTwenty = fullHistory.slice(-20)

---

<div class="handicap-history-chart-container">
	<canvas id="handicap-history-chart-canvas"
	        data-handicap-history={JSON.stringify(lastTwenty)}
			data-current-handicap={current}></canvas>
</div>
<script src="./HandicapHistoryChart.ts"></script>

<style>
	.handicap-history-chart-container {
		padding: 0.9rem 1rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--line);
		background: var(--surface);
	}

	#handicap-history-chart-canvas {
		width: 100%;
		aspect-ratio: auto 900/500;
	}
</style>
