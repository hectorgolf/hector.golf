---
interface Props {
	title: string
	image: string
	href: string
}

const { title, image, href } = Astro.props
---

<li class="issue">
	<a href={href} class="card-link" title={title}>
		<img src={image} alt={title} loading="lazy" />
		<span class="caption meta">{title}</span>
	</a>
</li>

<style>
	.issue {
		list-style: none;
		display: flex;
	}

	.card-link {
		width: 100%;
		padding: 0.6rem;
	}

	img {
		width: 100%;
		border-radius: 0.5rem;
		border: 1px solid var(--line);
		transition: filter 0.25s var(--ease);
		filter: brightness(0.94);
	}

	.card-link:hover img {
		filter: brightness(1.04);
	}

	.caption {
		display: block;
		padding: 0.6rem 0.35rem 0.25rem;
		text-align: center;
		letter-spacing: 0.14em;
	}
</style>
