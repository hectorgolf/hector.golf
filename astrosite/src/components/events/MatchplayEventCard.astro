---
import CompetitionMark from '@hector/ui/components/CompetitionMark.astro'

interface Props {
	title: string
	href: string
	date: string
	location: string
	image?: string
	/** Shown as a pill in the card's top-right corner, e.g. "Live" or "Final". */
	status?: string
	live?: boolean
}

const { title, image, href, date, location, status, live = false } = Astro.props
---

<li class="event-card">
	<a href={href} class="card-link">
		{
			image && (
				<span class="thumb">
					<img src={image} alt="" loading="lazy" />
				</span>
			)
		}
		<span class="body">
			<span class="top">
				<span class="format" data-competition="matchplay" aria-label="Matchplay event">
					<CompetitionMark competition="matchplay" size={13} />
					Matchplay
				</span>
				{
					status && (
						<span class={live ? 'pill pill-live' : 'pill'}>
							{live && <span class="live-dot" aria-hidden="true" />}
							{status}
						</span>
					)
				}
			</span>
			<span class="title">{title}</span>
			<span class="location">{location}</span>
			<span class="date meta">{date}</span>
		</span>
	</a>
</li>

<style>
	.event-card {
		list-style: none;
		display: flex;
	}

	.card-link {
		display: flex;
		flex-direction: column;
		width: 100%;
	}

	.thumb {
		display: block;
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: brightness(0.88) saturate(0.9);
		transition: transform 0.4s var(--ease);
	}

	.card-link:hover .thumb img {
		transform: scale(1.03);
	}

	.thumb::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, var(--ink-900), rgb(19 18 21 / 0.05) 70%);
	}

	.body {
		display: flex;
		flex-direction: column;
		padding: 0.95rem 1.1rem 1.1rem;
	}

	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.45rem;
	}

	/* Matchplay reads violet where the Hector events read gold. */
	.format {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 10px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.2em;
	}

	.format[data-competition='matchplay'] {
		color: var(--matchplay);
	}

	.title {
		font-family: var(--font-serif);
		font-size: 1.15rem;
		font-weight: 600;
		line-height: 1.2;
		color: var(--ink-50);
	}

	.location {
		margin-top: 0.3rem;
		font-size: 13px;
		color: var(--text-muted);
	}

	.date {
		margin-top: 0.55rem;
	}
</style>
