---
import { getPlayerHandicapById, getPlayerName } from '../../code/players';
import { type MatchplayEvent } from '../../schemas/events';

interface Props {
	event: MatchplayEvent;
}

const { event } = Astro.props;
const tournament = event as MatchplayEvent;

const rounds = (tournament.results?.bracket || [])

const isPlayerId = (value: string): boolean => {
    return !!(tournament.participants || []).includes(value)
}

const connectors: Array<Array<string>> = []; // array of tuples (e.g. ["match-M01", "match-M09"]) representing connectors to be drawn
rounds.forEach(round => {
    round.matches.forEach((match) => {
        if (match.leftSource) connectors.push([`match-${match.leftSource}`, `match-${match.id}`]);
        if (match.rightSource) connectors.push([`match-${match.rightSource}`, `match-${match.id}`]);
    })
})

---
<div class="tournament-bracket">
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leader-line/1.0.7/leader-line.min.js" integrity="sha512-0dNdzMjpT6pJdFGF1DwybFCfm3K/lzHhxaMXC/92J9/DZujHlqYFqmhTOAoD0o+LkeEsVK2ar/ESs7/Q2B6wJg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    {(rounds.map(round => {
        const roundClasses = `round round-${round.round}`;
        const content = (
            <div class={roundClasses}>
                <div class="round-outer-spacer">&nbsp;</div>
                {(round.matches.map((match, index) => {
                    const createPlayerLinkElement = (playerId: string): any => {
                        const playerUrl = `/players/${playerId}`;
                        return (<a href={playerUrl}>{getPlayerName(playerId)}</a>)
                    }
                    const matchLabelClasses = `match-score ${match.score ? (match.winner ? 'finished' : 'scheduled') : 'pending'}`
                    const matchLeftLabel = (match.left && isPlayerId(match.left)) ? createPlayerLinkElement(match.left) : (match.leftSource ? `Winner of ${match.leftSource}` : '(blank)');
                    const matchRightLabel = (match.right && isPlayerId(match.right)) ? createPlayerLinkElement(match.right) : (match.rightSource ? `Winner of ${match.rightSource}` : '(blank)');
                    const stateClassLeft = (match.left && isPlayerId(match.left)) ? (match.left === match.winner ? 'winner' : (match.score ? 'loser' : 'pending')) : `undetermined`;
                    const stateClassRight = (match.right && isPlayerId(match.right)) ? (match.right === match.winner ? 'winner' : (match.score ? 'loser' : 'pending')) : `undetermined`;
                    const hcpLeft = (match.left && isPlayerId(match.left)) ? getPlayerHandicapById(match.left) : 0;
                    const hcpRight = (match.right && isPlayerId(match.right)) ? getPlayerHandicapById(match.right) : 0;
                    const gameTopClasses = `game-top ${stateClassLeft}`
                    const gameBottomClasses = `game-bottom ${stateClassRight}`
                    const matchIsReadyToPlay = stateClassLeft === 'pending' && stateClassRight === 'pending';
                    const gameClasses = `game ${matchIsReadyToPlay ? 'ready-to-play' : ''}`.trim();
                    return (
                        <>
                            {index > 0 && (<div class="round-inner-spacer">&nbsp;</div>)}
                            <div class={gameClasses} id={`match-${match.id}`}>
                                <div class={gameTopClasses}>
                                    <span class="hcp">{!match.score ? `(${hcpLeft})` : ''}</span>
                                    <span class="player">{matchLeftLabel}</span>
                                </div>
                                <div class="match-inner-spacer">
                                    <span class={matchLabelClasses}>{match.score ? match.score : ''}</span>
                                    <span class="match-id">{match.id}</span>
                                </div>
                                <div class={gameBottomClasses}>
                                    <span class="hcp">{!match.score ? `(${hcpRight})` : ''}</span>
                                    <span class="player">{matchRightLabel}</span>
                                </div>
                            </div>
                        </>
                    )
                }))}
                <div class="round-outer-spacer">&nbsp;</div>
            </div>
        )
        return content
    }))}
</div>

<script is:inline define:vars={{ connectorsFromFrontMatter: connectors }}>
    /*
     * Draw the connectors between matches.
     *
     * LeaderLine paints absolutely positioned SVGs in document coordinates, measured
     * once when the line is constructed, and does not follow the boxes afterwards. So
     * anything that reflows the page after we draw — web fonts swapping in, the hero
     * image getting its intrinsic height, the bracket being scrolled sideways on a
     * narrow screen — leaves every line hanging where the boxes used to be. Keep the
     * instances around and re-measure whenever the layout can have moved.
     */
    ;(function () {
        // Kept in step with --line-bright; LeaderLine needs a literal, not a var().
        var BRACKET_LINE_COLOR = '#3c3b44'
        var lines = []

        function draw() {
            connectorsFromFrontMatter.forEach(function (tuple) {
                var start = document.getElementById(tuple[0])
                var end = document.getElementById(tuple[1])
                if (!start || !end) return
                lines.push(
                    new LeaderLine(start, end, {
                        path: 'grid',
                        color: BRACKET_LINE_COLOR,
                        size: 1,
                        startSocket: 'right',
                        endSocket: 'left',
                        startPlug: 'behind',
                        endPlug: 'behind',
                    })
                )
            })
        }

        var lastOrigin = null

        /*
         * `force` skips the did-anything-move check. Repositioning appends absolutely
         * positioned SVGs that can themselves extend the document, so an unguarded
         * ResizeObserver feeds back into itself; comparing the bracket's own origin
         * first makes those callbacks free once things have settled.
         */
        function reposition(force) {
            var bracket = document.querySelector('.tournament-bracket')
            if (bracket && force !== true) {
                var box = bracket.getBoundingClientRect()
                var origin =
                    Math.round(box.top + window.scrollY) +
                    ':' +
                    Math.round(box.left + window.scrollX - bracket.scrollLeft)
                if (origin === lastOrigin) return
                lastOrigin = origin
            }
            lines.forEach(function (line) {
                line.position()
            })
        }

        function onSettled() {
            draw()

            // Late-arriving fonts and images both move the bracket down the page.
            if (document.fonts && document.fonts.ready) document.fonts.ready.then(reposition)
            addEventListener('load', reposition)

            // Anything else that reflows the content above the bracket.
            if (window.ResizeObserver) new ResizeObserver(reposition).observe(document.body)

            var resizeTimer
            addEventListener('resize', function () {
                clearTimeout(resizeTimer)
                resizeTimer = setTimeout(function () {
                    reposition(true)
                }, 100)
            })

            // The bracket scrolls horizontally when it outgrows the viewport.
            var bracket = document.querySelector('.tournament-bracket')
            if (bracket) {
                var queued = false
                bracket.addEventListener(
                    'scroll',
                    function () {
                        if (queued) return
                        queued = true
                        requestAnimationFrame(function () {
                            queued = false
                            reposition()
                        })
                    },
                    { passive: true }
                )
            }
        }

        if (document.readyState === 'loading') {
            addEventListener('DOMContentLoaded', onSettled)
        } else {
            onSettled()
        }
    })()
</script>

<style>
    .tournament-bracket {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        justify-content: flex-start;
        align-items: stretch;  /* make "rounds" stretch to full height of this container */
        font-size: 0.9em;
        row-gap: 0; /* we don't want any space between rows (although there's only one row so not strictly necessary) */
        column-gap: 60px;
        padding-right: 10px;
        /*
         * 4 rounds (200px each) plus 3 gaps (60px each) plus 10px of right padding.
         *
         * This is wider than the page column, so on a narrow screen the document
         * scrolls sideways as a whole rather than the bracket scrolling inside itself.
         * That keeps the connectors attached to their boxes — LeaderLine paints them
         * into document.body, so they are not clipped by this element's overflow and
         * would spill across the page if only the bracket scrolled.
         */
        width: 990px;
        height: 1425px;
    }

    .tournament-bracket {
        overflow-x: auto;
        white-space: nowrap;
    }

    .tournament-bracket .round {
        display:flex;
        flex-direction: column;
        flex-wrap: nowrap;
        justify-content: center;
        align-items: stretch; /* make the items stretch to the full width of the round column */
        width: 200px;
        list-style: none;
        padding: 0;
        white-space: nowrap;
    }

    .tournament-bracket .match-inner-spacer {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }

    .tournament-bracket .match-inner-spacer .match-id {
        font-family: var(--font-num);
        color: var(--text-faint);
        font-size: 0.75em;
        padding-right: 5px;
    }

    .tournament-bracket .round.round-1 .round-inner-spacer { height: 90px; }
    .tournament-bracket .round.round-2 .round-inner-spacer { height: 270px; }
    .tournament-bracket .round.round-3 .round-inner-spacer { height: 630px; }
    .tournament-bracket .round.round-4 .round-inner-spacer { height: 0px; }

    .tournament-bracket .round.round-1 .round-outer-spacer { height: 0px; }
    .tournament-bracket .round.round-2 .round-outer-spacer { height: 90px; }
    .tournament-bracket .round.round-3 .round-outer-spacer { height: 270px; }
    .tournament-bracket .round.round-4 .round-outer-spacer { height: 630px; }

    .tournament-bracket .round .game {
        display: flex;
        flex-direction: column;
        flex-wrap: nowrap;
        justify-content: center;
        align-items: flex-start;
        min-width: 150px;
        height: 88px;
        /* Brighter than a card's edge: here the border is structure, not just trim. */
        border: 1px solid var(--line-bright);
        border-radius: var(--radius-sm);
        background-color: var(--surface);
        font-size: 13px;
    }

    /* The next match to be played gets the violet rail used elsewhere for "up next". */
    .tournament-bracket .round .game.ready-to-play {
        border-color: var(--violet-800);
        box-shadow: inset 3px 0 0 var(--violet-500);
    }
    .tournament-bracket .round .game div {
        margin-left: 4px;
        margin-right: 4px;
        margin-top: 1px;
        margin-bottom: 1px;
    }

    .tournament-bracket .game a {
        text-decoration: none;
    }
    .tournament-bracket .game .match-score {
        font-family: var(--font-score);
        font-weight: 700;
    }
    .tournament-bracket .game .match-score.finished {
        color: var(--matchplay);
    }
    .tournament-bracket .game .match-score.scheduled {
        font-family: var(--font-num);
        font-weight: 400;
        color: var(--text-faint);
        font-size: 0.75em;
    }
    .tournament-bracket .game .match-score.pending {
        font-weight: 400;
        color: var(--ink-200);
    }
    /* This is a Matchplay bracket, so a win here reads in the Matchplay colour. */
    .tournament-bracket .game .winner,
    .tournament-bracket .game .winner a {
        font-weight: 700;
        color: var(--matchplay);
    }
    .tournament-bracket .game .loser,
    .tournament-bracket .game .loser a {
        font-weight: 400;
        color: var(--text-dim);
    }
    .tournament-bracket .game.ready-to-play .game-top,
    .tournament-bracket .game.ready-to-play .game-top a,
    .tournament-bracket .game.ready-to-play .game-bottom,
    .tournament-bracket .game.ready-to-play .game-bottom a {
        color: var(--violet-200);
    }
    .tournament-bracket .game .game-top .hcp,
    .tournament-bracket .game .game-bottom .hcp {
        font-family: var(--font-num);
        color: var(--text-faint);
        font-size: 0.75em;
        margin-top: 4px;
    }


    .tournament-bracket .game span {
        float:right;
        margin-right:5px;
    }

    .tournament-bracket .undetermined {
        color: var(--text-faint);
        font-size: 0.8em;
    }

    .tournament-bracket .game-spacer {
        border-right: 1px solid var(--line-strong);
        min-height: 40px;
        display: flex;
        align-items: center;
        color: var(--text-faint);
        font-size: 0.75em;
        text-align: right;
    }
  </style>
