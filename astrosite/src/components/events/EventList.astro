---
import EventCard from '../../components/events/EventCard.astro'
import MatchplayEventCard from '../../components/events/MatchplayEventCard.astro'
import PageHeader from '@hector/ui/components/PageHeader.astro'
import { getAllEventsGroupedByChronology, linkToEvent } from '../../code/events'
import { formatEventDates } from '@hector/schemas/src/dates.ts'
import { EventFormat, type Event } from '@hector/schemas/src/events.ts'

interface Props {
	title: string
	eyebrow?: string
	lede?: string
	formats: EventFormat[] | undefined
}

const { title, eyebrow = 'Hector', lede, formats } = Astro.props
const allFormats = Object.values(EventFormat) as EventFormat[]
const includedFormats = formats || allFormats

const { past, ongoing, upcoming } = getAllEventsGroupedByChronology((e) =>
	includedFormats.includes(e.format)
)

const groups = [
	{ key: 'now', heading: 'Happening now', events: ongoing, status: 'Live', live: true },
	{ key: 'upcoming', heading: 'Coming up', events: upcoming, status: 'Upcoming', live: false },
	{ key: 'past', heading: 'Past events', events: past, status: 'Final', live: false },
].filter((group) => group.events.length > 0)

const cardFor = (event: Event, status: string, live: boolean) => ({
	title: event.name,
	location: event.location,
	date: formatEventDates(event),
	href: linkToEvent(event),
	status,
	live,
})
---

<PageHeader title={title} eyebrow={eyebrow} lede={lede} />

{
	groups.map((group) => (
		<section class="section">
			<div class="section-head">
				<h2>{group.heading}</h2>
				{group.live ? (
					<span class="pill pill-live">
						<span class="live-dot" aria-hidden="true" />
						Live
					</span>
				) : (
					<span class="meta">
						{group.events.length} {group.events.length === 1 ? 'event' : 'events'}
					</span>
				)}
			</div>
			<ul role="list" class="grid grid-wide">
				{group.events.map((event) => {
					if (event.format === EventFormat.Matchplay) {
						return <MatchplayEventCard {...cardFor(event, group.status, group.live)} />
					} else if (event.format === EventFormat.Hector) {
						return <EventCard {...cardFor(event, group.status, group.live)} />
					}
					console.warn(
						`<EventList/> not rendering a card for event ${event.name} because it has an unsupported format: ${event.format}`
					)
					return null
				})}
			</ul>
		</section>
	))
}
