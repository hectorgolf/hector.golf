---
import { type HectorEvent } from '../../schemas/events'
import { getCourseById } from '../../code/courses'
import { hasMaximumScorePerHole, maxStrokesOverParFor } from '../../code/scoring'
import type { Course } from '../../schemas/courses'

interface Props {
	event: HectorEvent;
    allThrough: number;
}

let { event, allThrough } = Astro.props;
event = event as HectorEvent;

/*
 * `allThrough` is derived from leaderboard data and is only a real hole count while
 * a round is in progress: it comes back NaN once every entry reads "F", and Infinity
 * when there is no leaderboard at all. Only badge rounds as played/next when we
 * actually know where the field is.
 */
const progressKnown = Number.isInteger(allThrough)

const linkToCourse = (course: Course): string => {
    return `/courses/${course.id}`
}

function isGroupFormat(format: string): boolean {
    const lowercase = format.toLowerCase()
    if (lowercase.includes('stableford')) return false
    if (lowercase.includes('stroke play') && !lowercase.includes('scramble')) return false
    return true
}

function isScrambleFormat(format: string): boolean {
    return format.toLowerCase().includes('scramble')
}

function openingShotsTextLong(requirement: { minimumPerPlayer?: number; penaltyPerMissingStroke?: number } | undefined): string {
    const minimum = requirement?.minimumPerPlayer ?? 0
    const penalty = requirement?.penaltyPerMissingStroke ?? 0
    if (!minimum) return 'No minimum opening shots per player'
    if (!penalty) return `Minimum ${minimum} opening shots per player`
    return `Minimum ${minimum} opening shots per player. ${penalty} penalty strokes awarded for each missing shot.`
}

function openingShotsTextShort(requirement: { minimumPerPlayer?: number; penaltyPerMissingStroke?: number } | undefined): string {
    const minimum = requirement?.minimumPerPlayer ?? 0
    const penalty = requirement?.penaltyPerMissingStroke ?? 0
    if (!minimum) return 'No minimum opening shots'
    if (!penalty) return `${minimum} opening shots per player`
    return `${minimum} opening shots per player. ${penalty} penalty strokes per missing shot.`
}

/**
 * The maximum score per hole, as it reads on a scorecard.
 *
 * A detail of the game format, because whether the rule applies at all depends on
 * it: a round can pair a Stableford format with a Stroke Play one, and only the
 * latter needs a cap. The number comes from the event unless the round overrides it.
 */
function maxScoreTextLong(maxStrokesOverPar: number): string {
    return `Maximum score per hole: par + ${maxStrokesOverPar}`
}

function maxScoreTextShort(maxStrokesOverPar: number): string {
    return `Max par + ${maxStrokesOverPar}`
}

function scoreSource(teamContribution: 'both'|'better'|'team'|undefined): string {
    if (!teamContribution) return 'each'
    switch (teamContribution) {
        case 'both': return `both individuals'`
        case 'better': return 'the better individual\'s'
        case 'team': return 'the team\'s'
        default: return 'each'
    }
}

function pluralize(points: number, unit: string): string {
    return points === 1 ? `${points} ${unit}` : `${points} ${unit}s`
}

---

{
    event.rounds && event.rounds.length > 0 && (
        <section class="section rounds">
            <div class="section-head">
                <h2>Rounds</h2>
                <span class="meta">{event.rounds.length} rounds</span>
            </div>
            <ol role="list" class="round-list">
                {event.rounds.map((round, index) => {
                    const course = getCourseById(round.course)
                    if (!course) return null
                    const tee = course.course?.tees?.find(
                        (t) => t.name.toLowerCase() === round.tee.toLowerCase()
                    )
                    const isCompleted = progressKnown && index < allThrough
                    const isNext = progressKnown && index === allThrough
                    const state = isCompleted ? 'completed' : isNext ? 'next' : 'upcoming'
                    const stateLabel = isCompleted ? 'Final' : isNext ? 'Up next' : 'Upcoming'
                    return (
                        <li class="round card" data-state={state}>
                            <div class="round-head">
                                <span class="round-no num">R{index + 1}</span>
                                <span class="round-title">
                                    Day {round.day}, Round {round.round}
                                </span>
                                {progressKnown && (
                                    <span class={isNext ? 'pill pill-violet' : 'pill'}>{stateLabel}</span>
                                )}
                            </div>
                            <div class="course">
                                <a href={linkToCourse(course)}>{course.name}</a>
                                {tee && (
                                    <>
                                        <span class="dot" style={`background-color: ${tee.color};`} aria-hidden="true" />
                                        <span class="tee-name">{tee.name} tee</span>
                                    </>
                                )}
                            </div>
                            <ul class="game-formats">
                                {round.gameFormats.map((gf) => {
                                    const allowance = gf.handicapAllowance
                                        ? `${Math.round(gf.handicapAllowance * 100)}%`
                                        : ''
                                    const hectorContribution = gf.contribution?.hector
                                    const victorContribution = gf.contribution?.victor
                                    return (
                                        <li class="game-format">
                                            <div class="format-head">
                                                <span class="bullet" aria-hidden="true">
                                                    &bull;
                                                </span>
                                                <span class="format-name">{gf.format}</span>
                                                {allowance && <span class="pill pill-violet num">HCP {allowance}</span>}
                                                {hectorContribution && (
                                                    <span class="pill pill-gold num">
                                                        H {Math.round(hectorContribution * 100)}%
                                                    </span>
                                                )}
                                                {victorContribution && (
                                                    <span class="pill pill-violet num">
                                                        V {Math.round(victorContribution * 100)}%
                                                    </span>
                                                )}
                                            </div>
                                            <ul class="format-notes">
                                                {hectorContribution && (
                                                    <>
                                                        <li class="score-contribution long">
                                                            {isGroupFormat(gf.format)
                                                                ? `Hector points: ${Math.round(hectorContribution * 100)}% of the team's score`
                                                                : `Hector points: ${Math.round(hectorContribution * 100)}% of ${scoreSource(gf.teamContribution)} score`}
                                                        </li>
                                                        <li class="score-contribution short">
                                                            {isGroupFormat(gf.format)
                                                                ? `Hector: ${Math.round(hectorContribution * 100)}% of the team's score`
                                                                : `Hector: ${Math.round(hectorContribution * 100)}% of ${scoreSource(gf.teamContribution)} score`}
                                                        </li>
                                                    </>
                                                )}
                                                {victorContribution && (
                                                    <>
                                                        <li class="score-contribution long">{`Victor points: Contributes ${Math.round(victorContribution * 100)}% to the individual's Victor points`}</li>
                                                        <li class="score-contribution short">{`Victor: ${Math.round(victorContribution * 100)}% of individual's score`}</li>
                                                    </>
                                                )}
                                                {hasMaximumScorePerHole(gf.format) && (
                                                    <>
                                                        <li class="maximum-score long">{maxScoreTextLong(maxStrokesOverParFor(event, round))}</li>
                                                        <li class="maximum-score short">{maxScoreTextShort(maxStrokesOverParFor(event, round))}</li>
                                                    </>
                                                )}
                                                {isScrambleFormat(gf.format) && (
                                                    <>
                                                        <li class="opening-shot-rules long">{openingShotsTextLong(gf.openingShotsRequirement)}</li>
                                                        <li class="opening-shot-rules short">{openingShotsTextShort(gf.openingShotsRequirement)}</li>
                                                    </>
                                                )}
                                                {gf.birdieBonus && (
                                                    <li>{pluralize(gf.birdieBonus, 'point')} for each Birdie</li>
                                                )}
                                                {gf.eagleBonus && (
                                                    <li>{pluralize(gf.eagleBonus, 'point')} for each Eagle</li>
                                                )}
                                            </ul>
                                        </li>
                                    )
                                })}
                            </ul>
                        </li>
                    )
                })}
            </ol>
        </section>
    )
}

<style>
    .round-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .round {
        padding: 0.85rem 1rem 0.95rem;
    }

    /* The round in play gets the inset accent rail the app uses for live rounds. */
    .round[data-state='next'] {
        box-shadow: inset 3px 0 0 var(--violet-500);
        border-color: var(--violet-900);
    }

    .round[data-state='completed'] {
        opacity: 0.72;
    }

    .round-head {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        flex-wrap: wrap;
    }

    .round-no {
        font-size: 12px;
        font-weight: 700;
        color: var(--violet-400);
    }

    .round-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--ink-50);
    }

    .round-head .pill {
        margin-left: auto;
    }

    .course {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.35rem;
        font-size: 13px;
        color: var(--text-muted);
    }

    .course a {
        color: var(--ink-200);
        font-weight: 500;
    }

    .course a:hover {
        color: var(--violet-200);
    }

    .dot {
        width: 8px;
        height: 8px;
        border-radius: 9999px;
        display: inline-block;
        box-shadow: 0 0 0 1px rgb(255 255 255 / 0.25);
        flex-shrink: 0;
    }

    .game-formats {
        list-style: none;
        margin: 0.7rem 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .format-head {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-wrap: wrap;
        font-size: 13px;
    }

    .bullet {
        color: var(--text-faint);
    }

    .format-name {
        color: var(--ink-200);
    }

    .format-notes {
        list-style: none;
        margin: 0.25rem 0 0 0.9rem;
        padding: 0;
        font-size: 12px;
        color: var(--text-faint);
        line-height: 1.5;
    }

    @media only screen and (max-width: 500px) {
        .format-notes .short { display: list-item; }
        .format-notes .long { display: none; }
    }

    @media only screen and (min-width: 501px) {
        .format-notes .short { display: none; }
        .format-notes .long { display: list-item; }
    }
</style>
