---
import { getPlayerName } from '../../code/players'
import { type EnrichedLeaderboard } from '../../code/leaderboards/leaderboards'
import { leaderboardPosition, normalizeDiff, pointsLabel } from '../../code/leaderboards/presentation'
import { type Competition } from '../CompetitionMark.astro'

interface Props {
	entries: EnrichedLeaderboard
	/** Column heading for the competitor column: "Team" or "Player". */
	competitorLabel: string
	ascending: boolean
	/** Which competition this board settles — tints the leader's chip. */
	competition: Competition
	/**
	 * Emit a row template and mark the table up for the live updater.
	 *
	 * Only set for events whose standings can actually be polled. Without it the
	 * table renders exactly as it always has.
	 */
	live?: boolean
}

const { entries, competitorLabel, ascending, competition, live = false } = Astro.props
---

<div class="table-scroll">
	<table
		class="data leaderboard"
		data-competition={competition}
		data-board={live ? competition : undefined}
		data-ascending={live ? String(ascending) : undefined}
	>
		<thead>
			<tr>
				<th class="place">#</th>
				<th>{competitorLabel}</th>
				<th class="numeric">Score</th>
				<th class="numeric">Diff</th>
				<th class="thru">Thru</th>
			</tr>
		</thead>
		<tbody data-rows>
			{
				entries.map(({ players, points, diff, through, description }) => {
					const position = leaderboardPosition(entries, points, ascending)
					// A shared lead ('T1') is still a lead, and gets the gold chip.
					const leading = position === '1' || position === 'T1'
					return (
						<tr>
							<td class="place">
								<span class={leading ? 'chip-num badge is-leader' : 'chip-num badge'}>{position}</span>
							</td>
							<td class="competitor">
								{players.length > 0 ? (
									players.map((player, index) => (
										<>
											{index ? <span class="plus"> + </span> : null}
											<a href={`/players/${player.id}`}>{getPlayerName(player)}</a>
										</>
									))
								) : (
									<span>{description}</span>
								)}
							</td>
							<td class="numeric points">
								<span class="score">{pointsLabel(points)}</span>
							</td>
							<td class="numeric diff">{normalizeDiff(diff)}</td>
							<td class="thru num">{through}</td>
						</tr>
					)
				})
			}
		</tbody>
	</table>
	{
		/*
		 * The live updater clones this rather than building rows from strings, so
		 * that cloned rows carry the same scoped-style attributes as rendered ones
		 * and there is no HTML being assembled from upstream values.
		 */
		live && (
			<Fragment>
				<template data-row-template>
					<tr>
						<td class="place"><span class="chip-num badge" data-cell="place" /></td>
						<td class="competitor" data-cell="competitor" />
						<td class="numeric points"><span class="score" data-cell="points" /></td>
						<td class="numeric diff" data-cell="diff" />
						<td class="thru num" data-cell="thru" />
					</tr>
				</template>
				<template data-competitor-template>
					<a data-proto="link" href="/players/" />
					<span class="plus" data-proto="plus"> + </span>
					<span data-proto="text" />
				</template>
			</Fragment>
		)
	}
</div>

<style>
	table.leaderboard {
		min-width: 420px;
	}

	.place {
		width: 2.75rem;
	}

	/* Shape and type come from .chip-num; only the leader's tint is local. */
	.leaderboard[data-competition='hector'] .badge.is-leader {
		background: var(--hector);
	}

	.leaderboard[data-competition='victor'] .badge.is-leader {
		background: var(--victor);
	}

	.leaderboard[data-competition='matchplay'] .badge.is-leader {
		background: var(--matchplay);
	}

	.badge.is-leader {
		color: var(--ink-950);
	}

	.competitor a {
		color: var(--ink-50);
		font-weight: 600;
	}

	.competitor a:hover {
		color: var(--violet-200);
	}

	.plus {
		color: var(--text-faint);
	}

	.points .score {
		font-size: 1.05rem;
		color: var(--ink-50);
	}

	.diff {
		color: var(--text-dim);
		font-size: 12px;
	}

	.thru {
		text-align: center;
		color: var(--text-dim);
		font-size: 12px;
	}
</style>
