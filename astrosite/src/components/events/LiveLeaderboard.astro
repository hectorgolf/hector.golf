---
/**
 * Keeps a rendered leaderboard current while an event is being played.
 *
 * The statically rendered tables are the leaderboard; this only rewrites their
 * rows in place. With JavaScript off, the proxy down, or the payload in an
 * unexpected shape, the page keeps showing whatever the last build published —
 * which is exactly what it showed before this component existed.
 *
 * Between visits the last standings read are kept in the visitor's own browser
 * (see `code/leaderboards/live-cache.ts`) and painted before the first request
 * goes out, so a page reloaded mid-round opens on a timestamped board rather
 * than on the build's "play has not started" notice. The live read that follows
 * overwrites it either way; a cached board is only ever the first frame.
 *
 * Only mounted for events whose standings come from app.hector.golf, because that
 * is the only source with an endpoint the browser can reach.
 */
import { getAllPlayers, getPlayerAliases, getPlayerName } from '../../code/players'
import { liveCacheKey } from '../../code/leaderboards/live-cache'

interface Props {
	/** The `event` parameter to ask the proxy for, e.g. "HECTOR2026". */
	eventId: string
	/** The leaderboard proxy's URL. Empty disables polling entirely. */
	endpoint: string
	/** How often to re-read the standings, in seconds. */
	pollSeconds?: number
	/** Stop polling once this instant has passed, as an ISO 8601 string. */
	stopAfter: string
	/**
	 * When the standings this page was published with were read, as an ISO 8601
	 * string — the leaderboard file's `updatedAt`.
	 *
	 * Only used to decide whether a visitor's cached board is worth painting
	 * before the first live read answers: standings the build already published
	 * more recently than the cache are the better picture. Undefined for an event
	 * with no published standings at all, which is the usual case during play.
	 */
	renderedAt?: string
}

const { eventId, endpoint, pollSeconds = 30, stopAfter, renderedAt } = Astro.props

/**
 * Everyone who could appear on this board, by every name they go by.
 *
 * Names arrive from upstream as free text, so the lookup has to be by string — but
 * this map is published in the page, so it is built from privacy-respecting names
 * only. A player the site shortens to "Toni M" appears here as "Toni M" and nowhere
 * as their full surname, which the page does not print either. The cost is that a
 * payload naming that player in full will not link to their page; it still shows
 * exactly what upstream sent, as the statically rendered board already does.
 */
const rosterByName: Record<string, { id: string; name: string }> = {}
for (const player of getAllPlayers()) {
	const display = getPlayerName(player)
	for (const alias of [display, ...getPlayerAliases(player)]) {
		if (alias) rosterByName[alias] = { id: player.id, name: display }
	}
}

const config = { eventId, endpoint, pollSeconds, stopAfter, renderedAt, roster: rosterByName }

/** Where this visitor's last standings for this event would be, if they have any. */
const cacheKey = liveCacheKey(eventId)
---

{
	endpoint && (
		<>
			<script is:inline type="application/json" data-live-leaderboard-config set:html={JSON.stringify(config)} />
			{/*
			 * Holds the published empty state back for a browser that has standings
			 * waiting, so the cached board wins the first frame.
			 *
			 * The message is server-rendered, so the browser has it painted long
			 * before the module below has loaded, and a visitor reloading mid-round
			 * saw "play has not started" flash past on every reload. This runs during
			 * parsing — before the first paint, and before the boards can be painted
			 * from anything — which is why it is inline and hand-written rather than
			 * part of the module: by the time an imported module runs, the flash has
			 * already happened.
			 *
			 * It only asks whether an entry exists, and never decides anything: the
			 * module owns whether that entry is any good, and either paints it or
			 * releases the message a few milliseconds later. A board whose entry
			 * turns out to be unusable therefore shows its message a beat late, once,
			 * because reading an expired entry also deletes it.
			 */}
			<script is:inline define:vars={{ cacheKey }}>
				try {
					if (window.localStorage.getItem(cacheKey)) {
						for (const table of document.querySelectorAll('table[data-board]')) {
							table.dataset.cachePending = ''
						}
					}
				} catch {
					// No storage to read means nothing is waiting, which is the default.
				}
			</script>
			<p class="live-status" data-live-status aria-live="polite" />
		</>
	)
}

<script>
	import { readAppLeaderboardPayload, type AppLeaderboardSnapshot } from '@hector/schemas/src/leaderboards/app-payload.ts'
	import {
		browserStorage,
		clearCachedSnapshot,
		readCachedSnapshot,
		writeCachedSnapshot,
	} from '../../code/leaderboards/live-cache'
	import { splitCompetitorNames } from '@hector/schemas/src/leaderboards/names.ts'
	import {
		agoLabel,
		clockLabel,
		decimalsForBoard,
		leaderboardPosition,
		normalizeDiff,
		pointsLabel,
		throughLabel,
	} from '../../code/leaderboards/presentation'

	type RosterEntry = { id: string; name: string }
	type Config = {
		eventId: string
		endpoint: string
		pollSeconds: number
		stopAfter: string
		renderedAt?: string
		roster: Record<string, RosterEntry>
	}
	type Row = { competitor: string; points: number | string; diff: string; through: string }

	/**
	 * How old the standings on screen may be before the page says so.
	 *
	 * Below this the timestamp is enough; past it the reader is looking at numbers
	 * that have stopped arriving — a dead proxy, a sleeping tab, a board painted
	 * from the cache — and the line has to stop reading like a live one.
	 */
	const STALE_AFTER_MS = 5 * 60 * 1000

	/**
	 * The shortest gap between two round trips, whoever asks for one.
	 *
	 * The poll interval is thirty seconds and already respects this, but coming
	 * back to the tab reads immediately, and a tab being switched to and from is
	 * not a reason for the proxy to answer ten times a minute.
	 */
	const MINIMUM_GAP_MS = 10 * 1000

	const configElement = document.querySelector('[data-live-leaderboard-config]')
	const statusElement = document.querySelector<HTMLElement>('[data-live-status]')

	if (configElement?.textContent) {
		const config: Config = JSON.parse(configElement.textContent)
		start(config)
	}

	function start(config: Config) {
		const boards = new Map<string, HTMLTableElement>()
		for (const table of document.querySelectorAll<HTMLTableElement>('table[data-board]')) {
			boards.set(table.dataset.board as string, table)
		}
		if (boards.size === 0) return

		/** Consecutive failures, used to back off rather than hammer a sick endpoint. */
		let failures = 0
		/**
		 * Where the standings on screen came from.
		 *
		 * Decides both what the status line may claim while nothing newer can be
		 * fetched, and whether a board is ours to undo — the build's rows are not.
		 */
		let shown: 'build' | 'cache' | 'live' = 'build'
		let stopped = false
		let timer: number | undefined
		let inFlight = false
		/**
		 * The instant the standings on screen were current at, or undefined while
		 * the board is still the build's. What the status line prints, and what its
		 * staleness is measured from.
		 */
		let shownAt: number | undefined
		/** A note about the polling itself, printed after the timestamp. */
		let note = ''
		/** Re-prints the status line as the standings on it age. */
		let clock: number | undefined
		/** When the last request went out, so the floor below can be enforced. */
		let lastAttempt = 0

		const stopAfter = Date.parse(config.stopAfter)
		const baseDelay = Math.max(10, config.pollSeconds) * 1000
		const storage = browserStorage()

		/**
		 * The empty-state rows as published, cloned before anything is painted.
		 *
		 * Painting a cached board removes them, and an upstream that answers "play
		 * has not started" has to be able to put them back. Only boards published
		 * empty have one stashed.
		 */
		const emptyStates = new Map<string, HTMLElement>()
		for (const [name, table] of boards) {
			const row = table.querySelector<HTMLElement>('[data-empty-state]')
			if (row) emptyStates.set(name, row.cloneNode(true) as HTMLElement)
		}

		/**
		 * Re-prints the status line from the standings on screen and their age.
		 *
		 * One writer for the whole line, because the three things it can say — when
		 * the standings were current, how long ago that now is, and what the poller
		 * is doing — are only true together. A board ages while the page sits there,
		 * so the line has to be able to change its mind without anything new
		 * arriving, which a `setStatus(text)` call at each event cannot do.
		 */
		const showStatus = () => {
			if (!statusElement) return
			if (shownAt === undefined) {
				statusElement.textContent = note
				statusElement.classList.remove('is-stale')
				return
			}
			const age = Date.now() - shownAt
			// Standings that can no longer move are not stale, they are finished, so
			// a stopped poller never marks its own last reading as going off.
			const stale = !stopped && age >= STALE_AFTER_MS
			const parts = [`Updated ${clockLabel(shownAt)}`]
			if (stale) parts.push(agoLabel(age))
			if (note) parts.push(note)
			statusElement.textContent = parts.join(' · ')
			statusElement.classList.toggle('is-stale', stale)
		}

		/**
		 * Starts re-printing the status line, so a board that stops being refreshed
		 * starts saying so without anything having to happen.
		 *
		 * Coarse on purpose: the wording changes at most once a minute, and this
		 * keeps running on a tab nobody is looking at.
		 */
		const startClock = () => {
			if (clock === undefined) clock = window.setInterval(showStatus, 15000)
		}

		/** What to say when the standings on screen cannot currently be refreshed. */
		const unavailable = () => {
			// With a timestamp on the line, "live updates unavailable" is the whole
			// news: the timestamp already says which standings are being shown, and
			// the age beside it says how far behind they are. Without one, the board
			// is the build's and the line has to say so in full.
			if (shownAt !== undefined) return 'live updates unavailable'
			return 'Live updates unavailable — showing the last published standings'
		}

		const hasRows = (snapshot: AppLeaderboardSnapshot) => snapshot.hector.length + snapshot.victor.length > 0

		/** Restores the published empty states, undoing a cached paint. */
		const restoreEmptyStates = () => {
			for (const [name, row] of emptyStates) {
				const table = boards.get(name)
				const body = table?.querySelector<HTMLTableSectionElement>('[data-rows]')
				if (!table || !body) continue
				body.replaceChildren(row.cloneNode(true))
				// Gives back the width floor and the column headings the empty board
				// does without — the pair to what `applyRows` drops when rows arrive.
				table.dataset.empty = ''
			}
		}

		const stop = () => {
			stopped = true
			if (timer) window.clearTimeout(timer)
			timer = undefined
			if (clock !== undefined) window.clearInterval(clock)
			clock = undefined
		}

		const scheduleIn = (delay: number) => {
			if (stopped) return
			if (timer) window.clearTimeout(timer)
			timer = window.setTimeout(tick, delay)
		}

		// Back off up to eight times the base delay, then hold there.
		const schedule = () => scheduleIn(baseDelay * Math.min(8, 2 ** failures))

		const tick = async () => {
			if (stopped || inFlight) return
			if (Number.isFinite(stopAfter) && Date.now() > stopAfter) {
				stop()
				return
			}
			// Nothing to update for a tab nobody is looking at; the visibility
			// listener polls immediately when it comes back.
			if (document.visibilityState !== 'visible') {
				// Only while the board is still the build's: once there are standings on
				// screen, the timestamp they were read at — and, before long, how far
				// behind it is — is worth more than a notice about polling.
				if (shown === 'build') {
					note = 'Updates pause while this tab is in the background'
					showStatus()
				}
				schedule()
				return
			}

			// Coming back to the tab reads immediately, which is the point of it, but
			// not more often than this. Rescheduled rather than dropped, so the reason
			// for asking survives the wait.
			const sinceLast = Date.now() - lastAttempt
			if (sinceLast < MINIMUM_GAP_MS) {
				scheduleIn(MINIMUM_GAP_MS - sinceLast)
				return
			}

			lastAttempt = Date.now()
			inFlight = true
			try {
				const url = `${config.endpoint}?event=${encodeURIComponent(config.eventId)}`
				const response = await fetch(url, { headers: { accept: 'application/json' } })
				if (!response.ok) throw new Error(`proxy returned ${response.status}`)

				const snapshot = readAppLeaderboardPayload(await response.json())
				if (!snapshot) throw new Error('unrecognised payload')

				failures = 0

				if (snapshot.status === 'upcoming') {
					// Before play starts every competitor legitimately reads 0.0, which
					// as a board is the whole field tied for the lead. Leave the page in
					// whatever state the build published and keep watching for 'live'.
					// The boards say why they are empty, so the status line stays quiet
					// rather than repeating it underneath them.
					//
					// A board painted from the cache moments ago is contradicted by this:
					// the tournament itself says there is nothing to show yet, so those
					// rows go, and so does the entry that produced them.
					if (shown === 'cache') {
						restoreEmptyStates()
						clearCachedSnapshot(storage, config.eventId)
						shown = 'build'
					}
					sayInBoards(boards, 'Live standings begin when play starts')
					shownAt = undefined
					note = ''
					showStatus()
				} else {
					render(boards, snapshot, config.roster)
					shown = 'live'
					// Remembered for the next visit, which then opens on standings
					// instead of on the build's guess about why there are none.
					if (hasRows(snapshot)) writeCachedSnapshot(storage, config.eventId, snapshot, Date.now())
					shownAt = instantOf(snapshot.generatedAt)
					note = ''
					showStatus()
					startClock()
				}

				if (snapshot.status === 'final') {
					// Standings cannot move again; one last render is all that is needed.
					stop()
					note = 'final'
					showStatus()
					return
				}
			} catch (error) {
				failures += 1
				console.warn('Live leaderboard update failed', error)
				// The table keeps its last good rows. Say so rather than blanking it.
				if (failures >= 2) {
					note = unavailable()
					showStatus()
				}
			} finally {
				inFlight = false
			}
			schedule()
		}

		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState === 'visible' && !stopped) void tick()
		})

		// The first frame, before the network is involved at all: whatever this
		// browser last saw for this event, if it still beats what the page was
		// published with. The tick below then corrects it within a round trip.
		const cached = readCachedSnapshot(storage, config.eventId, {
			now: Date.now(),
			renderedAt: config.renderedAt,
		})
		if (cached && hasRows(cached)) {
			render(boards, cached, config.roster)
			shown = 'cache'
			// Timestamped, because a board that looks live but is not is worse than no
			// board: the reader can see for themselves how old these standings are, and
			// a cached board old enough to matter says so in as many words.
			shownAt = instantOf(cached.generatedAt)
			note = 'checking for updates…'
			showStatus()
			startClock()
		} else {
			note = 'Checking for updates…'
			showStatus()
		}
		// Whatever this browser had, the island has now had its say, so a board
		// still waiting to hear may show the message it was published with.
		for (const table of boards.values()) delete table.dataset.cachePending
		void tick()
	}

	/**
	 * Replaces the build's guess about why a board is empty with the real reason.
	 *
	 * The build only knows the event's dates; the tournament itself knows whether
	 * play has started. A board that already has standings has no empty row and is
	 * left alone.
	 */
	function sayInBoards(boards: Map<string, HTMLTableElement>, text: string) {
		for (const table of boards.values()) {
			const cell = table.querySelector<HTMLElement>('[data-empty-state] .empty')
			if (cell) cell.textContent = text
		}
	}

	/**
	 * The instant a snapshot was current at.
	 *
	 * `generatedAt` is upstream's own word for it. A payload without one, or with
	 * one that will not parse, was current when we read it — which is this instant,
	 * give or take the round trip that just finished.
	 */
	function instantOf(generatedAt: string | undefined): number {
		const at = generatedAt ? Date.parse(generatedAt) : Number.NaN
		return Number.isFinite(at) ? at : Date.now()
	}

	function render(
		boards: Map<string, HTMLTableElement>,
		snapshot: { hector: unknown[]; victor: unknown[] },
		roster: Record<string, RosterEntry>,
	) {
		const hectorRows: Row[] = (snapshot.hector as Array<Record<string, never>>).map((entry: any) => ({
			competitor: entry.team,
			points: entry.points,
			diff: entry.diff,
			through: entry.through,
		}))
		const victorRows: Row[] = (snapshot.victor as Array<Record<string, never>>).map((entry: any) => ({
			competitor: entry.player,
			points: entry.points,
			diff: entry.diff,
			through: entry.through,
		}))
		applyRows(boards.get('hector'), hectorRows, roster)
		applyRows(boards.get('victor'), victorRows, roster)
	}

	function applyRows(table: HTMLTableElement | undefined, rows: Row[], roster: Record<string, RosterEntry>) {
		if (!table) return
		const body = table.querySelector<HTMLTableSectionElement>('[data-rows]')
		const container = table.closest('.table-scroll')
		const rowTemplate = container?.querySelector<HTMLTemplateElement>('[data-row-template]')
		const competitorTemplate = container?.querySelector<HTMLTemplateElement>('[data-competitor-template]')
		if (!body || !rowTemplate || !competitorTemplate) return

		// An empty payload means "not started yet", not "wipe the board".
		if (rows.length === 0) return

		// The empty-state row spans every column and holds none of the data cells,
		// so it has to go before the children below are reused as standings.
		body.querySelector('[data-empty-state]')?.remove()
		// Restores the width floor and the column headings now that there are rows
		// whose columns need to line up.
		delete table.dataset.empty

		const ascending = table.dataset.ascending !== 'false'
		// Same fact the static table formatted by, read back off the element it
		// wrote it to, so a live update cannot change a column's precision.
		const decimals = decimalsForBoard(ascending)

		rows.forEach((row, index) => {
			let tr = body.children[index] as HTMLElement | undefined
			if (!tr) {
				const cloned = rowTemplate.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined
				if (!cloned) return
				body.appendChild(cloned)
				tr = cloned
			}

			const position = leaderboardPosition(rows, row.points, ascending)
			const place = tr.querySelector<HTMLElement>('[data-cell="place"]')
			if (place) {
				place.textContent = position
				place.classList.toggle('is-leader', position === '1' || position === 'T1')
			}

			const points = tr.querySelector<HTMLElement>('[data-cell="points"]')
			if (points) points.textContent = pointsLabel(row.points, decimals)

			const diff = tr.querySelector<HTMLElement>('[data-cell="diff"]')
			if (diff) diff.textContent = normalizeDiff(row.diff, decimals)

			const thru = tr.querySelector<HTMLElement>('[data-cell="thru"]')
			if (thru) thru.textContent = throughLabel(row.through)

			const competitor = tr.querySelector<HTMLElement>('[data-cell="competitor"]')
			if (competitor) fillCompetitor(competitor, competitorTemplate, row.competitor, roster)
		})

		// A round can be voided, so the board is allowed to get shorter.
		while (body.children.length > rows.length) {
			body.lastElementChild?.remove()
		}
	}

	/**
	 * Writes the competitor cell, linking the names we recognise.
	 *
	 * Every node is cloned from the template rather than built from a string, so
	 * each one carries the scoped-style attribute its rendered counterpart has, and
	 * an upstream name can never be interpreted as markup.
	 */
	function fillCompetitor(
		cell: HTMLElement,
		template: HTMLTemplateElement,
		competitor: string,
		roster: Record<string, RosterEntry>,
	) {
		const linkProto = template.content.querySelector<HTMLAnchorElement>('[data-proto="link"]')
		const plusProto = template.content.querySelector<HTMLElement>('[data-proto="plus"]')
		const textProto = template.content.querySelector<HTMLElement>('[data-proto="text"]')
		if (!linkProto || !plusProto || !textProto) return

		const names = splitCompetitorNames(competitor)
		const matched = names.map((name) => roster[name]).filter((entry): entry is RosterEntry => !!entry)

		cell.replaceChildren()

		// Partial matches would silently drop a name, so link all or none — the same
		// all-or-nothing rule the build applies when it enriches a stored snapshot.
		if (matched.length > 0 && matched.length === names.length) {
			matched.forEach((entry, index) => {
				if (index) cell.appendChild(plusProto.cloneNode(true))
				const link = linkProto.cloneNode(true) as HTMLAnchorElement
				link.setAttribute('href', `/players/${entry.id}`)
				link.textContent = entry.name
				cell.appendChild(link)
			})
			return
		}

		const text = textProto.cloneNode(true) as HTMLElement
		text.textContent = competitor
		cell.appendChild(text)
	}
</script>

<style>
	.live-status {
		margin-top: 0.5rem;
		color: var(--text-faint);
		font-size: 12px;
		min-height: 1.2em;
	}

	/*
	 * Standings that have stopped arriving, in amber — the palette's caution, and
	 * deliberately not the emerald of `.live-dot`: a board nothing is refreshing
	 * has to read as the opposite of live. Faint text is right for a timestamp
	 * nobody needs to act on, and wrong for one saying the numbers above it are
	 * behind, so this state leaves the metadata palette and gets read.
	 */
	.live-status.is-stale {
		color: var(--amber-400);
	}

	/*
	 * The dot `.live-dot` pulses, and this one does not, which is the point: it
	 * marks a board that is standing still.
	 */
	.live-status.is-stale::before {
		content: '';
		display: inline-block;
		width: 6px;
		height: 6px;
		margin-right: 0.4rem;
		border-radius: 9999px;
		background: currentColor;
		vertical-align: 0.1em;
	}
</style>
