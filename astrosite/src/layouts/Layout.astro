---
import '@hector/ui/styles/hector.css'
import HectorMark from '@hector/ui/components/HectorMark.astro'

interface Props {
	title: string
	/** Set on the section landing page so its nav item reads as current. */
	section?: 'events' | 'players' | 'courses' | 'golfreport'
}

const { title, section } = Astro.props
const buildTimestamp = new Date().toISOString()

const nav = [
	{ key: 'events', label: 'Events', href: '/events' },
	{ key: 'players', label: 'Players', href: '/players' },
	{ key: 'courses', label: 'Courses', href: '/courses' },
	{ key: 'golfreport', label: 'Golf Report', href: '/golfreport' },
]

const path = Astro.url.pathname
const currentKey = section ?? nav.find((item) => path.startsWith(item.href))?.key
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Hector Trophée online media" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex,follow" />
		<meta name="published-at" content={buildTimestamp} />
		<meta name="theme-color" content="#0a0a0c" />
		<link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
		<link rel="icon" href="/icons/icon-32.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/icons/icon-180.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Inconsolata:wght@400;600;700&family=Barlow+Semi+Condensed:wght@600;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
		/>
		<!-- Google Tag Manager -->
		<script is:inline>
			;(function (w, d, s, l, i) {
				w[l] = w[l] || []
				w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != 'dataLayer' ? '&l=' + l : ''
				j.async = true
				j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl
				f.parentNode.insertBefore(j, f)
			})(window, document, 'script', 'dataLayer', 'GTM-56L7SB92')
		</script>
		<!-- End Google Tag Manager -->
		<title>{title}</title>
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-56L7SB92"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe></noscript
		>
		<!-- End Google Tag Manager -->

		<header class="site-header">
			<div class="site-header-inner">
				<a class="wordmark" href="/">
					<HectorMark size={20} />
					<span>Hector</span>
				</a>
				<nav aria-label="Sections">
					{
						nav.map((item) => (
							<a href={item.href} aria-current={item.key === currentKey ? 'page' : undefined}>
								{item.label}
							</a>
						))
					}
				</nav>
			</div>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="site-footer-inner">
				<HectorMark size={28} class="footer-mark" />
				<p class="meta">Hector Trophée · Amateur golf, taken far too seriously</p>
				<p class="footer-links">
					<a href="https://app.hector.golf">Live scoring &amp; leaderboards →</a>
				</p>
			</div>
		</footer>

		<style is:global>
			/* ------------------------------------------------------- site header --- */

			.site-header {
				position: sticky;
				top: 0;
				z-index: 40;
				background: rgb(10 10 12 / 0.82);
				backdrop-filter: saturate(150%) blur(12px);
				-webkit-backdrop-filter: saturate(150%) blur(12px);
				border-bottom: 1px solid var(--line);
			}

			.site-header-inner {
				width: 100%;
				max-width: var(--page-max);
				margin-inline: auto;
				padding: 0 1.25rem;
				height: 52px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
			}

			.site-header .wordmark {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				color: var(--gold-400);
				font-size: 12px;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.25em;
				flex-shrink: 0;
			}

			.site-header .wordmark:hover {
				color: var(--gold-300);
			}

			.site-header nav {
				display: flex;
				align-items: center;
				gap: 0.25rem;
				overflow-x: auto;
				scrollbar-width: none;
			}

			.site-header nav::-webkit-scrollbar {
				display: none;
			}

			.site-header nav a {
				border-radius: 9999px;
				padding: 0.3rem 0.7rem;
				font-size: 13px;
				font-weight: 600;
				color: var(--text-muted);
				white-space: nowrap;
				transition:
					color 0.15s var(--ease),
					background-color 0.15s var(--ease);
			}

			.site-header nav a:hover {
				color: var(--ink-100);
				background: var(--surface);
			}

			.site-header nav a[aria-current='page'] {
				color: #fff;
				background: var(--violet-600);
			}

			/* ------------------------------------------------------- site footer --- */

			.site-footer {
				border-top: 1px solid var(--line);
				margin-top: 3rem;
				padding: 2.5rem 0 3rem;
			}

			.site-footer-inner {
				width: 100%;
				max-width: var(--page-max);
				margin-inline: auto;
				padding: 0 1.25rem;
				text-align: center;
			}

			.site-footer .footer-mark {
				color: var(--gold-400);
				opacity: 0.5;
				margin: 0 auto 0.9rem;
			}

			.site-footer p {
				margin: 0;
				max-width: none;
			}

			.site-footer .footer-links {
				margin-top: 0.75rem;
				font-size: 13px;
			}

			@media (max-width: 560px) {
				.site-header-inner {
					height: auto;
					flex-direction: column;
					align-items: stretch;
					gap: 0.35rem;
					padding: 0.55rem 1.25rem 0.6rem;
				}

				.site-header nav {
					justify-content: space-between;
				}

				.site-header nav a {
					padding: 0.3rem 0.5rem;
					font-size: 12px;
				}
			}
		</style>
	</body>
</html>
