{
  "name": "astroversion",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test-astro": "touch .env ; env-cmd vitest run --dir ./test/astro",
    "test-unit": "touch .env ; env-cmd vitest run --dir ./test/unit",
    "test": "npm run test-unit ; npm run test-astro",
    "update-player-club-memberships": "env-cmd npx tsx src/workflows/update-player-club-memberships.ts",
    "update-handicaps": "env-cmd npx tsx src/workflows/update-handicaps.ts",
    "update-leaderboards": "env-cmd npx tsx src/workflows/update-leaderboards.ts",
    "update-player-biographies": "env-cmd npx tsx src/workflows/update-player-biographies.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.4",
    "astro": "^7.2.9",
    "chart.js": "^4.5.1",
    "chartjs-adapter-luxon": "^1.3.1",
    "crypto-js": "^4.2.0",
    "fetch-h2": "^3.0.2",
    "glob": "^13.0.6",
    "googleapis": "^176.0.0",
    "itty-time": "^2.0.2",
    "js-md5": "^0.9.2",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.1",
    "micro-memoize": "^5.1.2",
    "mime": "^4.1.0",
    "octokit": "^5.0.5",
    "p-ratelimit": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "env-cmd": "^11.0.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
