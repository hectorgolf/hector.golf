# Copy this file to .env and replace placeholder values.
# npm test uses env-cmd and requires a .env file to exist.
# Note: test/unit includes integration tests that require working WiseGolf credentials.

# --- Required for WiseGolf integration tests and handicap workflows ---
WISEGOLF_USERNAME=your_wisegolf_username
WISEGOLF_PASSWORD=your_wisegolf_password

# --- Required for update-player-biographies workflow (this is the GCP API key) ---
ASTROSITE_API_KEY=your_backend_function_bearer_token
# Optional: set to true/1 to print extra biography generation debug output.
DEBUG_GENAI_BIOGRAPHY=false

# --- Required for update-leaderboards workflow ---
GITHUB_ACCESS_TOKEN=ghp_your_github_token

# --- Google Sheets access in the leaderboard workflow ---
#
# You almost certainly do NOT need to set this. The scrape authenticates as
# leaderboard-reader@hector-golf.iam.gserviceaccount.com through Application
# Default Credentials, and there is no key to paste:
#
#   gcloud auth application-default login \
#     --impersonate-service-account=leaderboard-reader@hector-golf.iam.gserviceaccount.com
#
# See "update-leaderboards needs a Google identity" in docs/current/architecture.md
# for the other way to do it and for the two 403s that look alike.

# --- Required for reading app.hector.golf standings (update-leaderboards workflow
# --- and the TournamentLeaderboard proxy). The API returns 401 without it.
HECTOR_APP_API_KEY=your_app_hector_golf_api_key

# --- Optional: enables the live leaderboard on app.hector.golf-backed events.
# Public by design (it ends up in page source), so it is a URL, never a key: the
# deployed TournamentLeaderboard function holds HECTOR_APP_API_KEY server-side.
# Leave unset and the leaderboard pages render exactly as they did before, from
# the last published snapshot.
PUBLIC_LEADERBOARD_PROXY_URL=https://europe-north1-<project>.cloudfunctions.net/TournamentLeaderboard
