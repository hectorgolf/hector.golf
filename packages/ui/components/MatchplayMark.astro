---
/**
 * The Matchplay shield, the counterpart to <HectorMark/> for matchplay events.
 *
 * Same artwork as /images/trophy/matchplay-gold.svg, but drawn in `currentColor` so
 * it can sit inside a violet format label rather than being locked to trophy gold.
 * The viewBox is cropped to the shield itself — the source file pads it inside a
 * 3000x4000 canvas, which would render it much smaller than <HectorMark/> alongside.
 */
interface Props {
	size?: number | string
	class?: string
	title?: string
}

const { size = 24, class: className, title } = Astro.props
---

<svg
	viewBox="22 525 2956 2956"
	width={size}
	height={size}
	fill="none"
	class={className}
	role={title ? 'img' : 'presentation'}
	aria-label={title}
	aria-hidden={title ? undefined : 'true'}
>
	<path
		fill="currentColor"
		d="M1931.39 2541.64H2031.88V2656.64H1715.89V2541.64H1816.39V2191.8H1715.89V2076.8H1931.39V2541.64Z"
	></path>
	<path
		fill="currentColor"
		d="M1183.54 1526.26H1284.04V1641.26H968.048V1526.26H1068.54V1176.42H968.048V1061.42H1183.54V1526.26Z"
	></path>
	<path
		fill="currentColor"
		fill-rule="evenodd"
		clip-rule="evenodd"
		d="M2505.43 745V751V757L2505.43 778.502L2505.43 2093.22C2505.43 2936.24 1791.21 3182.81 1524.24 3307.13L1499.88 3318.47L1475.55 3307.06C1213.05 3183.95 494.501 2935.18 494.501 2093.22V775L494.5 747.5L494.501 732V687.5H2505.43V745ZM775.671 2675.53C974.755 2971.3 1305.7 3102.84 1500.04 3191.69C1794.92 3057.69 2390.43 2830.29 2390.43 2093.22V1060.77L775.671 2675.53ZM609.501 2093.22C609.501 2285.14 650.253 2442.6 715.668 2572.89L2390.43 898.133V802.5H609.501V2093.22Z"
	></path>
</svg>
