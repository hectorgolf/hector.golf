---
interface Props {
	title?: string
}

const { title } = Astro.props
---

<div class="highlight">
	{title && <span class="eyebrow">{title}</span>}
	<slot />
</div>

<style>
	/* A violet-tinted panel, matching the app's emphasised blocks. */
	.highlight {
		margin-bottom: 2rem;
		padding: 1.25rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--violet-900);
		background: linear-gradient(rgb(21 16 46 / 0.6), rgb(21 16 46 / 0.15));
	}

	.eyebrow {
		display: block;
		margin-bottom: 0.6rem;
		color: var(--violet-300);
	}
</style>
