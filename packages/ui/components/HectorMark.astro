---
import { HECTOR_MARK_PATH, HECTOR_MARK_BOX, HECTOR_MARK_ORIGIN } from './hector-mark-path.ts'

/**
 * The Hector falcon trophy mark, as used in the scorecard app at app.hector.golf.
 * Inherits `currentColor` so it can be tinted gold, ink or white by its container.
 * The path itself lives beside this file, because the favicons are built from it too.
 */
interface Props {
	size?: number | string
	class?: string
	title?: string
}

const { size = 24, class: className, title } = Astro.props
---

<svg
	viewBox={`0 0 ${HECTOR_MARK_BOX} ${HECTOR_MARK_BOX}`}
	width={size}
	height={size}
	fill="none"
	class={className}
	role={title ? 'img' : 'presentation'}
	aria-label={title}
	aria-hidden={title ? undefined : 'true'}
>
	<g transform={`translate(${HECTOR_MARK_ORIGIN.x}, ${HECTOR_MARK_ORIGIN.y})`}>
		<path
			fill-rule="evenodd"
			fill="currentColor"
			d={HECTOR_MARK_PATH}
		/>
	</g>
</svg>
