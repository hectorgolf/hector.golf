// Markdown linting for the docs in this repository.
//
// The rules below encode what `docs/` and the READMEs already do, rather than importing
// someone else's house style: the point is to catch drift, not to relitigate settled
// formatting. Run it with `npm run lint:md` (`npm run lint:md:fix` fixes what is
// mechanically fixable).
{
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    ".claude/**"
  ],
  "config": {
    // Prose wraps at 100, which is what every file in `docs/` already does. Code blocks
    // and tables are exempt: a directory tree, a `gcloud` invocation or a table of HTTP
    // statuses cannot be rewrapped without making it worse.
    "MD013": {
      "line_length": 100,
      "code_blocks": false,
      "tables": false
    },

    // Asterisks for emphasis, by a margin of roughly 96 to 4 across the repo.
    "MD049": { "style": "asterisk" },
    "MD050": { "style": "asterisk" },

    // `astrosite/src/code/mscorecard/README.md` documents several structures that each
    // have a "Layout" subsection. Repeating a heading under a *different* parent is fine;
    // repeating one under the same parent is still flagged.
    "MD024": { "siblings_only": true },

    // Disabled deliberately: `docs/current/architecture.md` §13 and the playbook use bold
    // run-in labels (`**Security**`, `**When you would run this**`) as sub-dividers inside
    // a section. They are a labelling device, not headings — promoting them would put them
    // in the table of contents, which is not what they are for.
    "MD036": false,

    // Disabled reluctantly, and this one is worth revisiting. `backend/README.md` uses a
    // top-level heading for every section instead of nesting them under its title, which
    // is a real structural flaw — but fixing it means demoting some fifteen headings, so
    // it belongs in its own change rather than in a lint-config commit.
    // `astrosite/README.md` also trips this, by carrying the unmodified Astro starter
    // template below the site's own heading; that is a known gap, recorded in
    // `docs/current/architecture.md` §13, and should be fixed by deleting the boilerplate
    // rather than by renumbering it.
    "MD025": false
  }
}
